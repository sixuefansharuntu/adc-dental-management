# Configuration only. Do not copy the local development .env.
# Replace paths and host; teacher-demo also supports a canonical public IPv4.
PUBLIC_HOST=adc.example.com
SECRETS_DIRECTORY=/opt/adc-private/secrets
TLS_DIRECTORY=/opt/adc-private/certs
BACKUP_DIRECTORY=/opt/adc-private/backups
# Teacher deployment only: a new private output directory, not the existing developer data.
COURSE_DEMO_DIRECTORY=/opt/adc-private/teacher-demo
# Challenge files only, never account files, application source or secrets.
ACME_DIRECTORY=/opt/adc-private/acme-webroot
# Optional patient self-registration, synthetic teacher-demo only; existing enrolled users remain valid when closed.
ADC_COURSE_REGISTRATION_ENABLED=false
ADC_COURSE_LOGIN_PUBLIC=false
ADC_COURSE_LOGIN_INVITE_HASH=
ADC_COURSE_LOGIN_INVITE_UNTIL=

# 小程序对外通道签名密钥。必须与云函数 adcApi 的环境变量 ADC_MP_SOURCE_SECRET 完全一致。
# 生成方式：openssl rand -hex 32
# 留空时该通道整体返回 503（安全失败），不影响网页端与原有小程序本机通道。
ADC_MP_SOURCE_SECRET=
