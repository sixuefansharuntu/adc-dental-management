{
  "name": "adc-certificate-bootstrap",
  "services": {
    "challenge": {
      "image": "nginx:stable-alpine",
      "ports": ["80:80"],
      "volumes": [
        {"type":"bind","source":"./nginx.acme.conf","target":"/etc/nginx/conf.d/default.conf","read_only":true,"bind":{"create_host_path":false}},
        {"type":"bind","source":"${ACME_DIRECTORY:?Set challenge directory}","target":"/var/www/acme","read_only":true,"bind":{"create_host_path":false}}
      ],
      "logging": {"driver":"json-file","options":{"max-size":"5m","max-file":"2"}}
    }
  }
}
