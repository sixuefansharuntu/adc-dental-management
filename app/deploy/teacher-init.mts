import pg from'pg';import{randomBytes,randomUUID}from'node:crypto';import{mkdir,writeFile,readdir,realpath,rm,rename,lstat}from'node:fs/promises';import{resolve,join,sep}from'node:path';import{fileURLToPath}from'node:url';
import{root,withCourseSeedConfig,pgOptions}from'../scripts/config.mjs';import{migrate}from'../scripts/migrate.mjs';import{provisionRuntime}from'./migrate.mjs';import{deployConfig,deploymentReady}from'./runtime.mjs';import{demoManifest,demoDigest,manifestDigest}from'../apps/api/src/course-demo';import{fixtureId as id}from'../scripts/seed.mjs';
import{seedBooking}from'../scripts/seed-booking.mts';import{seedFrontdesk}from'../scripts/seed-frontdesk.mts';import{seedClinical}from'../scripts/seed-clinical.mts';import{seedCare}from'../scripts/seed-care.mts';import{seedFollowup}from'../scripts/seed-followup.mts';import{seedInventory}from'../scripts/seed-inventory.mts';import{seedSales}from'../scripts/seed-sales.mts';import{seedQuarter}from'../scripts/seed-quarter.mts';import{seedQuality}from'../scripts/seed-quality.mts';import{seedBusiness}from'../scripts/seed-business.mts';import{seedClinic}from'../scripts/seed-clinic.mts';import{seedDentist}from'../scripts/seed-dentist.mts';import{seedSecurity}from'../scripts/seed-security.mts';import{seedQualifications}from'../scripts/seed-qualifications.mts';import{seedPatients}from'../scripts/seed-patients.mts';
const logins:Record<string,string>={alice:'ADC_PATIENT_A_PASSWORD',bob:'ADC_PATIENT_B_PASSWORD','front.east':'ADC_STAFF_EAST_PASSWORD','front.river':'ADC_STAFF_RIVER_PASSWORD','staff.none':'ADC_STAFF_NONE_PASSWORD','doctor.lin':'ADC_DOCTOR_LIN_PASSWORD','doctor.zhou':'ADC_DOCTOR_ZHOU_PASSWORD','doctor.river':'ADC_DOCTOR_RIVER_PASSWORD','nurse.east':'ADC_NURSE_EAST_PASSWORD','imaging.east':'ADC_IMAGING_EAST_PASSWORD','followup.assist':'ADC_FOLLOWUP_ASSIST_PASSWORD','stock.east':'ADC_STOCK_EAST_PASSWORD','stock.river':'ADC_STOCK_RIVER_PASSWORD','sales.east':'ADC_SALES_EAST_PASSWORD','finance.hq':'ADC_FINANCE_PASSWORD','review.hq':'ADC_REVIEW_PASSWORD','manager.east':'ADC_MANAGER_EAST_PASSWORD','manager.river':'ADC_MANAGER_RIVER_PASSWORD','quality.east':'ADC_QUALITY_PASSWORD'};
export async function initializeTeacher({env,runtimePassword,outputRoot}:{env:any;runtimePassword:string;outputRoot:string}){
 if(!/^[A-Za-z0-9_-]{32,200}$/.test(runtimePassword)||runtimePassword===env.PGPASSWORD)throw Error('运行口令须独立。');
 const output=resolve(outputRoot);await mkdir(output,{recursive:true,mode:0o700});if((await lstat(output)).isSymbolicLink()||await realpath(output)!==output)throw Error('输出目录必须为实际私有目录。');
 const final=join(output,'environment');if((await readdir(output)).includes('environment'))throw Error('已有课程输出，拒绝覆盖。');
 const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();const stage='adc_course_seed_test_'+Date.now(),stageFolder=resolve(root,'.runtime',stage),datasetId=randomUUID(),pending=join(output,'.pending-'+datasetId);let created=false,renamed=false,published=false,roleCreated=false,c:any;
 try{
  if(!(await admin.query('SELECT pg_try_advisory_lock(307001) AS locked')).rows[0].locked)throw Error('已有课程初始化正在执行。');
  if((await admin.query("SELECT 1 FROM pg_database WHERE NOT datistemplate AND datname<>'postgres' LIMIT 1")).rows.length)throw Error('仅支持全新专用集群，拒绝已有业务数据库。');
  const priorRole=(await admin.query("SELECT 1 FROM pg_roles WHERE rolname='adc_runtime'")).rows.length;await admin.query('CREATE DATABASE "'+stage+'"');created=true;
  const secrets:any={},accounts:any[]=[];const scoped:any={...env,PGDATABASE:stage,ADC_LOCAL_IDENTITY_ENABLED:'false',ADC_MINIPROGRAM_LOCAL_ENABLED:'false',BOOKING_DEMO_DATE:new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'})};
  for(const[login,key]of Object.entries(logins)){secrets[login]=randomBytes(36).toString('base64url');scoped[key]=secrets[login];accounts.push({loginName:login,kind:['alice','bob'].includes(login)?'patient':'staff',password:secrets[login]});}
  await migrate(scoped);let security:any;
  await withCourseSeedConfig(scoped,async()=>{await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();await seedBusiness();await seedClinic();await seedDentist();security=await seedSecurity();await seedQualifications();await seedPatients();});
  accounts.push({loginName:'admin.local',kind:'staff',password:security.credentials.admin});
  c=new pg.Client(pgOptions(scoped));await c.connect();const identities=(await c.query('SELECT identity_id,booking_subject_id,login_name,credential_verifier FROM adc_auth.local_identity ORDER BY login_name')).rows;
  const manifest=demoManifest({schemaVersion:1,purpose:'teacher-demo',database:'adc_course_demo',datasetId,createdAt:new Date().toISOString(),identities:identities.map(x=>({identityId:x.identity_id,subjectId:x.booking_subject_id,loginName:x.login_name,verifierSha256:demoDigest(x.credential_verifier)}))});
  await c.query('BEGIN');try{for(const x of manifest.identities)await c.query('UPDATE adc.patient_booking_subject SET verified_identity_key=$2 WHERE booking_subject_id=$1',[x.subjectId,`course:${datasetId}:${x.identityId}`]);await c.query("INSERT INTO adc.business_operation(operation_id,actor_id,occurred_at,action_code,subject_kind,subject_key,after_content,reason) VALUES($1,$2,clock_timestamp(),'course.demo.initialize','course_environment',$3,$4,'全新专用环境的合成课程资料；不是真实诊所数据')",[datasetId,id('booking-bootstrap'),datasetId,JSON.stringify({syntheticOnly:true,manifestSha256:manifestDigest(manifest),scope:'teacher-demo'})]);await provisionRuntime(c,runtimePassword);await c.query('COMMIT');roleCreated=!priorRole;}catch(e){await c.query('ROLLBACK');throw e;}
  const summary={clinics:(await c.query('SELECT count(*)::int n FROM adc.clinic')).rows[0].n,staff:(await c.query('SELECT count(*)::int n FROM adc.staff_account')).rows[0].n,patients:identities.length,services:(await c.query('SELECT count(*)::int n FROM adc.booking_service_version')).rows[0].n,schedules:(await c.query('SELECT count(*)::int n FROM adc.doctor_schedule')).rows[0].n,prices:(await c.query('SELECT count(*)::int n FROM adc.item_price_version')).rows[0].n};
  await deploymentReady({...pgOptions(scoped),user:'adc_runtime',password:runtimePassword},join(stageFolder,'file-check'));
  await mkdir(pending,{mode:0o700});await writeFile(join(pending,'course-demo.json'),JSON.stringify(manifest,null,2),{mode:0o444,flag:'wx'});await writeFile(join(pending,'accounts.private.json'),JSON.stringify({purpose:'teacher-demo',syntheticOnly:true,bookingFrom:scoped.BOOKING_DEMO_DATE,accounts},null,2),{mode:0o600,flag:'wx'});
  await c.end();c=null;await admin.query('ALTER DATABASE "'+stage+'" RENAME TO adc_course_demo');renamed=true;await rename(pending,final);published=true;return {database:'adc_course_demo',manifestPath:join(final,'course-demo.json'),accountsPath:join(final,'accounts.private.json'),summary};
 }finally{
  if(c)await c.end();try{if(created&&!published){const db=renamed?'adc_course_demo':stage;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1',[db]);await admin.query('DROP DATABASE "'+db+'"');if(roleCreated)await admin.query('DROP ROLE adc_runtime');}if(!published){const entries=await readdir(output);if(entries.includes('.pending-'+datasetId)){if(await realpath(pending)!==pending||!pending.startsWith(output+sep))throw Error('Unsafe private output cleanup');await rm(pending,{recursive:true,force:true});}}
   if(/^adc_course_seed_test_\d+$/.test(stage)&&stageFolder.startsWith(resolve(root,'.runtime')+sep)){const exists=await lstat(stageFolder).catch(()=>null);if(exists){if(exists.isSymbolicLink()||await realpath(stageFolder)!==stageFolder)throw Error('Unsafe seed report cleanup');await rm(stageFolder,{recursive:true,force:true});}}
  }finally{await admin.end();}
 }
}
async function main(){if(process.argv.slice(2).join(' ')!=='--apply'||process.env.ADC_COURSE_DEMO_ENABLED!=='true'||process.env.ADC_DEPLOYMENT_PURPOSE!=='teacher-demo')throw Error('仅明确课程环境可执行初始化。');const opts=await deployConfig(process.env,'migration'),{readFile}=await import('node:fs/promises'),password=(await readFile('/run/secrets/db_runtime_password','utf8')).trim();const result=await initializeTeacher({env:{PGHOST:opts.host,PGPORT:String(opts.port),PGUSER:opts.user,PGPASSWORD:opts.password,PGDATABASE:opts.database},runtimePassword:password,outputRoot:'/output'});console.log(JSON.stringify({database:result.database,summary:result.summary,credentials:'已写私有输出文件，不在日志显示'},null,2));}
if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url))main().catch(()=>{console.error('课程初始化未完成：请核对全新专用集群、私有输出和独立secret。未重置已有业务库。');process.exitCode=1;});
