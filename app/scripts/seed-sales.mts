import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedSales(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const boot=id('booking-bootstrap'),east=id('clinic-east');async function put(table:string,d:any){const k=Object.keys(d);await c.query(`INSERT INTO adc.${table}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(d));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(175001)');const oldRole=id('role171-cashier'),rv=id('rolev175-cashier');await put('role_version',{role_version_id:rv,role_id:oldRole,version_no:2,name:'前台预约诊疗结算及商品销售',configured_by:boot,configured_at:new Date()});await c.query('INSERT INTO adc.role_function SELECT $1,function_code FROM adc.role_function WHERE role_version_id=$2 ON CONFLICT DO NOTHING',[rv,id('rolev171-cashier')]);for(const fn of['sale.read','sale.manage','sale.deliver'])await put('role_function',{role_version_id:rv,function_code:fn});
 for(const[key,clinic]of[['front-east',east],['front-river',id('clinic-river')]]){const g=id('grant175-'+key),old=id('grant171-'+key);await put('access_grant',{grant_id:g,account_id:id('account-'+key),version_no:4,effective_from:'2026-10-25T08:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:clinic});const fields=(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[old])).rows;for(const f of[...fields,{resource_code:'sale',field_code:'lines',action_code:'maintain'},{resource_code:'sale',field_code:'delivery',action_code:'maintain'}])await put('grant_field',{grant_field_id:id(g+f.resource_code+f.field_code),grant_id:g,...f});}
 const role=id('role175-sales'),srv=id('rolev175-sales'),emp=id('employee175-sales'),account=id('account175-sales'),g=id('grant175-sales');await put('security_role',{role_id:role,name:'第二名前台商品结算（合成）',row_version:1});await put('role_version',{role_version_id:srv,role_id:role,version_no:1,name:'商品销售与实收',configured_by:boot,configured_at:new Date()});for(const f of['sale.read','sale.manage','sale.deliver','receipt.create'])await put('role_function',{role_version_id:srv,function_code:f});await put('employee',{employee_id:emp,name:'销售协助前台（合成）',employment_arrangement:JSON.stringify({assignments:[{clinicId:east,role:'frontdesk',from:'2026-01-01',to:null}]}),public_enabled:false,row_version:1});await put('staff_account',{account_id:account,employee_id:emp,login_name:'sales.east',credential_verifier:await credentialHash(env.ADC_SALES_EAST_PASSWORD!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:boot,maintained_at:new Date(),row_version:1});await put('access_grant',{grant_id:g,account_id:account,version_no:1,effective_from:'2026-10-25T08:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:srv});await put('grant_clinic',{grant_id:g,clinic_id:east});for(const[r,f]of[['sale','lines'],['sale','delivery'],['receipt','payment']])await put('grant_field',{grant_field_id:id(g+r+f),grant_id:g,resource_code:r,field_code:f,action_code:'maintain'});await c.query('COMMIT');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'商品销售演示账号.txt'),`ADC本机商品销售，全部合成，不要提交\nhttp://127.0.0.1:5173/\n独立前台 sales.east：${env.ADC_SALES_EAST_PASSWORD}\n原front.east/front.river口令沿用预约演示账号.txt，增加销售交付权限，原预约接诊/治疗收款权限保留。无真实付款/商品交付。\n`,'utf8');console.log('Sales versioned grants ready; synthetic cashier credential private; no sale or stock seeded.');}
if(process.argv[1]?.endsWith('seed-sales.mts'))seedSales().catch(e=>{console.error(e.message);process.exitCode=1;});

