 await check('同患者实际就诊与医生治疗来源明确建立',async()=>{const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:east,name:'合成随访贯通患者272',phone:'13800000272',identityBasis:'合成本人资料核对272'},front);ok(p);patientId=p.json.id;const v=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:east,patientId,doctorId:lin,nurseIds:[nurseId],arrivedAt:new Date(Date.now()-20000).toISOString(),basis:'合成实际到院272',identityBasis:'合成已核实身份',identityConfirmed:true,coordination:'合成已明确内部接诊安排'},front);ok(v);visit=v.json;ok(await call('/clinical/visits/'+visit.id+'/record',{requestId:randomUUID(),recordVersion:0,clinicalAt:visit.arrivedAt,body:'PRIVATE_BODY_272',pendingNote:null,completeness:'complete',doctorConfirmed:true,treatments:[{id:null,version:0,itemId:id('item171-fill'),performedAt:visit.arrivedAt,teeth:['16']}],reason:null},doctor));const d=(await call('/clinical/visits/'+visit.id,undefined,doctor)).json;treatment=d.treatments[0];record=d.record;evidence.visitId=visit.id;});
 const planBody=(extra:any={})=>({requestId:randomUUID(),planId:null,version:0,clinicId:east,itemId:id('item171-fill'),effectiveFrom:new Date(Date.now()-60000).toISOString(),effectiveTo:new Date(Date.now()+86400000).toISOString(),enabled:true,nodes:[{timeArrangement:'合成已核实医生要求，由工作人员明确时刻',contactContent:'课程合成联系内容272',clinicalPurpose:'仅课程软件流程，不设医学间隔'}],doctorRequirementsConfirmed:true,reason:null,...extra});
 await check('管理人员确认医生要求配置方案，护士不能代配置',async()=>{const b=planBody();ok(await call('/followup/plans',b,nurse),403);const r=await call('/followup/plans',b,manager);ok(r);plan=r.json;for(let n=0;n<3;n++)ok(await call('/followup/plans',b,manager));node=(await db.pool.query('SELECT * FROM adc.followup_plan_node WHERE plan_version_id=$1',[plan.planVersionId])).rows[0];});
 const taskBody=(extra:any={})=>({requestId:randomUUID(),taskId:null,version:0,treatmentId:treatment.id,treatmentVersion:treatment.version,planVersionId:plan.planVersionId,nodeId:node.node_id,doctorInstruction:null,instructionDoctorId:null,instructionConfirmed:false,plannedAt:new Date(Date.parse(visit.arrivedAt)+1000).toISOString(),plannedContent:'课程合成核对患者反馈272',responsibleId:nurseId,nextAction:'按实际情况联系',arrangementConfirmed:true,reason:null,...extra});
 await check('护士明确选择治疗及方案节点安排，重复请求只一任务',async()=>{const b=taskBody();ok(await call('/followup/tasks',b,front),403);const r=await call('/followup/tasks',b,nurse);ok(r);task=r.json;for(let n=0;n<3;n++)ok(await call('/followup/tasks',b,nurse));assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.followup_task')).rows[0].n,1);});
 const path=()=>'/followup/tasks/'+task.id,view=async()=>{const r=await call(path(),undefined,nurse);ok(r,200);return r.json.item;},contact=(q:any,extra:any={})=>({requestId:randomUUID(),version:q.version,contactedAt:at(),channel:'phone',reached:false,feedback:'合成未接通，无实际外呼',nextAction:'稍后按实际情况联系',problems:[],...extra});
 await check('未接通只记尝试，不报成功、不自动预约复诊',async()=>{const b=contact(await view());ok(await call(path()+'/contacts',b,nurse));for(let n=0;n<3;n++)ok(await call(path()+'/contacts',b,nurse));const q=await view();assert.equal(q.contactState,'not_reached');assert.equal(q.contacts.length,1);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.appointment')).rows[0].n,0);});
 await check('授权协助前台记录成功及专业问题，不泄露病历正文',async()=>{contactRequest=contact(await view(),{reached:true,feedback:'合成已联系，提出需医生核实的问题272',problems:[{problem:'课程合成专业问题272',doctorId:lin}]});ok(await call(path()+'/contacts',contactRequest,assist));for(let n=0;n<3;n++)ok(await call(path()+'/contacts',contactRequest,assist));const q=await view();assert.equal(q.contactState,'reached');assert.equal(q.professionalState,'pending');assert.equal(q.openIssues,1);const d=await call(path(),undefined,assist);ok(d,200);assert.equal(JSON.stringify(d.json).includes('PRIVATE_BODY_272'),false);ok(await call('/clinical/visits/'+visit.id,undefined,assist),403);ok(await call(path(),undefined,river),403);evidence.issueId=q.issues[0].followup_issue_id;});
 const issueBody=(q:any,extra:any={})=>({requestId:randomUUID(),version:q.version,doctorId:lin,conclusion:'合成已转交医生，等待核实反馈',resolve:false,resolvedAt:null,clinicalRecordId:null,clinicalBasis:null,feedbackVerified:false,...extra});
 await check('普通转交不解决问题，未经核实反馈不能标已解决',async()=>{ok(await call(path()+'/issues/'+evidence.issueId,issueBody(await view()),assist));assert.equal((await view()).openIssues,1);ok(await call(path()+'/issues/'+evidence.issueId,issueBody(await view(),{resolve:true,resolvedAt:at()}),nurse),400);assert.equal((await view()).professionalState,'pending');});
 await check('护士据核实的医生反馈登记解决，记录人与医生分开',async()=>{const b=issueBody(await view(),{resolve:true,resolvedAt:at(),conclusion:'合成已取得并核实医生处理反馈，由护士登记',clinicalRecordId:record.id,clinicalBasis:'仅合成医生反馈核对依据272，不是护士临床判断',feedbackVerified:true});ok(await call(path()+'/issues/'+evidence.issueId,b,nurse));for(let n=0;n<3;n++)ok(await call(path()+'/issues/'+evidence.issueId,b,nurse));const q=await view();assert.equal(q.openIssues,0);assert.equal(q.professionalState,'no_open_issue');assert.equal(q.contactState,'reached');assert.notEqual(q.issues[0].recorded_by,q.issues[0].doctor_id);evidence.solved={contact:q.contactState,professional:q.professionalState,open:q.openIssues};});
 await check('方案改版停用不改旧任务节点，拒绝新用已停方案',async()=>{const old=await view();ok(await call('/followup/plans',planBody({planId:plan.id,version:1,effectiveFrom:new Date(Date.now()+3600000).toISOString(),reason:'合成医生要求新版，仅后续选择',nodes:[{timeArrangement:'合成新版时间安排',contactContent:'合成新版联系内容272',clinicalPurpose:'合成新目的'}]}),manager));ok(await call('/followup/plans/'+plan.id+'/enabled',{requestId:randomUUID(),version:2,enabled:false,reason:'合成停用，仅影响新安排'},manager));const q=await view();assert.equal(q.plan_version_id,old.plan_version_id);assert.equal(q.node_id,old.node_id);assert.equal(q.planned_at,old.planned_at);ok(await call('/followup/tasks',taskBody({plannedContent:'试图新增旧停用方案任务'}),nurse),409);});
 await check('成功联系及问题解决后仍须前台协商预约，不自动产生复诊治疗',async()=>{const cat=(await call('/catalogue')).json,s=cat.items.find((x:any)=>x.clinicId===east&&x.doctorId===lin),a=await call('/availability?'+new URLSearchParams({date:env.BOOKING_DEMO_DATE!,clinicId:east,doctorId:lin,serviceVersionId:s.serviceVersionId}));ok(a,200);const g=a.json.groups.find((x:any)=>x.slots.some((z:any)=>z.status==='available')),slot=g.slots.find((x:any)=>x.status==='available'),b={requestId:randomUUID(),scheduleId:g.scheduleId,serviceVersionId:s.serviceVersionId,ruleVersionId:g.ruleVersionId,startsAt:slot.startsAt,name:'合成随访贯通患者272',contact:'13800000272',intention:'合成已核实随访医生反馈后协商复诊，原随访编号 '+task.id,patientId,bookingSubjectId:null,identityBasis:'已核实合成患者本人及同次随访，明确协商',confirmedWithPatient:true};const r=await call('/frontdesk/appointments',b,front);ok(r);appointment=r.json;for(let n=0;n<3;n++)ok(await call('/frontdesk/appointments',b,front));assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.visit')).rows[0].n,1);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.treatment')).rows[0].n,1);evidence.revisit={id:appointment.id,linkKind:'同患者人工协商，意向保存任务编号，无专用任务预约外键'};});
 await check('数据库核对治疗方案原节点联系问题临床依据及复诊同一患者',async()=>{const rows=(await db.pool.query(`SELECT t.followup_id,tr.treatment_id,tr.visit_id,pv.version_no AS adopted_plan_version,n.node_id,c.followup_contact_id,i.followup_issue_id,i.clinical_record_id,i.recorded_by,i.doctor_id,v.patient_id,a.patient_id AS appointment_patient FROM adc.followup_task t JOIN adc.treatment tr ON tr.treatment_id=t.treatment_id JOIN adc.visit v ON v.visit_id=tr.visit_id JOIN adc.followup_plan_version pv ON pv.plan_version_id=t.plan_version_id JOIN adc.followup_plan_node n ON n.node_id=t.node_id AND n.plan_version_id=pv.plan_version_id JOIN adc.followup_issue i ON i.followup_id=t.followup_id JOIN adc.followup_contact c ON c.followup_contact_id=i.source_contact_id AND c.followup_id=t.followup_id JOIN adc.clinical_record cr ON cr.record_id=i.clinical_record_id AND cr.visit_id=v.visit_id JOIN adc.appointment a ON a.appointment_id=$2 WHERE t.followup_id=$1`,[task.id,appointment.id])).rows;assert.equal(rows.length,1);assert.equal(Number(rows[0].adopted_plan_version),1);assert.equal(rows[0].patient_id,rows[0].appointment_patient);assert.equal(rows[0].clinical_record_id,record.id);evidence.lineage=rows[0];});
 await writeFile(join(root,'artifacts/followup-journey-check.json'),JSON.stringify({batch:272,checks:passed.length,passed,evidence,isolatedDatabase:name,http:{get:reads,post:writes},browserPerformed:false,externalContactSent:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));console.log('Followup journey checks passed:',passed.length);
