 await check('治疗更正留原版，不改变旧账单采用名称、牙位和金额',async()=>{const all=detail.treatments.map((t:any)=>({id:t.id,version:t.version,itemId:t.itemId===fill.id?exam.id:t.itemId,performedAt:t.performedAt,teeth:t.itemId===fill.id?['18']:t.teeth}));const changed=await call(path+'/record',clinicalBody(1,all),doc);assert.equal(changed.status,201);const current=(await call(path,undefined,doc)).json;assert.equal(current.bill.total,'262.50');assert.ok(current.bill.lines.some((l:any)=>l.name===fill.name&&l.teeth.includes('16')));detail=current;});
 let revisedLines:any[];
 await check('待付更正须重新核费并留原因，旧草稿/治疗版本不能直接确认',async()=>{const old=await call(path+'/bill',{...commit,billId:bill.id,billVersion:1,requestId:randomUUID(),reason:'重新核对'},nurse);assert.equal(old.status,409);const src=(await call(path+'/billing-source',undefined,nurse)).json;revisedLines=src.items.map((x:any)=>({treatmentId:x.id,treatmentVersion:x.version,priceVersionId:x.priceVersionId,quantity:x.id===detail.treatments.find((t:any)=>t.itemId===exam.id&&t.teeth.length===0).id?'1.2500':'1.0000',unitPrice:x.referencePrice}));const body=bbody(revisedLines,bill);const d=await call(path+'/draft',body,nurse);assert.equal(d.status,201);assert.equal((await call(path+'/bill',{...body,requestId:randomUUID(),draftToken:d.json.draftToken},nurse)).status,400);const updated=await call(path+'/bill',{...body,requestId:randomUUID(),draftToken:d.json.draftToken,reason:'医生更正项目后重新核费'},nurse);assert.equal(updated.status,201);bill=(await call(path,undefined,nurse)).json.bill;assert.equal(bill.version,2);assert.equal(bill.total,'112.50');assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.bill_revision WHERE bill_id=$1',[bill.id])).rows[0].n,2);});
 await check('调价权限和不可变价格值；旧账单采用价不回算',async()=>{const price={requestId:randomUUID(),clinicId:clinic,itemId:exam.id,amount:'75.0000',effectiveFrom:new Date(Date.now()+60000).toISOString(),reason:'合成新参考价版本'};assert.equal((await call('/clinical/prices',price,nurse)).status,403);const r=await call('/clinical/prices',price,front);assert.equal(r.status,201);assert.equal((await call(path,undefined,nurse)).json.bill.total,'112.50');await assert.rejects(()=>db.pool.query('UPDATE adc.item_price_version SET amount=99 WHERE price_version_id=$1',[exam.priceVersionId]),/immutable/);});
 const receipt=(amount='112.50')=>({requestId:randomUUID(),billVersion:2,amount,paymentMethod:'cash',receivedAt:new Date(Date.now()-1000).toISOString(),actualReceived:true,basis:'合成场景，前台已核实全额真实收到'});
 await check('未实际付款、非全额、未来到账与非前台均拒绝，不造部分收款',async()=>{assert.equal((await call(path+'/receipt',{...receipt(),actualReceived:false},front)).status,400);assert.equal((await call(path+'/receipt',receipt('100.00'),front)).status,409);assert.equal((await call(path+'/receipt',{...receipt(),receivedAt:new Date(Date.now()+60000).toISOString()},front)).status,409);assert.equal((await call(path+'/receipt',receipt(),nurse)).status,403);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.receipt')).rows[0].n,0);});
 await check('收款全写后故障共同回滚，付款仍待付',async()=>{const actor=await auth.staff({headers:{cookie:front}} as any),input=receipt();await assert.rejects(()=>s.collect(actor,visit.id,input,async()=>{throw Error('intentional collection fault');}),/intentional/);assert.equal((await call(path,undefined,front)).json.bill.paymentState,'unpaid');assert.equal((await db.pool.query('SELECT 1 FROM adc.command_dedup WHERE request_key=$1',[input.requestId])).rowCount,0);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.receipt_revision')).rows[0].n,0);});
 let receiptInput:any;
 await check('并发全额收款仅一笔，重复返回原记录；实际和登记时刻分开',async()=>{receiptInput=receipt();const r=await Promise.all([call(path+'/receipt',receiptInput,front),call(path+'/receipt',receipt(),front)]);assert.ok(r.every(x=>x.status===201));assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.receipt')).rows[0].n,1);const view=(await call(path,undefined,front)).json;assert.equal(view.bill.paymentState,'paid');assert.equal(view.bill.receipt.amount,'112.50');assert.ok(Date.parse(view.bill.receipt.receivedAt)<Date.parse(view.bill.receipt.registeredAt));const retry=await call(path+'/receipt',receiptInput,front);assert.equal(retry.status,201);const hist=(await db.pool.query('SELECT * FROM adc.receipt_revision')).rows[0];assert.ok(hist.bill_revision_id);assert.equal(hist.sale_revision_id,null);});
