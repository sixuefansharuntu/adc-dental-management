 await check('临床保存后故障回滚作者、治疗和原版；无权限不能借请求键供阅',async()=>{const actor=await auth.staff({headers:{cookie:doc}} as any);const all=detail.treatments.map((t:any)=>({id:t.id,version:t.version,itemId:t.itemId,performedAt:t.performedAt,teeth:t.teeth}));const input={...clinicalBody(2,all)};const before=(await db.pool.query('SELECT count(*)::int n FROM adc.clinical_record_revision')).rows[0].n;await assert.rejects(()=>s.saveClinical(actor,visit.id,input,async()=>{throw Error('intentional clinical fault');}),/intentional/);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.clinical_record_revision')).rows[0].n,before);assert.equal((await call(path+'/bill',commit,front)).status,403);});
 await check('已确认季度补录拒绝直接加入，原确认结果保持',async()=>{const q=randomUUID(),policy=randomUUID(),op=randomUUID(),result=randomUUID();const received=new Date(Date.now()-1000),d=new Date(+received+8*3600000),month=Math.floor(d.getUTCMonth()/3)*3,start=new Date(Date.UTC(d.getUTCFullYear(),month,1)-8*3600000),end=new Date(Date.UTC(d.getUTCFullYear(),month+3,1)-8*3600000);const bootstrap=id('booking-bootstrap');await db.pool.query("INSERT INTO adc.calculation_policy_version VALUES($1,1,'Asia/Shanghai','actual_receipts','known_costs','recorded_expenses')",[policy]);await db.pool.query("INSERT INTO adc.quarter_run(quarter_id,quarter_label,business_timezone,quarter_start_at,quarter_end_at,row_version) VALUES($1,'test quarter','Asia/Shanghai',$2,$3,1)",[q,start,end]);await db.pool.query("INSERT INTO adc.business_operation(operation_id,actor_id,occurred_at,action_code,subject_kind,subject_key) VALUES($1,$2,clock_timestamp(),'seed.confirmed.quarter','quarter',$3)",[op,bootstrap,q]);await db.pool.query("INSERT INTO adc.quarter_result_version(result_id,quarter_id,policy_version_id,version_no,confirmed_by,confirmed_at,review_state,calculated_by,calculated_at,operation_id) VALUES($1,$2,$3,1,$4,clock_timestamp(),'confirmed',$4,clock_timestamp(),$5)",[result,q,policy,bootstrap,op]);await db.pool.query('UPDATE adc.quarter_run SET first_full_confirmed_at=clock_timestamp(),first_confirmed_result_id=$2 WHERE quarter_id=$1',[q,result]);const v2=await newVisit();const rec={...clinicalBody(),clinicalAt:v2.arrivedAt,treatments:[{id:null,version:0,itemId:fill.id,performedAt:v2.arrivedAt,teeth:[]}]};assert.equal((await call('/clinical/visits/'+v2.id+'/record',rec,doc)).status,201);const src=(await call('/clinical/visits/'+v2.id+'/billing-source',undefined,nurse)).json;const row=src.items[0],bb={lines:[{treatmentId:row.id,treatmentVersion:row.version,priceVersionId:row.priceVersionId,quantity:'1',unitPrice:row.referencePrice}]};const dr=(await call('/clinical/visits/'+v2.id+'/draft',bb,nurse)).json;const created=await call('/clinical/visits/'+v2.id+'/bill',{...bb,requestId:randomUUID(),draftToken:dr.draftToken},nurse);assert.equal(created.status,201);assert.equal((await call('/clinical/visits/'+v2.id+'/receipt',{...receipt('200.00'),billVersion:1},front)).status,409);assert.equal((await db.pool.query('SELECT first_confirmed_result_id FROM adc.quarter_run WHERE quarter_id=$1',[q])).rows[0].first_confirmed_result_id,result);});
 await check('当前字段权限撤回即生效，完整166源文件19项保持',async()=>{await db.pool.query("DELETE FROM adc.grant_field WHERE grant_id=$1 AND resource_code='clinical' AND field_code='body'",[id('grant171-lin')]);assert.equal((await call(path+'/record',clinicalBody(2,detail.treatments.map((t:any)=>({id:t.id,version:t.version,itemId:t.itemId,performedAt:t.performedAt,teeth:t.teeth}))),doc)).status,403);const dir=join(root,'../output/pdf/ADC-完整设计基线166'),m=JSON.parse(await readFile(join(dir,'基线文件清单.json'),'utf8'));for(const[p,h]of Object.entries(m.files))assert.equal(createHash('sha256').update(await readFile(join(dir,p))).digest('hex'),h,p);});
