 await check('医生护士前台独立，非参与医生及跨诊所拒绝正文，前台不返回病历',async()=>{assert.equal((await call(path,undefined,wrong)).status,403);assert.equal((await call(path,undefined,river)).status,403);const f=await call(path,undefined,front);assert.equal(f.status,200);assert.equal(f.json.canClinical,false);assert.equal(f.json.record,null);assert.deepEqual(f.json.treatments,[]);assert.equal((await call(path+'/record',clinicalBody(),front)).status,403);assert.equal((await call(path+'/record',clinicalBody(),nurse)).status,403);});
