 await migrate();await seedBooking();await seedFrontdesk();await seedClinical();const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts'),{ClinicalService}=await import('../apps/api/src/clinical.service.ts'),{AuthService,credentialHash}=await import('../apps/api/src/auth.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),s=app.get(ClinicalService),auth=app.get(AuthService);
 async function call(path:string,body?:any,cookie=''){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:env.ADMIN_ORIGIN}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
