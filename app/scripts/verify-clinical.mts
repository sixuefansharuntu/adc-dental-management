 async function newVisit(){const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:clinic,name:'诊疗收费合成患者',phone:'13800000171',identityBasis:'本机合成身份核实'},front);assert.equal(p.status,201);const at=new Date(Date.now()-3000).toISOString();const v=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:clinic,patientId:p.json.id,doctorId:doctor,nurseIds:[id('nurse-east-a')],arrivedAt:at,basis:'合成现场到院',identityBasis:'已当面核对档案',identityConfirmed:true,coordination:'已核实当前内部接诊安排'},front);assert.equal(v.status,201);return v.json;}
