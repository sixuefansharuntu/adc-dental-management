import assert from'node:assert/strict';import pg from'pg';import{randomBytes,randomUUID}from'node:crypto';import{readFile,writeFile,mkdir,rm,readdir}from'node:fs/promises';import{join,resolve,sep}from'node:path';import{spawn}from'node:child_process';import{createServer,createConnection}from'node:net';
import{config,root,pgOptions}from'./config.mjs';import{bundledPostgres,postgresCommand,startExistingCluster,stopExistingCluster}from'./postgres-process.mjs';import{databaseSnapshot,digest}from'./snapshot-startup186.mjs';import{startDatabase}from'./database.mjs';
const env=await config(),original=await databaseSnapshot(env),name='adc_cluster_test_'+Date.now()+'_'+randomUUID().slice(0,8),dir=resolve(root,'.runtime',name),pwfile=dir+'.pw',password=randomBytes(24).toString('base64url'),tools=await bundledPostgres(),passed:string[]=[];let initialized=false,removed=false;
if(!dir.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe test path');
const check=async(n:string,f:()=>Promise<void>)=>{await f();passed.push(n);console.log('PASS',n);};
async function port(){const s=createServer();await new Promise<void>(r=>s.listen(0,'127.0.0.1',r));const value=(s.address()as any).port;await new Promise<void>(r=>s.close(()=>r()));return value;}
const selectedPort=await port();if(selectedPort===Number(env.PGPORT))throw Error('Test port must be separate');
async function child(action:string,path=dir,p=selectedPort){return await new Promise<{code:number|null,text:string}>((yes,no)=>{const c=spawn(process.execPath,['scripts/cluster-command205.mjs',action,path,String(p)],{cwd:root,env:{...process.env,PGPASSWORD:'unrelated-test-only',PGDATA:'unrelated-path',ADC_TEST_SECRET:'not-to-pass'},windowsHide:true,stdio:['ignore','pipe','pipe']});let text='';c.stdout.on('data',x=>text+=x);c.stderr.on('data',x=>text+=x);c.on('error',no);c.on('exit',code=>yes({code,text}));});}
const connection=()=>new pg.Client({host:'127.0.0.1',port:selectedPort,user:'adc_cold_test',password,database:'postgres',connectionTimeoutMillis:3000});
async function rows(){const c=connection();await c.connect();try{await c.query("SET TIME ZONE 'UTC'");return(await c.query('SELECT id,note,exact::text,encode(raw,\'hex\') bytes,at::text,optional,parent_id FROM fixture ORDER BY id')).rows;}finally{await c.end();}}
async function listening(p:number){return new Promise<boolean>(yes=>{const s=createConnection({host:'127.0.0.1',port:p});s.setTimeout(1000);s.once('connect',()=>{s.destroy();yes(true);});s.once('error',()=>{s.destroy();yes(false);});s.once('timeout',()=>{s.destroy();yes(false);});});}
try{
 await mkdir(dir);await writeFile(pwfile,password+'\n',{mode:0o600,flag:'wx'});
 await check('独立随机端口与具名私有集群初始化，不碰原开发数据目录',async()=>{const r=await postgresCommand(tools.initdb,['-D',dir,'--encoding=UTF8','--locale=C','--lc-messages=C','--username=adc_cold_test','--auth=scram-sha-256','--pwfile='+pwfile]);assert.equal(r.code,0,r.stderr);initialized=true;await rm(pwfile);assert.equal((await readFile(join(dir,'PG_VERSION'),'utf8')).trim(),'17');});
 await check('启动辅助子进程10秒内返回，退出后数据库仍存活并可用原临时凭据连接',async()=>{const began=Date.now(),r=await child('start');assert.equal(r.code,0,r.text);assert.ok(Date.now()-began<10000,'启动成功后不应等待管道超时');assert.equal(JSON.parse(r.text.trim()).started,true);const c=connection();await c.connect();try{assert.equal((await c.query('SELECT current_user u')).rows[0].u,'adc_cold_test');assert.equal((await c.query('SHOW listen_addresses')).rows[0].listen_addresses,'127.0.0.1');}finally{await c.end();}});
 await check('真实写入中文emoji字节高精度微秒NULL与自关联测试资料',async()=>{const c=connection();await c.connect();try{await c.query('CREATE TABLE fixture(id integer PRIMARY KEY,note text,exact numeric(30,12),raw bytea,at timestamptz,optional text,parent_id integer REFERENCES fixture(id))');await c.query("INSERT INTO fixture VALUES(1,$1,'123456789012345678.123456789012',$2,'2030-10-28T01:02:03.123456+08:00',NULL,NULL),(2,'child',1,NULL,'2030-10-28T01:02:03.999999+08:00','kept',1)",['中文🦷与换行\n引号"',Buffer.from([0,1,127,255])]);}finally{await c.end();}});
 const expected=await rows(),pid=await readFile(join(dir,'postmaster.pid'),'utf8');
 await check('重复启动复用原进程，不重启不改已有数据',async()=>{for(let i=0;i<2;i++){const r=await child('start');assert.equal(r.code,0,r.text);assert.equal(JSON.parse(r.text.trim()).started,false);}assert.equal(await readFile(join(dir,'postmaster.pid'),'utf8'),pid);assert.deepEqual(await rows(),expected);});
 await check('明确正常停止后端口关闭，不删除数据目录',async()=>{const r=await child('stop');assert.equal(r.code,0,r.text);assert.equal(JSON.parse(r.text.trim()).stopped,true);assert.equal(await listening(selectedPort),false);assert.equal((await readFile(join(dir,'PG_VERSION'),'utf8')).trim(),'17');});
 await check('真实冷启动保存全部字段与关联，再次脚本退出后保持在线',async()=>{const r=await child('start');assert.equal(r.code,0,r.text);assert.equal(JSON.parse(r.text.trim()).started,true);assert.deepEqual(await rows(),expected);assert.equal(expected[0].exact,'123456789012345678.123456789012');assert.equal(expected[0].bytes,'00017fff');assert.match(expected[0].at,/123456/);assert.equal(expected[0].optional,null);assert.equal(expected[1].parent_id,1);});
 await check('已停止时重复停止明确返回未停止，不强杀其他服务',async()=>{assert.equal((await stopExistingCluster(dir)).stopped,true);assert.equal((await stopExistingCluster(dir)).stopped,false);});
 await check('主版本不匹配拒绝启动，不升级或覆盖原标记',async()=>{await writeFile(join(dir,'PG_VERSION'),'18\n');try{await assert.rejects(()=>startExistingCluster(dir,selectedPort),/主版本/);assert.equal(await readFile(join(dir,'PG_VERSION'),'utf8'),'18\n');assert.equal(await listening(selectedPort),false);}finally{await writeFile(join(dir,'PG_VERSION'),'17\n');}});
 await check('端口被另一测试服务占用时给出启动失败日志且不停止它',async()=>{const server=createServer();await new Promise<void>(r=>server.listen(selectedPort,'127.0.0.1',r));try{const r=await child('start');assert.equal(r.code,1);assert.match(r.text,/server.log/);assert.equal(server.listening,true);assert.doesNotMatch(r.text,/TypeError|unrelated-test-only|not-to-pass/);}finally{await new Promise<void>(r=>server.close(()=>r()));}assert.ok((await readFile(join(dir,'server.log'),'utf8')).length>0);});
 await check('冲突解除后仍能正常启动，数据未重置',async()=>{assert.equal((await startExistingCluster(dir,selectedPort)).started,true);assert.deepEqual(await rows(),expected);});
 await check('当前原开发进程凭据不通时明确拒绝，不改密码或重启原进程',async()=>{await assert.rejects(()=>startDatabase({env:{...env,PGPASSWORD:randomBytes(20).toString('hex')}}),/原配置/);assert.deepEqual(await databaseSnapshot(env),original);});
 await check('测试命令拒绝原开发目录，不允许借隔离入口停止它',async()=>{const r=await child('stop',join(root,'.runtime','postgres'),Number(env.PGPORT));assert.equal(r.code,1);assert.match(r.text,/仅供/);assert.deepEqual(await databaseSnapshot(env),original);});
 await check('没有意外外部监听，原开发库全表摘要保持',async()=>{const c=connection();await c.connect();try{assert.equal((await c.query('SHOW port')).rows[0].port,String(selectedPort));assert.equal((await c.query('SHOW listen_addresses')).rows[0].listen_addresses,'127.0.0.1');}finally{await c.end();}assert.deepEqual(await databaseSnapshot(env),original);});
}finally{
 if(initialized)await stopExistingCluster(dir);const target=resolve(dir);if(!target.startsWith(resolve(root,'.runtime')+sep)||!/^adc_cluster_test_\d+_[a-f0-9]{8}$/.test(name))throw Error('Unsafe owned cleanup');if(await listening(selectedPort))throw Error('Temporary cluster still listening; preserve directory');await rm(target,{recursive:true,force:true});await rm(pwfile,{force:true});removed=true;
}
assert.ok(removed);assert.ok(!(await readdir(join(root,'.runtime'))).includes(name));await writeFile(join(root,'artifacts/cold-start-check.json'),JSON.stringify({batch:205,checks:passed.length,passed,isolatedCluster:name,isolatedPort:selectedPort,temporaryClusterStoppedAndRemoved:true,originalDevelopmentClusterNotStopped:true,developmentTablesUnchanged:true,checkedAt:new Date().toISOString()},null,2));console.log('Cold start verified:',passed.length);
