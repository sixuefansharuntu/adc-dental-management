import pg from'pg';import{randomUUID}from'node:crypto';import{config,pgOptions}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';
// Only the four explicitly approved synthetic accounts; no credentials or write functions added.
export async function seedBusiness(applyDevelopment=false,only?:readonly string[]){const env=await config();if(env.PGDATABASE==='adc_dev'&&!applyDevelopment)throw Error('开发库经营只读授权须显式采用用户已批准范围。');if(env.PGDATABASE!=='adc_dev'&&!/^adc_[a-z_]+_test_\d+$/.test(env.PGDATABASE!))throw Error('只配置具名开发库或本次隔离测试库。');const c=new pg.Client(pgOptions(env));await c.connect();
 const east=id('clinic-east'),river=id('clinic-river'),boot=id('booking-bootstrap');async function put(t:string,d:any){const ks=Object.keys(d);await c.query(`INSERT INTO adc.${t}(${ks.join(',')}) VALUES(${ks.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(d));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(183001)');for(const[key,login,scopes,functions]of[
  ['front-east','front.east',[east],['business.daily.read']],['front-river','front.river',[river],['business.daily.read']],
  ['finance','finance.hq',[east,river],['business.daily.read','business.staff.read','business.income.read','business.export']],['review','review.hq',[east,river],['business.daily.read','business.staff.read','business.income.read','business.export']]
 ]as [string,string,string[],string[]][]){if(only&&!only.includes(login))continue;
  const account=(await c.query("SELECT account_id FROM adc.staff_account WHERE login_name=$1 AND activation_arrangement='enabled'",[login])).rows[0];if(!account)throw Error('缺少原合成账号：'+login);const gid=id('grant183-'+key);if((await c.query('SELECT 1 FROM adc.access_grant WHERE grant_id=$1',[gid])).rowCount)continue;
  const old=(await c.query('SELECT * FROM adc.access_grant WHERE account_id=$1 AND effective_from<=clock_timestamp() AND (effective_to IS NULL OR effective_to>clock_timestamp()) ORDER BY effective_from DESC,version_no DESC LIMIT 1',[account.account_id])).rows[0];if(!old)throw Error('原有效授权缺失');const oldScopes=(await c.query('SELECT clinic_id FROM adc.grant_clinic WHERE grant_id=$1 ORDER BY clinic_id',[old.grant_id])).rows.map(r=>r.clinic_id);if(JSON.stringify(oldScopes)!==JSON.stringify([...scopes].sort()))throw Error('原授权范围与已批准经营范围不同，不能自动扩大');
  const role=id('role183-business-'+key),rv=id('rolev183-business-'+key),now=new Date();await put('security_role',{role_id:role,name:login+' 经营只读维度',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:login+' 经营只读维度',configured_by:boot,configured_at:now});for(const fn of functions)await put('role_function',{role_version_id:rv,function_code:fn});
  await put('access_grant',{grant_id:gid,account_id:account.account_id,version_no:Number(old.version_no)+1,effective_from:now,configured_by:boot,configured_at:now});await c.query('INSERT INTO adc.grant_role SELECT $1,role_version_id FROM adc.grant_role WHERE grant_id=$2',[gid,old.grant_id]);await put('grant_role',{grant_id:gid,role_version_id:rv});for(const clinic of scopes)await put('grant_clinic',{grant_id:gid,clinic_id:clinic});const fs=(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[old.grant_id])).rows;for(const f of fs)await put('grant_field',{grant_field_id:id(gid+f.resource_code+f.field_code+f.action_code),grant_id:gid,...f});
  const op=randomUUID();await put('business_operation',{operation_id:op,actor_id:boot,occurred_at:now,action_code:'access.configure.synthetic',subject_kind:'access_grant',subject_key:gid,reason:'用户2026-10-26明确批准本机经营只读维度；保原业务功能和字段，不增写权',after_content:JSON.stringify({account:login,priorGrant:old.grant_id,addedReadFunctions:functions,clinicIds:scopes})});for(const clinic of scopes)await put('operation_clinic',{operation_id:op,clinic_id:clinic});
 }await c.query('COMMIT');console.log('Approved business read scopes configured for four existing synthetic accounts; no credentials or business writes added.');}catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}}
if(process.argv[1]?.endsWith('seed-business.mts'))seedBusiness(process.argv.includes('--apply-approved-development')).catch(e=>{console.error(e.message);process.exitCode=1;});
