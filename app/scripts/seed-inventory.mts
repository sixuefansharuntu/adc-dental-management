import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedInventory(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const bootstrap=id('booking-bootstrap'),east=id('clinic-east');async function put(table:string,data:Record<string,unknown>){const k=Object.keys(data);await c.query(`INSERT INTO adc.${table}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(data));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(174001)');const role=id('role174-stock'),rv=id('rolev174-stock');await put('security_role',{role_id:role,name:'库管收发盘点（本机）',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'库管收发盘点',configured_by:bootstrap,configured_at:new Date()});for(const fn of['stock.read','stock.receive','stock.issue','stock.count','material.manage','supplier.manage'])await put('role_function',{role_version_id:rv,function_code:fn});
 for(const[key,clinic,name,password]of[['east',east,'东城库管（合成）',env.ADC_STOCK_EAST_PASSWORD],['river',id('clinic-river'),'滨江库管（合成）',env.ADC_STOCK_RIVER_PASSWORD]]){const emp=id('employee174-stock-'+key),account=id('account174-stock-'+key),g=id('grant174-stock-'+key);await put('employee',{employee_id:emp,name,employment_arrangement:JSON.stringify({assignments:[{clinicId:clinic,role:'warehouse',from:'2026-01-01',to:null}]}),public_enabled:false,row_version:1});await put('staff_account',{account_id:account,employee_id:emp,login_name:'stock.'+key,credential_verifier:await credentialHash(password!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:bootstrap,maintained_at:new Date(),row_version:1});await put('access_grant',{grant_id:g,account_id:account,version_no:1,effective_from:'2026-10-25T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:clinic});for(const[r,f]of[['inventory','receipt'],['inventory','issue'],['inventory','count'],['material','catalogue'],['supplier','data']])await put('grant_field',{grant_field_id:id(g+r+f),grant_id:g,resource_code:r,field_code:f,action_code:'maintain'});}
 const mrv=id('rolev174-manager'),g=id('grant174-manager');await put('role_version',{role_version_id:mrv,role_id:id('role173-manager'),version_no:2,name:'随访方案与库存查询/供应商资料',configured_by:bootstrap,configured_at:new Date()});for(const fn of['followup.plan.read','followup.plan.manage','stock.read','supplier.manage'])await put('role_function',{role_version_id:mrv,function_code:fn});await put('access_grant',{grant_id:g,account_id:id('account173-manager'),version_no:2,effective_from:'2026-10-25T06:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:mrv});await put('grant_clinic',{grant_id:g,clinic_id:east});for(const[r,f]of[['followup_plan','config'],['supplier','data']])await put('grant_field',{grant_field_id:id(g+r+f),grant_id:g,resource_code:r,field_code:f,action_code:'maintain'});await c.query('COMMIT');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'库存演示账号.txt'),`ADC本机库存（全部合成，不要提交）\n入口：http://127.0.0.1:5173/\n东城库管 stock.east：${env.ADC_STOCK_EAST_PASSWORD}\n滨江库管 stock.river：${env.ADC_STOCK_RIVER_PASSWORD}\n\nmanager.east口令沿用随访演示账号.txt，增加本店库存查询和供应商基本维护，不授收发盘点。没有预填真实库存或采购业务。\n`,'utf8');console.log('Inventory synthetic roles ready; credentials private, no inventory quantities seeded.');
}if(process.argv[1]?.endsWith('seed-inventory.mts'))seedInventory().catch(e=>{console.error(e.message);process.exitCode=1;});

