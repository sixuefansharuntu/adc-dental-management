import pg from 'pg';import{randomBytes,randomUUID}from'node:crypto';import{readFile,writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';import{managementPolicy}from'../apps/api/src/security-domain';
export const managedLogins=['front.east','front.river','doctor.lin','doctor.zhou','doctor.river','nurse.east','imaging.east','followup.assist','stock.east','stock.river','sales.east','finance.hq','review.hq','manager.east','manager.river','quality.east'];
export async function seedSecurity(applyDevelopment=false,backup=false){
 const env=await config(),test=/^adc_[a-z_]+_test_\d+$/.test(env.PGDATABASE!);if(env.PGDATABASE==='adc_dev'&&!applyDevelopment)throw Error('开发库独立管理员及明确可管范围须先获得用户批准。');if(env.PGDATABASE!=='adc_dev'&&!test)throw Error('只允许本机具名开发库或本次隔离测试库。');if(backup&&!test)throw Error('备用管理员仅用于本次隔离并发测试，不向开发库添加。');
 const c=new pg.Client(pgOptions(env));await c.connect();const boot=id('booking-bootstrap'),east=id('clinic-east'),river=id('clinic-river'),adminId=id('account187-admin'),employeeId=id('employee187-admin'),targets:any[]=[],directory=await seedReportDirectory(env),credentials:any={};
 const admins=[{key:'admin',login:'admin.local',id:adminId,employeeId},...(backup?[{key:'backup',login:'admin.backup',id:id('account187-backup'),employeeId:id('employee187-backup')}]:[])];
 async function put(table:string,data:any){const cols=Object.keys(data);await c.query(`INSERT INTO adc.${table}(${cols.join(',')}) VALUES(${cols.map((_,i)=>'$'+(i+1)).join(',')})`,Object.values(data));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',['security-management']);
 if((await c.query('SELECT 1 FROM adc.staff_account WHERE account_id=$1',[adminId])).rowCount){await c.query('ROLLBACK');console.log('Original bounded administrator retained; no credentials or policy reset.');return{adminId,created:false,credentials:{}};}
 for(const login of managedLogins){const a=(await c.query('SELECT account_id,employee_id FROM adc.staff_account WHERE login_name=$1',[login])).rows[0];if(!a)throw Error('缺少明确目标账号：'+login);const g=(await c.query('SELECT * FROM adc.access_grant WHERE account_id=$1 AND effective_from<=clock_timestamp() ORDER BY effective_from DESC,version_no DESC LIMIT 1',[a.account_id])).rows[0];if(!g||g.effective_to&&+g.effective_to<=Date.now()||g.object_scope!==null)throw Error('原可授授权须有效且无不明对象范围：'+login);const clinicIds=(await c.query('SELECT clinic_id FROM adc.grant_clinic WHERE grant_id=$1 ORDER BY clinic_id',[g.grant_id])).rows.map(r=>r.clinic_id);if(!clinicIds.length||clinicIds.some(x=>![east,river].includes(x)))throw Error('目标诊所范围与明确范围不同：'+login);const functions=(await c.query('SELECT DISTINCT function_code FROM adc.grant_role gr JOIN adc.role_function f USING(role_version_id) WHERE gr.grant_id=$1 ORDER BY function_code',[g.grant_id])).rows.map(x=>x.function_code);if(functions.some(f=>f.startsWith('security.')))throw Error('不能把既有管理授权作为普通目标上限');const fields=(await c.query('SELECT resource_code AS resource,field_code AS field,action_code AS action FROM adc.grant_field WHERE grant_id=$1 ORDER BY resource_code,field_code,action_code',[g.grant_id])).rows;targets.push({accountId:a.account_id,employeeId:a.employee_id,clinicIds,functions,fields,grantEditable:true});}
 for(const a of admins)targets.push({accountId:a.id,employeeId:a.employeeId,clinicIds:[east,river],functions:['security.read','security.manage'],fields:[{resource:'security',field:'status',action:'maintain'},{resource:'security',field:'grant',action:'maintain'}],grantEditable:false});const policy=managementPolicy({schemaVersion:1,kind:'bounded-account-management',targets});
 for(const a of admins){const secretPath=join(directory,`security-${a.key}-private.json`);let secret:any;try{secret=JSON.parse(await readFile(secretPath,'utf8'));if(secret.accountId!==a.id||secret.database!==env.PGDATABASE||typeof secret.password!=='string')throw Error('Private administrator seed identity mismatch');}catch(e:any){if(e.code!=='ENOENT')throw e;secret={database:env.PGDATABASE,accountId:a.id,login:a.login,password:randomBytes(24).toString('base64url')};await writeFile(secretPath,JSON.stringify(secret),{flag:'wx'});}credentials[a.key]=secret.password;const now=new Date(),role=id('role187-'+a.key),rv=id('rolev187-'+a.key),gid=id('grant187-'+a.key);await put('employee',{employee_id:a.employeeId,name:a.key==='admin'?'系统管理员（合成）':'备用系统管理员（隔离测试）',employment_arrangement:JSON.stringify({assignments:[{clinicId:east,role:'system_admin',from:'2026-01-01',to:null},{clinicId:river,role:'system_admin',from:'2026-01-01',to:null}]}),public_enabled:false,row_version:1});await put('staff_account',{account_id:a.id,employee_id:a.employeeId,login_name:a.login,credential_verifier:await credentialHash(secret.password),activation_arrangement:'enabled',opened_at:now,maintained_by:boot,maintained_at:now,row_version:1});await put('security_role',{role_id:role,name:'受限账号管理员',responsibility:'仅账号状态及既有可授范围，不直接访问业务资料',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'受限账号管理员',configured_by:boot,configured_at:now});for(const f of['security.read','security.manage'])await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:gid,account_id:a.id,version_no:1,effective_from:now,object_scope:JSON.stringify(policy),configured_by:boot,configured_at:now});await put('grant_role',{grant_id:gid,role_version_id:rv});for(const clinic of[east,river])await put('grant_clinic',{grant_id:gid,clinic_id:clinic});for(const field of['status','grant'])await put('grant_field',{grant_field_id:id(gid+field),grant_id:gid,resource_code:'security',field_code:field,action_code:'maintain'});const op=randomUUID();await put('business_operation',{operation_id:op,actor_id:boot,occurred_at:now,action_code:'security.bootstrap',subject_kind:'staff_account',subject_key:a.id,after_content:JSON.stringify({grant:{id:gid},policy,accountId:a.id,explicitDevelopmentApproval:applyDevelopment,isolated:test}),reason:'建立独立有界账号管理员；只管理明确目标及其原已批准范围，无直接临床交易访问'});for(const clinic of[east,river])await put('operation_clinic',{operation_id:op,clinic_id:clinic});}
 await c.query('COMMIT');await writeFile(join(directory,'账号权限演示账号.txt'),`仅本机合成账号；不要提交或公开\n入口 http://127.0.0.1:5173/\n系统管理员 admin.local：${credentials.admin}\n管理16个明确合成员工账号，原可授范围内收回恢复；无患者临床交易直接权限。\n`,'utf8');console.log('Bounded synthetic administrator prepared; password kept in private local account note, no ordinary grants changed.');return{adminId,created:true,credentials};
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}
}
if(process.argv[1]?.endsWith('seed-security.mts'))seedSecurity(process.argv.includes('--apply-approved-development')).catch(e=>{console.error(e.message);process.exitCode=1;});
