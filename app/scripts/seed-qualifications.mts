import pg from'pg';import{randomUUID}from'node:crypto';import{config,pgOptions}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{managementPolicy,fieldKey}from'../apps/api/src/security-domain';
const functions=['dentist.qualification.read','dentist.qualification.manage'],field={resource:'dentist',field:'qualification',action:'maintain' as const};
export async function seedQualifications(applyDevelopment=false){const env=await config(),isolated=/^adc_[a-z_]+_test_\d+$/.test(env.PGDATABASE!);if(env.PGDATABASE==='adc_dev'&&!applyDevelopment)throw Error('开发库证书/附件权限及三目标可授上限须先获明确批准。');if(env.PGDATABASE!=='adc_dev'&&!isolated)throw Error('只允许具名开发或本次隔离测试库。');const c=new pg.Client(pgOptions(env));await c.connect();const boot=id('booking-bootstrap'),east=id('clinic-east'),river=id('clinic-river'),admin=id('account187-admin'),policyId=id('grant188-security-policy');async function put(t:string,v:any){const cols=Object.keys(v);await c.query(`INSERT INTO adc.${t}(${cols.join(',')}) VALUES(${cols.map((_,i)=>'$'+(i+1)).join(',')})`,Object.values(v));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',['security-management']);if((await c.query('SELECT 1 FROM adc.access_grant WHERE grant_id=$1',[policyId])).rowCount){await c.query('ROLLBACK');console.log('Original qualification grants and bounded administrator policy retained; no regrant or credentials changed.');return;}
 const adminGrant=(await c.query('SELECT * FROM adc.access_grant WHERE account_id=$1 AND effective_from<=clock_timestamp() ORDER BY effective_from DESC,version_no DESC LIMIT 1',[admin])).rows[0];if(!adminGrant||adminGrant.effective_to&&+adminGrant.effective_to<=Date.now())throw Error('缺少原有效有界管理员授权');const policy=managementPolicy(adminGrant.object_scope);
 for(const[key,login,scopes]of[['manager-east','manager.east',[east]],['manager-river','manager.river',[river]],['review','review.hq',[east,river]]]as[string,string,string[]][]){const a=(await c.query('SELECT account_id,employee_id FROM adc.staff_account WHERE login_name=$1 AND activation_arrangement=\'enabled\' AND disabled_at IS NULL',[login])).rows[0];if(!a)throw Error('缺少原有效目标账号：'+login);const old=(await c.query('SELECT * FROM adc.access_grant WHERE account_id=$1 AND effective_from<=clock_timestamp() ORDER BY effective_from DESC,version_no DESC LIMIT 1',[a.account_id])).rows[0];if(!old||old.object_scope!==null||old.effective_to&&+old.effective_to<=Date.now())throw Error('原目标授权不可直接扩展');if((await c.query('SELECT 1 FROM adc.access_grant WHERE account_id=$1 AND effective_from>clock_timestamp()',[a.account_id])).rowCount)throw Error('目标存在未来授权，不能覆盖');const actual=(await c.query('SELECT clinic_id FROM adc.grant_clinic WHERE grant_id=$1 ORDER BY clinic_id',[old.grant_id])).rows.map(x=>x.clinic_id);if(JSON.stringify(actual)!==JSON.stringify([...scopes].sort()))throw Error('目标原诊所范围与已批准范围不一致');const limit=policy.targets.find(t=>t.accountId===a.account_id&&t.employeeId===a.employee_id&&t.grantEditable);if(!limit)throw Error('原可授策略中没有相同目标');
 const oldFunctions=(await c.query('SELECT DISTINCT function_code FROM adc.grant_role gr JOIN adc.role_function f USING(role_version_id) WHERE gr.grant_id=$1',[old.grant_id])).rows.map(x=>x.function_code),oldFields=(await c.query('SELECT resource_code AS resource,field_code AS field,action_code AS action FROM adc.grant_field WHERE grant_id=$1',[old.grant_id])).rows;if(oldFunctions.some(f=>!limit.functions.includes(f))||oldFields.some(f=>!limit.fields.some(x=>fieldKey(x)===fieldKey(f))))throw Error('原当前权限超出已批准旧上限，请先核对，不自动扩大其他范围');
 const gid=id('grant188-'+key),role=id('role188-'+key),rv=id('rolev188-'+key),now=new Date();await put('security_role',{role_id:role,name:login+' 证书及附件维护',responsibility:'只在已批准诊所和关联牙医范围内维护证书，不增加临床交易权',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'牙医证书及私有附件',configured_by:boot,configured_at:now});for(const f of functions)await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:gid,account_id:a.account_id,version_no:Number(old.version_no)+1,effective_from:now,configured_by:boot,configured_at:now});await c.query('INSERT INTO adc.grant_role SELECT $1,role_version_id FROM adc.grant_role WHERE grant_id=$2',[gid,old.grant_id]);await put('grant_role',{grant_id:gid,role_version_id:rv});for(const clinic of scopes)await put('grant_clinic',{grant_id:gid,clinic_id:clinic});for(const f of[...oldFields,field])await put('grant_field',{grant_field_id:randomUUID(),grant_id:gid,resource_code:f.resource,field_code:f.field,action_code:f.action});const op=randomUUID();await put('business_operation',{operation_id:op,actor_id:boot,occurred_at:now,action_code:'access.configure.synthetic',subject_kind:'access_grant',subject_key:gid,after_content:JSON.stringify({priorGrant:old.grant_id,account:login,addedFunctions:functions,addedField:field,clinicIds:scopes,explicitDevelopmentApproval:applyDevelopment,isolated}),reason:'明确批准三既有账号证书及私有附件查询维护，保原功能，不增加其他业务权'});for(const clinic of scopes)await put('operation_clinic',{operation_id:op,clinic_id:clinic});limit.functions=[...new Set([...limit.functions,...functions])].sort();if(!limit.fields.some(x=>fieldKey(x)===fieldKey(field)))limit.fields.push(field);
 }
 const now=new Date();await put('access_grant',{grant_id:policyId,account_id:admin,version_no:Number(adminGrant.version_no)+1,effective_from:now,object_scope:JSON.stringify(managementPolicy(policy)),configured_by:boot,configured_at:now});await c.query('INSERT INTO adc.grant_role SELECT $1,role_version_id FROM adc.grant_role WHERE grant_id=$2',[policyId,adminGrant.grant_id]);await c.query('INSERT INTO adc.grant_clinic SELECT $1,clinic_id FROM adc.grant_clinic WHERE grant_id=$2',[policyId,adminGrant.grant_id]);for(const f of(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[adminGrant.grant_id])).rows)await put('grant_field',{grant_field_id:randomUUID(),grant_id:policyId,...f});const op=randomUUID();await put('business_operation',{operation_id:op,actor_id:boot,occurred_at:now,action_code:'security.policy.extend',subject_kind:'access_grant',subject_key:policyId,before_content:JSON.stringify({grantId:adminGrant.grant_id}),after_content:JSON.stringify({grant:{id:policyId},policy,extendedLogins:['manager.east','manager.river','review.hq'],addedFunctions:functions,addedField:field,explicitDevelopmentApproval:applyDevelopment,isolated}),reason:'仅同步三目标新增证书权至原有界可授上限；管理员自身仍只管理账号，不直接读取证书'});for(const clinic of[east,river])await put('operation_clinic',{operation_id:op,clinic_id:clinic});await c.query('COMMIT');console.log('Three existing qualification scopes and their bounded delegation ceilings extended; no accounts or passwords created.');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}
}
if(process.argv[1]?.endsWith('seed-qualifications.mts'))seedQualifications(process.argv.includes('--apply-approved-development')).catch(e=>{console.error(e.message);process.exitCode=1;});
