import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{writeFile}from'node:fs/promises';import{join}from'node:path';
import{recoveryFixture}from'./booking-recovery-fixture.mts';import{root}from'./config.mjs';import{databaseSnapshot}from'./snapshot-startup186.mjs';import{bookingInput}from'../apps/api/src/booking-domain.ts';
const f=await recoveryFixture(),passed:string[]=[];
async function check(name:string,fn:()=>Promise<void>){await fn();passed.push(name);console.log('PASS',name);}
async function call(path:string,body?:any,cookie=''){const r=await fetch(f.base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:f.env.ADMIN_ORIGIN}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||'',cache:r.headers.get('cache-control')};}
const query=(id:string,kind='book',target?:string)=>'/patient/appointment-commands/'+id+'?kind='+kind+(target?'&appointmentId='+target:'');
try{
 const a=(await call('/patient/session',{loginName:'alice',password:f.env.ADC_PATIENT_A_PASSWORD})).cookie,b=(await call('/patient/session',{loginName:'bob',password:f.env.ADC_PATIENT_B_PASSWORD})).cookie,staff=(await call('/staff/session',{loginName:'front.east',password:f.env.ADC_STAFF_EAST_PASSWORD})).cookie;
 const actor=await f.auth.patient({headers:{cookie:a}}as any),other=await f.auth.patient({headers:{cookie:b}}as any);
 const cat=(await call('/catalogue')).json.items.find((x:any)=>x.doctorName==='林医生'),group=(await call(`/availability?date=${f.env.BOOKING_DEMO_DATE}&doctorId=${cat.doctorId}&serviceVersionId=${cat.serviceVersionId}`)).json.groups[0];
 const command=(i:number)=>({requestId:randomUUID(),scheduleId:group.scheduleId,serviceVersionId:group.serviceVersionId,ruleVersionId:group.ruleVersionId,startsAt:group.slots[i].startsAt,name:'断网合成患者',contact:'13800000001',intention:'隔离断网核实'});
 await check('核实入口拒未登录及员工身份，响应禁止缓存',async()=>{const p=query(randomUUID());assert.equal((await call(p)).status,401);assert.equal((await call(p,undefined,staff)).status,401);assert.equal((await call(p,undefined,a)).cache,'no-store');});
 await check('核实参数拒未知键/主体注入/非法UUID/多值及缺目标',async()=>{for(const p of['/patient/appointment-commands/bad?kind=book',query(randomUUID())+'&subjectId='+other.subjectId,query(randomUUID())+'&kind=cancel',query(randomUUID(),'cancel'),query(randomUUID(),'book',randomUUID()),query(randomUUID(),'other')])assert.equal((await call(p,undefined,a)).status,400,p);});
 await check('不存在原请求只读未查到，不产生预约/原版/去重',async()=>{const before=await databaseSnapshot({...f.env,PGDATABASE:f.testDb});assert.equal((await call(query(randomUUID()),undefined,a)).json.state,'not_found');const after=await databaseSnapshot({...f.env,PGDATABASE:f.testDb});for(const t of['adc.appointment','adc.appointment_revision','adc.command_dedup'])assert.deepEqual(after[t],before[t]);});
 const cmd=command(0);let first:any;
 await check('真实HTTP事务已提交而回复丢失，再GET找回原完成结果',async()=>{f.arm('book');await assert.rejects(()=>call('/patient/appointments',cmd,a));assert.equal(f.faults.length,1);assert.equal(f.faults[0].phase,'after');const r=await call(query(cmd.requestId),undefined,a);assert.equal(r.status,200);assert.equal(r.json.state,'completed');first=r.json;assert.equal(r.json.version,1);assert.equal(r.json.disposition,'active');assert.equal((await f.db.pool.query('SELECT count(*)::int n FROM adc.appointment')).rows[0].n,1);});
 await check('重复核实10次不重复办理，结果不含患者/联系/意向等正文',async()=>{for(let n=0;n<10;n++){const r=(await call(query(cmd.requestId),undefined,a)).json;assert.equal(r.appointmentId,first.appointmentId);assert.deepEqual(Object.keys(r).sort(),['state','kind','queriedAt','appointmentId','version','disposition','completedAt'].sort());}assert.equal((await f.db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision')).rows[0].n,1);assert.equal((await f.db.pool.query('SELECT count(*)::int n FROM adc.command_dedup')).rows[0].n,1);});
 await check('其他主体已完成请求与不存在请求同形，不返回他人ID',async()=>{const r=(await call(query(cmd.requestId),undefined,b)).json,x=(await call(query(randomUUID()),undefined,b)).json;assert.deepEqual({...r,queriedAt:''},{...x,queriedAt:''});assert.equal(r.state,'not_found');assert.equal('appointmentId'in r,false);});
 const missing=command(1);
 await check('HTTP请求到业务前断开，核实不自动补办',async()=>{f.arm('book','before');await assert.rejects(()=>call('/patient/appointments',missing,a));assert.equal((await call(query(missing.requestId),undefined,a)).json.state,'not_found');assert.equal((await f.db.pool.query('SELECT 1 FROM adc.command_dedup WHERE request_key=$1',[missing.requestId])).rowCount,0);});
 await check('用户明确原请求重试后成功，随后相同重试仍只一版',async()=>{const r=await call('/patient/appointments',missing,a);assert.equal(r.status,201);const again=await call('/patient/appointments',missing,a);assert.equal(again.json.repeated,true);assert.equal(again.json.id,r.json.id);assert.equal((await f.db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision WHERE appointment_id=$1',[r.json.id])).rows[0].n,1);});
 const moved={...command(2),version:1};
 await check('改约已提交丢回复，只读核实当次2版',async()=>{f.arm('reschedule');await assert.rejects(()=>call(`/patient/appointments/${first.appointmentId}/reschedule`,moved,a));const r=(await call(query(moved.requestId,'reschedule',first.appointmentId),undefined,a)).json;assert.equal(r.state,'completed');assert.equal(r.version,2);assert.equal(r.disposition,'active');});
 const cancel={requestId:randomUUID(),version:2,reason:'隔离原取消'};
 await check('取消已提交丢回复，只读核实3版且仅释放一次',async()=>{f.arm('cancel');await assert.rejects(()=>call(`/patient/appointments/${first.appointmentId}/cancel`,cancel,a));const r=(await call(query(cancel.requestId,'cancel',first.appointmentId),undefined,a)).json;assert.equal(r.state,'completed');assert.equal(r.version,3);assert.equal(r.disposition,'cancelled');assert.equal((await f.db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision WHERE appointment_id=$1',[first.appointmentId])).rows[0].n,3);});
 await check('后来改约取消不覆盖新约及改约原完成结果',async()=>{const r=(await call(query(cmd.requestId),undefined,a)).json,m=(await call(query(moved.requestId,'reschedule',first.appointmentId),undefined,a)).json;assert.equal(r.version,1);assert.equal(r.disposition,'active');assert.equal(m.version,2);assert.equal(m.disposition,'active');assert.equal((await f.db.pool.query('SELECT disposition FROM adc.appointment WHERE appointment_id=$1',[first.appointmentId])).rows[0].disposition,'cancelled');});
 await check('目标或请求类型不符不返回原结果，重试原取消不再改数据',async()=>{assert.equal((await call(query(cancel.requestId,'cancel',randomUUID()),undefined,a)).json.state,'not_found');assert.equal((await call(query(cmd.requestId,'cancel',first.appointmentId),undefined,a)).json.state,'not_found');assert.equal((await call(`/patient/appointments/${first.appointmentId}/cancel`,cancel,a)).json.repeated,true);});
 await check('在途原命令立即返回处理中，其他主体仍未查到',async()=>{const x=command(3);let release!:()=>void,entered!:()=>void;const reached=new Promise<void>(r=>entered=r),gate=new Promise<void>(r=>release=r);const writing=f.booking.command(actor,'book',bookingInput(x,true),undefined,async()=>{entered();await gate;});await reached;try{const started=Date.now(),r=await call(query(x.requestId),undefined,a);assert.equal(r.json.state,'processing');assert.ok(Date.now()-started<2000);assert.equal((await call(query(x.requestId),undefined,b)).json.state,'not_found');}finally{release();await writing;}assert.equal((await call(query(x.requestId),undefined,a)).json.state,'completed');});
 await check('事务内原写失败全部回滚，核实仍未查到',async()=>{const x=command(4);await assert.rejects(()=>f.booking.command(actor,'book',bookingInput(x,true),undefined,async()=>{throw Error('isolated rollback');}),/isolated rollback/);assert.equal((await call(query(x.requestId),undefined,a)).json.state,'not_found');assert.equal((await f.db.pool.query('SELECT 1 FROM adc.command_dedup WHERE request_key=$1',[x.requestId])).rowCount,0);});
 await check('读取审计仅实际原请求结果引用，不复制个人内容',async()=>{const rows=(await f.db.pool.query("SELECT * FROM adc.business_operation WHERE action_code='patient.appointment-command.view'")).rows;assert.ok(rows.length>=20);for(const r of rows){const s=r.access_scope;assert.ok(['completed','processing','not_found'].includes(s.state));assert.equal(s.appointmentIds.length,s.state==='completed'?1:0);for(const key of['name','contact','intention','before_content','after_content'])assert.equal(key in s,false);assert.equal(r.before_content,null);assert.equal(r.after_content,null);const links=(await f.db.pool.query('SELECT * FROM adc.operation_clinic WHERE operation_id=$1',[r.operation_id])).rows;assert.equal(links.length,s.state==='completed'?1:0);}});
 await check('核实前后除新增供阅审计外所有业务与授权整表保持',async()=>{const before=await databaseSnapshot({...f.env,PGDATABASE:f.testDb});for(let i=0;i<3;i++)await call(query(cmd.requestId),undefined,a);const after=await databaseSnapshot({...f.env,PGDATABASE:f.testDb});for(const t of Object.keys(before))if(!['adc.business_operation','adc.operation_clinic'].includes(t))assert.deepEqual(after[t],before[t],t);});
 await check('当前核验撤销及伪造主体不能用旧请求读取',async()=>{await f.db.pool.query('UPDATE adc_auth.local_identity SET enabled=false WHERE identity_id=$1',[actor.identityId]);assert.equal((await call(query(cmd.requestId),undefined,a)).status,401);await assert.rejects(()=>f.booking.commandStatus(actor,cmd.requestId,{kind:'book'}),/本人验证/);await f.db.pool.query('UPDATE adc_auth.local_identity SET enabled=true WHERE identity_id=$1',[actor.identityId]);await assert.rejects(()=>f.booking.commandStatus({...actor,subjectId:other.subjectId},cmd.requestId,{kind:'book'}),/本人验证/);});
 await check('退出后旧会话不能核实，原操作与预约原版仍不可改',async()=>{assert.equal((await call('/patient/logout',{},a)).status,201);assert.equal((await call(query(cmd.requestId),undefined,a)).status,401);await assert.rejects(()=>f.db.pool.query('DELETE FROM adc.appointment_revision WHERE appointment_id=$1',[first.appointmentId]),/immutable/);});
 await writeFile(join(root,'artifacts/booking-recovery-check.json'),JSON.stringify({batch:202,checks:passed.length,passed,faults:f.faults,testDatabase:'isolated named temporary PG; dropped after checks',developmentBusinessWrites:false,checkedAt:new Date().toISOString()},null,2));console.log('Booking recovery checks passed:',passed.length);
}finally{await f.close();}
