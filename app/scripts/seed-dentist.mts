import pg from'pg';import{randomUUID}from'node:crypto';import{config,pgOptions}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';
// Only the three explicitly approved synthetic accounts; no new credentials or unrelated write functions added.
export async function seedDentist(applyDevelopment=false){const env=await config();if(env.PGDATABASE==='adc_dev'&&!applyDevelopment)throw Error('开发库诊所维护授权须显式采用用户已批准范围。');if(env.PGDATABASE!=='adc_dev'&&!/^adc_[a-z_]+_test_\d+$/.test(env.PGDATABASE!))throw Error('只配置具名开发库或本次隔离测试库。');const c=new pg.Client(pgOptions(env));await c.connect();
 const east=id('clinic-east'),river=id('clinic-river'),boot=id('booking-bootstrap');async function put(t:string,d:any){const ks=Object.keys(d);await c.query(`INSERT INTO adc.${t}(${ks.join(',')}) VALUES(${ks.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(d));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(185001)');for(const[key,login,scopes,functions]of[
  ['manager-east','manager.east',[east],['dentist.read','dentist.manage']],['manager-river','manager.river',[river],['dentist.read','dentist.manage']],['review','review.hq',[east,river],['dentist.read','dentist.manage']]
 ]as [string,string,string[],string[]][]){
  const account=(await c.query("SELECT account_id FROM adc.staff_account WHERE login_name=$1 AND activation_arrangement='enabled'",[login])).rows[0];if(!account)throw Error('缺少原合成账号：'+login);const gid=id('grant185-'+key);if((await c.query('SELECT 1 FROM adc.access_grant WHERE grant_id=$1',[gid])).rowCount)continue;
  const old=(await c.query('SELECT * FROM adc.access_grant WHERE account_id=$1 AND effective_from<=clock_timestamp() AND (effective_to IS NULL OR effective_to>clock_timestamp()) ORDER BY effective_from DESC,version_no DESC LIMIT 1',[account.account_id])).rows[0];if(!old)throw Error('原有效授权缺失');const oldScopes=(await c.query('SELECT clinic_id FROM adc.grant_clinic WHERE grant_id=$1 ORDER BY clinic_id',[old.grant_id])).rows.map(r=>r.clinic_id);if(JSON.stringify(oldScopes)!==JSON.stringify([...scopes].sort()))throw Error('原授权范围与已批准诊所维护范围不同，不能自动扩大');
  const role=id('role185-dentist-'+key),rv=id('rolev185-dentist-'+key),now=new Date();await put('security_role',{role_id:role,name:login+' 牙医资料技能公开介绍及执业维护',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:login+' 牙医资料技能公开介绍及执业维护',configured_by:boot,configured_at:now});for(const fn of functions)await put('role_function',{role_version_id:rv,function_code:fn});
  await put('access_grant',{grant_id:gid,account_id:account.account_id,version_no:Number(old.version_no)+1,effective_from:now,configured_by:boot,configured_at:now});await c.query('INSERT INTO adc.grant_role SELECT $1,role_version_id FROM adc.grant_role WHERE grant_id=$2',[gid,old.grant_id]);await put('grant_role',{grant_id:gid,role_version_id:rv});for(const clinic of scopes)await put('grant_clinic',{grant_id:gid,clinic_id:clinic});const fs=[...(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[old.grant_id])).rows,...['profile','skills','public','practice'].map(field_code=>({resource_code:'dentist',field_code,action_code:'maintain'}))];for(const f of fs)await put('grant_field',{grant_field_id:id(gid+f.resource_code+f.field_code+f.action_code),grant_id:gid,...f});
  const op=randomUUID();await put('business_operation',{operation_id:op,actor_id:boot,occurred_at:now,action_code:'access.configure.synthetic',subject_kind:'access_grant',subject_key:gid,reason:'用户2026-10-26明确批准三账号本机牙医资料技能公开介绍及执业维护；保原功能，不增其他业务写权',after_content:JSON.stringify({account:login,priorGrant:old.grant_id,addedFunctions:functions,clinicIds:scopes})});for(const clinic of scopes)await put('operation_clinic',{operation_id:op,clinic_id:clinic});
 }await c.query('COMMIT');console.log('Approved dentist management scopes configured for three existing synthetic accounts; no credentials or clinical/financial writes added.');}catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}}
if(process.argv[1]?.endsWith('seed-dentist.mts'))seedDentist(process.argv.includes('--apply-approved-development')).catch(e=>{console.error(e.message);process.exitCode=1;});
