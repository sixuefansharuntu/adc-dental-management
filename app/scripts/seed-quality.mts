import pg from 'pg';import {writeFile} from 'node:fs/promises';import {join} from 'node:path';import {config,pgOptions,root,seedReportDirectory} from './config.mjs';import {fixtureId as id} from './seed.mjs';import {credentialHash} from '../apps/api/src/auth.service.ts';
export async function seedQuality(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const boot=id('booking-bootstrap'),east=id('clinic-east'),river=id('clinic-river');async function put(t:string,d:any){const keys=Object.keys(d);await c.query(`INSERT INTO adc.${t}(${keys.join(',')}) VALUES(${keys.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(d));}
try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(177001)');
for(const[key,account,roleId,priorRv,priorGrant,version,clinic]of [
 ['east',id('account173-manager'),id('role173-manager'),id('rolev176-manager'),id('grant176-manager'),4,east],
 ['river',id('account176-manager-river'),id('role176-manager-river'),id('rolev176-manager-river'),id('grant176-manager-river'),2,river]
]as const){const rv=id('rolev177-manager-'+key),g=id('grant177-manager-'+key);await put('role_version',{role_version_id:rv,role_id:roleId,version_no:version,name:'原管理功能及资料检查',configured_by:boot,configured_at:new Date()});await c.query('INSERT INTO adc.role_function SELECT $1,function_code FROM adc.role_function WHERE role_version_id=$2 ON CONFLICT DO NOTHING',[rv,priorRv]);for(const f of ['quality.read','quality.manage'])await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:g,account_id:account,version_no:version,effective_from:'2026-10-25T13:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:clinic});const fs=(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[priorGrant])).rows;for(const f of [...fs,{resource_code:'quality',field_code:'issues',action_code:'maintain'}])await put('grant_field',{grant_field_id:id(g+f.resource_code+f.field_code),grant_id:g,...f});}
const emp=id('employee177-quality'),account=id('account177-quality'),role=id('role177-quality'),rv=id('rolev177-quality'),g=id('grant177-quality');await put('employee',{employee_id:emp,name:'资料检查协助前台（合成）',employment_arrangement:JSON.stringify({assignments:[{clinicId:east,role:'frontdesk',from:'2026-01-01',to:null}]}),public_enabled:false,row_version:1});await put('staff_account',{account_id:account,employee_id:emp,login_name:'quality.east',credential_verifier:await credentialHash(env.ADC_QUALITY_PASSWORD!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:boot,maintained_at:new Date(),row_version:1});await put('security_role',{role_id:role,name:'本机授权资料检查协助前台',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'只检查跟踪，不代写原资料',configured_by:boot,configured_at:new Date()});for(const f of ['quality.read','quality.manage'])await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:g,account_id:account,version_no:1,effective_from:'2026-10-25T00:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:east});await put('grant_field',{grant_field_id:id(g+'issues'),grant_id:g,resource_code:'quality',field_code:'issues',action_code:'maintain'});await c.query('COMMIT');}catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'资料检查演示账号.txt'),`仅本机合成资料，不提交\n授权协助前台 quality.east：${env.ADC_QUALITY_PASSWORD}\nmanager.east/manager.river口令沿用，保留原权限并增加本店检查。普通前台和财务不增加检查权。无种子预填问题或通知。\n`,'utf8');console.log('Quality grants versioned; private credential saved; no issues or notifications seeded.');}
if(process.argv[1]?.endsWith('seed-quality.mts'))seedQuality().catch(e=>{console.error(e.message);process.exitCode=1;});

