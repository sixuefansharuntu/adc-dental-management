  await db.pool.query('INSERT INTO adc.role_version(role_version_id,role_id,version_no,name,configured_by,configured_at) VALUES($1,$2,1,\'隔离分页管理\',$3,$4)',[rv,role,id('booking-bootstrap'),stamp]);
  for(const f of['security.read','security.manage'])await db.pool.query('INSERT INTO adc.role_function VALUES($1,$2)',[rv,f]);
  await db.pool.query('INSERT INTO adc.access_grant(grant_id,account_id,version_no,effective_from,configured_by,configured_at,object_scope) VALUES($1,$2,1,$3,$4,$3,$5)',[gid,pa.accountId,stamp,id('booking-bootstrap'),JSON.stringify({schemaVersion:1,kind:'bounded-account-management',targets})]);
  await db.pool.query('INSERT INTO adc.grant_role VALUES($1,$2)',[gid,rv]);await db.pool.query('INSERT INTO adc.grant_clinic VALUES($1,$2)',[gid,east]);
  const cookie=await login('fixture.page.admin',seeded.credentials.admin),a=await call('/security',undefined,cookie);ok(a,200);assert.equal(a.json.items.length,50);assert.ok(a.json.nextId);
