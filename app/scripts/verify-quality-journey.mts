import pg from'pg';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{writeFile,rm}from'node:fs/promises';import{join,resolve,sep}from'node:path';
import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{fixtureId as id}from'./seed.mjs';
import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{seedClinical}from'./seed-clinical.mts';import{seedCare}from'./seed-care.mts';import{seedFollowup}from'./seed-followup.mts';import{seedInventory}from'./seed-inventory.mts';import{seedSales}from'./seed-sales.mts';import{seedQuarter}from'./seed-quarter.mts';import{seedQuality}from'./seed-quality.mts';import{seedBusiness}from'./seed-business.mts';
const env=await config();env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});Object.assign(process.env,env);
const original=env.PGDATABASE,name='adc_quality_journey_test_'+Date.now(),folder=resolve(root,'.runtime',name);if(!/^adc_quality_journey_test_\d+$/.test(name)||!folder.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe isolated target');
const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_ISOLATED_SEED_REPORTS='true';
let app:any;const passed:string[]=[],evidence:any={};let reads=0,writes=0;const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function check(label:string,f:()=>Promise<void>){await f();passed.push(label);console.log('PASS',label);}
try{
 await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();await seedBusiness();
 const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),east=id('clinic-east'),lin=id('booking-lin'),nurseId=id('nurse-east-a');
 async function call(path:string,body?:any,cookie=''){body?writes++:reads++;const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:env.ADMIN_ORIGIN}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 async function login(kind:string,loginName:string,password:string){const r=await call('/'+kind+'/session',{loginName,password});ok(r);return r.cookie;}
 const front=await login('staff','front.east',env.ADC_STAFF_EAST_PASSWORD!),doctor=await login('staff','doctor.lin',env.ADC_DOCTOR_LIN_PASSWORD!),stock=await login('staff','stock.east',env.ADC_STOCK_EAST_PASSWORD!),finance=await login('staff','finance.hq',env.ADC_FINANCE_PASSWORD!),quality=await login('staff','quality.east',env.ADC_QUALITY_PASSWORD!),manager=await login('staff','manager.east',env.ADC_MANAGER_EAST_PASSWORD!);const day=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),filter={clinicId:east,year:Number(day.slice(0,4)),quarter:Math.floor((Number(day.slice(5,7))-1)/3)+1,kinds:['expense','issue','record']},at=()=>new Date(Date.now()-1).toISOString();let visit:any,record:any,expense:any,issue:any,stockId:string,issueBody:any,expenseBody:any;const problems:any={},old:any={};
 const rec=(version=0,complete=false)=>({requestId:randomUUID(),recordVersion:version,clinicalAt:visit.arrivedAt,body:complete?'PRIVATE_BODY_273':null,pendingNote:complete?null:'PRIVATE_PENDING_273',completeness:complete?'complete':'pending',doctorConfirmed:true,treatments:[],reason:version?'合成医生补正文273':null});
 await check('建立费用待补凭据来源，金额30明确不补零',async()=>{expenseBody={requestId:randomUUID(),id:null,version:0,clinicId:east,category:'合成运营费用273',amount:'30.00',occurredOn:day,voucherReference:null,voucherNote:'合成凭据尚待核对273',pendingNote:'凭据编号待补',actualConfirmed:true,distinctConfirmed:false,reason:null};const r=await call('/quarter/expenses',expenseBody,finance);ok(r);expense=r.json;});
 await check('医生登记正文待补来源，不因到院就造完整病历',async()=>{const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:east,name:'合成资料检查患者273',phone:'13800000273',identityBasis:'合成核对273'},front);ok(p);const v=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:east,patientId:p.json.id,doctorId:lin,nurseIds:[nurseId],arrivedAt:new Date(Date.now()-20000).toISOString(),basis:'合成到院273',identityBasis:'合成明确核对',identityConfirmed:true,coordination:'合成核实内部安排'},front);ok(v);visit=v.json;const r=await call('/clinical/visits/'+visit.id+'/record',rec(),doctor);ok(r);record=r.json;});
 await check('建立领用未知成本来源，库存实发1余2但成本仍未知',async()=>{const m=await call('/inventory/materials',{requestId:randomUUID(),clinicId:east,name:'合成资料检查材料273',classification:'材料',unit:'盒',enabled:true},stock);ok(m);const s=await call('/inventory/suppliers',{requestId:randomUUID(),clinicId:east,name:'合成资料检查供应商273',enabled:true},stock);ok(s);const r=await call('/inventory/receipts',{requestId:randomUUID(),clinicId:east,materialId:m.json.id,supplierId:s.json.id,batch:null,expiresOn:null,unit:'盒',quantity:'3',receivedAt:new Date(Date.now()-10000).toISOString(),unitPrice:null,pendingNote:'合成入库价格待核实',sourceReference:'273-IN#1',actualConfirmed:true},stock);ok(r);stockId=r.json.stockId;const st=(await db.pool.query('SELECT row_version FROM adc.stock_balance WHERE stock_id=$1',[stockId])).rows[0];issueBody={requestId:randomUUID(),issueId:null,version:0,stockId,stockVersion:Number(st.row_version),recipientId:nurseId,unit:'盒',quantity:'1',issuedAt:at(),costUnitPrice:null,pendingNote:'合成成本待核实273',actualConfirmed:true,reason:null,adjustmentIds:[]};const i=await call('/inventory/issues',issueBody,stock);ok(i);issue=i.json;});
 const preview=async()=>{const r=await call('/quality/preview',filter,manager);ok(r);return r.json;},view=async(kind:string)=>{const r=await call('/quality/'+problems[kind]+'/view',undefined,quality);ok(r,200);return r.json;},command=(d:any,extra:any={})=>({requestId:randomUUID(),version:Number(d.issue.row_version),sourceToken:d.source.token,kind:'recheck',role:null,note:'合成明确核对当前来源273',decision:'unresolved',blank:null,actualChecked:true,...extra});
 await check('三类扫描分级且不泄露临床正文，原请求重放不建重复问题',async()=>{const p=await preview();assert.equal(p.items.length,3);assert.equal(p.items.find((x:any)=>x.kind==='record').severity,'noncritical');assert.equal(p.items.find((x:any)=>x.kind==='expense').severity,'critical');assert.equal(JSON.stringify(p).includes('PRIVATE_'),false);const b={...filter,requestId:randomUUID(),token:p.token};ok(await call('/quality/scan',b,manager));for(let n=0;n<3;n++)ok(await call('/quality/scan',b,manager));for(const row of(await db.pool.query('SELECT issue_id,source_locator FROM adc.data_issue')).rows)problems[row.source_locator.split(':')[0]]=row.issue_id;assert.equal(Object.keys(problems).length,3);});
 await check('检查账号无原业务改写权，来源定位各由原岗位读取',async()=>{for(const[path,cookie]of[['/quarter/expenses/'+expense.id+'/source?clinicId='+east,finance],['/clinical/records/'+record.id+'/source?clinicId='+east,doctor],['/inventory/issues/'+issue.id+'/source?clinicId='+east,stock]]as const){ok(await call(path,undefined,quality),403);ok(await call(path,undefined,cookie),200);}ok(await call('/quarter/expenses',expenseBody,quality),403);ok(await call('/clinical/visits/'+visit.id+'/record',rec(1,true),quality),403);ok(await call('/inventory/issues',issueBody,quality),403);});
 await check('通知处理不关闭，未补正不能假复查为已补正',async()=>{for(const kind of ['expense','record','issue']){let d=await view(kind);ok(await call('/quality/'+problems[kind]+'/actions',command(d,{kind:'notify',decision:null,note:'合成已记录当面通知责任岗位，无真实消息'}),quality));d=await view(kind);ok(await call('/quality/'+problems[kind]+'/actions',command(d,{kind:'handle',decision:null,note:'合成跟踪待补，尚未改原业务'}),quality));d=await view(kind);assert.equal(d.issue.resolution_state,'open');ok(await call('/quality/'+problems[kind]+'/actions',command(d,{decision:'corrected'}),quality),409);old[kind]=d;}});
 async function checkChanged(kind:string){const d=await view(kind);assert.equal(d.issue.resolution_state,'open');assert.equal(d.source.version,2);assert.equal(d.source.missing,false);assert.equal(JSON.stringify(d).includes('PRIVATE_'),false);ok(await call('/quality/'+problems[kind]+'/actions',command(old[kind],{decision:'corrected'}),quality),409);}
 await check('财务原费用补凭据，不自动关闭且旧来源复查被拒',async()=>{ok(await call('/quarter/expenses',{...expenseBody,requestId:randomUUID(),id:expense.id,version:1,voucherReference:'SYNTHETIC-273#1',pendingNote:null,reason:'合成财务核实补齐凭据'},finance));await checkChanged('expense');});
 await check('原接诊医生补正文，不授权检查账号读取正文',async()=>{ok(await call('/clinical/visits/'+visit.id+'/record',rec(1,true),doctor));await checkChanged('record');});
 await check('库管原领用补成本2.5，不再扣量且原问题仍待复查',async()=>{const st=(await db.pool.query('SELECT quantity,row_version FROM adc.stock_balance WHERE stock_id=$1',[stockId])).rows[0];ok(await call('/inventory/issues',{...issueBody,requestId:randomUUID(),issueId:issue.id,version:1,stockVersion:Number(st.row_version),costUnitPrice:'2.5',pendingNote:null,reason:'合成核实原领用成本2.5'},stock));await checkChanged('issue');assert.equal((await db.pool.query('SELECT quantity FROM adc.stock_balance WHERE stock_id=$1',[stockId])).rows[0].quantity,'2.0000');});
 await check('检查人员重新读取当前源2再明确复查，三问题逐个关闭',async()=>{evidence.closed=[];for(const kind of ['expense','record','issue']){const d=await view(kind),b=command(d,{decision:'corrected'});ok(await call('/quality/'+problems[kind]+'/actions',b,quality));for(let n=0;n<3;n++)ok(await call('/quality/'+problems[kind]+'/actions',b,quality));const q=await view(kind);assert.equal(q.issue.resolution_state,'corrected');assert.equal(q.issue.rechecked_by,id('employee177-quality'));evidence.closed.push({kind,problemId:problems[kind],sourceVersion:q.source.version,state:q.issue.resolution_state});}});
 await check('稳定处理历史采用当前源2，同一复查重放只有一条',async()=>{evidence.history=[];for(const kind of ['expense','record','issue']){const d=await view(kind),h=await call('/quality/'+problems[kind]+'/history-page?'+new URLSearchParams({basis:d.basis,limit:'20'}),undefined,quality);ok(h,200);const actions=h.json.items.filter((x:any)=>x.action_kind==='recheck');assert.equal(actions.length,1);const basis=typeof actions[0].source_basis==='string'?JSON.parse(actions[0].source_basis):actions[0].source_basis;assert.equal(basis.source.version,2);assert.equal(JSON.stringify(h.json).includes('PRIVATE_'),false);evidence.history.push({kind,issueId:problems[kind],rechecks:actions.length,sourceVersion:basis.source.version});}});
 await check('重新扫描缺项清零，旧问题保留已补正历史不重开',async()=>{const p=await preview();assert.equal(p.items.length,0);const rows=(await db.pool.query('SELECT source_locator,resolution_state,rechecked_by FROM adc.data_issue ORDER BY source_locator')).rows;assert.equal(rows.length,3);assert.ok(rows.every(x=>x.resolution_state==='corrected'));evidence.finalIssues=rows;});
 await writeFile(join(root,'artifacts/quality-journey-check.json'),JSON.stringify({batch:273,checks:passed.length,passed,evidence,isolatedDatabase:name,http:{get:reads,post:writes},browserPerformed:false,realNotification:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));console.log('Quality journey checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);await admin.end();delete process.env.ADC_ISOLATED_SEED_REPORTS;await rm(folder,{recursive:true,force:true});}
