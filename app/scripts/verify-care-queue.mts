import pg from'pg';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{writeFile,rm}from'node:fs/promises';import{join,resolve,sep}from'node:path';import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{seedClinical}from'./seed-clinical.mts';import{seedCare}from'./seed-care.mts';import{fixtureId as id}from'./seed.mjs';import{databaseSnapshot}from'./snapshot-startup186.mjs';
const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_care_queue_test_'+Date.now(),folder=resolve(root,'.runtime',name);if(!/^adc_care_queue_test_\d+$/.test(name)||!folder.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe isolated DB');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_FILE_ROOT=folder;process.env.ADC_ISOLATED_SEED_REPORTS='true';process.env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});let app:any;const passed:string[]=[],check=async(n:string,f:()=>Promise<void>)=>{await f();passed.push(n);console.log('PASS',n);};
