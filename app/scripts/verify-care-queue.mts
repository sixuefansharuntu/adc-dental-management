 await check('当前店撤权和会话退出即时拒绝，不可借旧游标继续',async()=>{const fresh=(await query('',nurse,'%_')).json,g=(await db.pool.query('SELECT grant_id FROM adc.access_grant WHERE account_id=$1 ORDER BY effective_from DESC,version_no DESC LIMIT 1',[id('account171-nurse')])).rows[0].grant_id;assert.equal((await db.pool.query('DELETE FROM adc.grant_clinic WHERE grant_id=$1 AND clinic_id=$2',[g,east])).rowCount,1);ok(await query('',nurse,'%_'),403);ok(await call('/care/visits/'+roots[1].visit_id,undefined,nurse),403);ok(await call('/staff/logout',{},nurse));ok(await query('',nurse,'%_'),401);});
