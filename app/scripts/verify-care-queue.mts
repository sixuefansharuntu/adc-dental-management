 await check('混合影像医护岗位非参与只见影像，详情不被无权分支误拒',async()=>{const old=(await db.pool.query('SELECT * FROM adc.access_grant WHERE account_id=$1 ORDER BY effective_from DESC,version_no DESC LIMIT 1',[id('account171-lin')])).rows[0],g=randomUUID();await db.pool.query('INSERT INTO adc.access_grant(grant_id,account_id,version_no,effective_from,configured_by,configured_at) VALUES($1,$2,$3,clock_timestamp(),$4,clock_timestamp())',[g,old.account_id,Number(old.version_no)+1,lin]);await db.pool.query('INSERT INTO adc.grant_role VALUES($1,$2),($1,$3)',[g,id('rolev172-doctor'),id('rolev172-imaging')]);await db.pool.query('INSERT INTO adc.grant_clinic VALUES($1,$2)',[g,east]);await db.pool.query('INSERT INTO adc.grant_field SELECT gen_random_uuid(),$1,resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$2',[g,old.grant_id]);const r=await query('',doc);ok(r,200);assert.equal(r.json.total,253);const target=roots.find(x=>x.doctor_id===zhou),d=await call('/care/visits/'+target.visit_id,undefined,doc);ok(d,200);assert.equal(d.json.canImage,true);assert.equal(d.json.canLab,false);assert.deepEqual(d.json.labs,[]);assert.deepEqual(d.json.treatments,[]);});
