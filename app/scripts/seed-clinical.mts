import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedClinical(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const bootstrap=id('booking-bootstrap'),east=id('clinic-east'),river=id('clinic-river');
 async function put(table:string,data:Record<string,unknown>){const k=Object.keys(data);await c.query(`INSERT INTO adc.${table}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(data));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(171001)');
  const roles:any={doctor:['clinical.read','clinical.write','bill.read','bill.manage'],nurse:['clinical.read','bill.read','bill.manage'],cashier:['appointment.read','appointment.manage','schedule.manage','patient.identity','patient.create','visit.read','visit.manage','bill.read','receipt.create','price.manage']};
  for(const [name,functions]of Object.entries(roles)){const role=id('role171-'+name),rv=id('rolev171-'+name);await put('security_role',{role_id:role,name:'诊疗收费演示 '+name,row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'诊疗收费演示 '+name,configured_by:bootstrap,configured_at:new Date()});for(const fn of functions as string[])await put('role_function',{role_version_id:rv,function_code:fn});}
  for(const [key,login,secret,employee,clinic,role]of [['lin','doctor.lin',env.ADC_DOCTOR_LIN_PASSWORD,id('booking-lin'),east,'doctor'],['zhou','doctor.zhou',env.ADC_DOCTOR_ZHOU_PASSWORD,id('booking-zhou'),east,'doctor'],['river','doctor.river',env.ADC_DOCTOR_RIVER_PASSWORD,id('booking-chen'),river,'doctor'],['nurse','nurse.east',env.ADC_NURSE_EAST_PASSWORD,id('nurse-east-a'),east,'nurse']]){
   const account=id('account171-'+key);await put('staff_account',{account_id:account,employee_id:employee,login_name:login,credential_verifier:await credentialHash(secret!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:bootstrap,maintained_at:new Date(),row_version:1});
   const grant=id('grant171-'+key);await put('access_grant',{grant_id:grant,account_id:account,version_no:1,effective_from:'2026-10-01T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:id('rolev171-'+role)});await put('grant_clinic',{grant_id:grant,clinic_id:clinic});
   const fields=role==='doctor'?[['clinical','body'],['clinical','treatments'],['bill','lines']]:[['bill','lines']];for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(grant+r+f),grant_id:grant,resource_code:r,field_code:f,action_code:'maintain'});
  }
  for(const [key,clinic]of [['front-east',east],['front-river',river]]){const grant=id('grant171-'+key);await put('access_grant',{grant_id:grant,account_id:id('account-'+key),version_no:3,effective_from:'2026-10-20T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:id('rolev171-cashier')});await put('grant_clinic',{grant_id:grant,clinic_id:clinic});const fields=[['appointment','arrangement'],['appointment','contact'],['schedule','arrangement'],['patient','identity'],['visit','arrived_at'],['visit','started_at'],['visit','ended_at'],['visit','left_at'],['visit','arrangement'],['receipt','payment'],['price','amount']];for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(grant+r+f),grant_id:grant,resource_code:r,field_code:f,action_code:'maintain'});}
  for(const [key,name,unit,amount]of [['exam','口腔检查（示例）','次','50.0000'],['clean','洁治（示例）','次','180.0000'],['fill','充填治疗（示例）','颗','200.0000']]){
   const item=id('item171-'+key);await put('treatment_item',{item_id:item,name,charge_unit:unit,activation_arrangement:'enabled',row_version:1});
   for(const clinic of[east,river]){const pid=id(item+clinic),op=id('seed-'+pid);await put('business_operation',{operation_id:op,actor_id:bootstrap,occurred_at:new Date(),action_code:'seed.price',subject_kind:'item_price_version',subject_key:pid,after_content:JSON.stringify({amount,clinicId:clinic,synthetic:true})});await put('item_price_version',{price_version_id:pid,item_id:item,amount,effective_from:'2026-01-01T00:00:00Z',version_no:clinic===east?1:2,created_by:bootstrap,created_at:new Date(),operation_id:op});await put('item_price_clinic',{price_version_id:pid,clinic_id:clinic});}
  }
  await c.query('COMMIT');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}
 await writeFile(join(await seedReportDirectory(env),'诊疗演示账号.txt'),`ADC本机诊疗收费账号（全部合成，不要提交）\n入口：http://127.0.0.1:5173/\n\n林医生 doctor.lin：${env.ADC_DOCTOR_LIN_PASSWORD}\n周医生 doctor.zhou：${env.ADC_DOCTOR_ZHOU_PASSWORD}\n滨江医生 doctor.river：${env.ADC_DOCTOR_RIVER_PASSWORD}\n东城张护士 nurse.east：${env.ADC_NURSE_EAST_PASSWORD}\n\n前台仍使用“预约演示账号.txt”的front.east/front.river。前台不获病历正文或开费权，护士不能代写临床。无真实支付扣款。\n`,'utf8');console.log('Clinical synthetic accounts and prices ready; credentials saved privately.');
}
if(process.argv[1]?.endsWith('seed-clinical.mts'))seedClinical().catch(e=>{console.error(e.message);process.exitCode=1;});

