 await check('240原保存尚在途时GET不等待请求锁，提交与回滚后分别核实',async()=>{
  for(const rollback of[false,true]){
   const b=await body('profile',{contactInfo:rollback?'240-ROLLBACK':'240-IN-FLIGHT'},head),p=await inspect('profile',b,head);ok(p);const request={...b,requestId:randomUUID(),impactToken:p.json.impactToken,checked:true,confirmImpact:true};
   let enter:any,release:any;const ready=new Promise<void>(r=>enter=r),gate=new Promise<void>(r=>release=r);
   const save=s.save(headActor,lin,'profile',dentistInput(request,'profile',true),async()=>{enter();await gate;if(rollback)throw Error('240 rollback');}).then(r=>({r}),e=>({e}));
   await ready;try{const v=await Promise.race([commandStatus(request.requestId),new Promise<any>((_,reject)=>setTimeout(()=>reject(Error('240 status blocked')),2000))]);ok(v,200);assert.equal(v.json.state,'not_found');}finally{release();}
   const result:any=await save;if(rollback)assert.match(result.e.message,/240 rollback/);else assert.ok(result.r.version);
   assert.equal((await commandStatus(request.requestId)).json.state,rollback?'not_found':'completed');
  }
 });

