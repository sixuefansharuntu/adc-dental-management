await check('到账晚于首次登记的核实更正可留另版，首次时刻不被改成现在',async()=>{const c=await db.pool.connect(),b=await billFixture(),rid=randomUUID(),op=randomUUID(),first=new Date(Date.now()-60000),actual=new Date(Date.now()-120000);try{await c.query('BEGIN');await tx.insert(c,'business_operation',{operation_id:op,actor_id:id('booking-front-east'),occurred_at:first,action_code:'fixture.initial.receipt',subject_kind:'receipt',subject_key:rid,after_content:'{}'});await tx.insert(c,'receipt',{receipt_id:rid,bill_id:b.bill,sale_id:null,collector_id:id('booking-front-east'),amount:'50.00',payment_method:'cash',received_at:actual,registered_at:first,recording_reason:'隔离合成首次登记',row_version:1});await tx.snapshot(c,'receipt',rid,op);await c.query('COMMIT');}catch(e){await c.query('ROLLBACK');throw e;}finally{c.release();}ok(await call('/receipts/'+rid+'/correction',correction(1,{receivedAt:new Date(Date.now()-1000).toISOString()}),front));assert.equal((await get(rid)).item.registeredAt,first.toISOString());});
await check('实收查询与原版历史分页不丢项，前台看不到临床正文联系方式',async()=>{for(let i=0;i<52;i++){const b=await billFixture();ok(await collectBill(b,'2026-10-05T02:00:00Z'));}const a=await call('/receipts?clinicId='+east+'&date=2026-10-05&kind=all',undefined,front);ok(a,200);assert.equal(a.json.items.length,50);const b=await call('/receipts?clinicId='+east+'&date=2026-10-05&kind=all&after='+a.json.next,undefined,front);ok(b,200);assert.equal(new Set([...a.json.items,...b.json.items].map((x:any)=>x.id)).size,53);assert.equal(JSON.stringify(a.json).includes('13800000180'),false);for(let n=3;n<54;n++)ok(await call('/receipts/'+sid+'/correction',correction(n,{paymentMethod:n%2?'cash':'wechat',receivedAt:'2026-10-05T03:00:00Z'}),front));const h=await get(sid),tail=await call('/receipts/'+sid+'?beforeVersion='+h.nextVersion,undefined,front);ok(tail,200);assert.equal(h.history.length,50);assert.equal(new Set([...h.history,...tail.json.history].map((x:any)=>x.id)).size,54);});
await check('完整166的19项保护不改，仍116表866列',async()=>{const dir=join(root,'../output/pdf/ADC-完整设计基线166'),m=JSON.parse(await readFile(join(dir,'基线文件清单.json'),'utf8'));for(const[f,h]of Object.entries(m.files))assert.equal(createHash('sha256').update(await readFile(join(dir,f))).digest('hex'),h);assert.equal((await db.pool.query("SELECT count(*)::int n FROM information_schema.tables WHERE table_schema='adc' AND table_type='BASE TABLE'")).rows[0].n,116);assert.equal((await db.pool.query("SELECT count(*)::int n FROM information_schema.columns WHERE table_schema='adc'")).rows[0].n,866);});
await writeFile(join(root,'artifacts/receipts-check.json'),JSON.stringify({batch:180,checks:passed.length,passed,isolated:true,checkedAt:new Date().toISOString()},null,2));console.log('Receipt checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query(`DROP DATABASE "${name}" WITH (FORCE)`);await admin.end();}
