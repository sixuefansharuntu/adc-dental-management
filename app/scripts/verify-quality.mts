await check('来源未补不得假关闭、必需财务资料不得标合理空项',async()=>{const d=await detail();ok(await call('/quality/'+eidIssue+'/actions',command(d,{decision:'corrected'}),assist),409);ok(await call('/quality/'+eidIssue+'/actions',command(d,{decision:'justified_blank',blank:'不想填'}),assist),400);ok(await call('/quality/'+eidIssue+'/actions',command(d,{actualChecked:false}),assist),400);});
const before=await detail();ok(await call('/quarter/expenses',ex({id:eid,version:1,voucherReference:'DEMO-177-TEST#1',pendingNote:null,reason:'合成凭据补齐'}),fin));
await check('财务回原用例补正，旧问题读取基准不能关闭新来源',async()=>{ok(await call('/quality/'+eidIssue+'/actions',command(before,{decision:'corrected'}),assist),409);assert.equal((await detail()).source.version,2);});
await check('处理写入后故障回滚状态、复查人与历史',async()=>{const d=await detail(),a=await auth.staff({headers:{cookie:assist}}as any);await assert.rejects(()=>s.handle(a,eidIssue,command(d,{decision:'corrected'}),async()=>{throw Error('intentional handle');}),/intentional handle/);assert.equal((await detail()).issue.resolution_state,'open');});
await check('实际复查关闭、当前源版与操作依据留存，原重试不重复',async()=>{const d=await detail(),b=command(d,{decision:'corrected'});ok(await call('/quality/'+eidIssue+'/actions',b,assist));assert.equal((await call('/quality/'+eidIssue+'/actions',b,assist)).json.repeated,true);const x=await detail();assert.equal(x.issue.resolution_state,'corrected');assert.equal(x.issue.rechecked_by,id('employee177-quality'));const h=x.history.filter((x:any)=>x.action_kind==='recheck');assert.equal(h.length,1);assert.equal(JSON.parse(h[0].source_basis).source.version,2);});
await check('后来同一必需资料再缺，扫描重新打开原问题而不改旧复查历史',async()=>{ok(await call('/quarter/expenses',ex({id:eid,version:2,voucherReference:'DEMO-177-TEST#1',pendingNote:'新核查发现凭据待复核',reason:'合成资料再次待补'}),fin));pre=await preview();ok(await call('/quality/scan',{...filter,requestId:randomUUID(),token:pre.token},manager));const d=await detail();assert.equal(d.issue.resolution_state,'open');assert.equal(d.issue.rechecked_by,null);assert.ok(d.history.some((x:any)=>x.action_kind==='reopen'));assert.ok(d.history.some((x:any)=>x.action_kind==='recheck'));});
await check('医生回原用例补病历，管理检查仅核状态不泄露正文',async()=>{ok(await call('/clinical/visits/'+v.json.id+'/record',recordBody(1,true),doc));const d=await detail(ridIssue);assert.equal(d.source.missing,false);assert.equal(JSON.stringify(d).includes('PRIVATE-'),false);ok(await call('/quality/'+ridIssue+'/actions',command(d,{decision:'corrected'}),manager));});
let manualId:string;
await check('人工事项绑定真实本店本季来源，不能任意关联跨店',async()=>{const src=(await call('/quality/source?clinicId='+east+'&kind=expense&id='+eid,undefined,assist)).json,b={requestId:randomUUID(),clinicId:east,year:2026,quarter:4,kind:'expense',sourceId:eid,sourceToken:src.token,severity:'noncritical',role:'财务人员',note:'合成核查：凭据可选备注是否适用'};ok(await call('/quality/manual',{...b,quarter:3},assist),409);ok(await call('/quality/source?clinicId='+river+'&kind=expense&id='+eid,undefined,assist),403);const r=await call('/quality/manual',b,assist);ok(r);manualId=r.json.id;ok(await call('/quality/manual',{...b,requestId:randomUUID()},assist),409);});
await check('合理空项只处理有解释的人工事项，不补造数据',async()=>{const d=await detail(manualId);ok(await call('/quality/'+manualId+'/actions',command(d,{decision:'justified_blank',blank:'已核对凭据，补充备注为可选且本次不适用',note:'实际核实可选备注不适用'}),manager));assert.equal((await detail(manualId)).issue.resolution_state,'justified_blank');});
await check('问题版本并发冲突，失效扫描基准拒保存',async()=>{const d=await detail(),a=command(d,{kind:'handle',decision:null,note:'并发实际处理记录'}),rs=await Promise.all([call('/quality/'+eidIssue+'/actions',a,assist),call('/quality/'+eidIssue+'/actions',{...a,requestId:randomUUID()},manager)]);assert.deepEqual(rs.map(x=>x.status).sort(),[201,409]);const old=await preview();ok(await call('/quarter/expenses',ex({id:eid,version:3,voucherReference:'DEMO-177-TEST#1',pendingNote:null,reason:'合成再次核实'}),fin));ok(await call('/quality/scan',{...filter,requestId:randomUUID(),token:old.token},manager),409);});
await check('季度关键问题真实复查联动，不因普通处理直接通过',async()=>{const cand=(await call('/quarter/candidates?year=2026&quarter=4',undefined,fin)).json;const q=await call('/quarter',{requestId:randomUUID(),year:2026,quarter:4,scopes:cand.clinics.map((x:any)=>({clinicId:x.id,doctorIds:x.doctors.map((d:any)=>d.id)})),scopeConfirmed:true},fin);ok(q);let pr=(await call('/quarter/'+q.json.id+'/prepare?clinicId='+east,undefined,manager)).json;assert.ok(pr.blockers.some((b:string)=>b.includes('关键资料问题')));const d=await detail();ok(await call('/quality/'+eidIssue+'/actions',command(d,{decision:'corrected'}),assist));pr=(await call('/quarter/'+q.json.id+'/prepare?clinicId='+east,undefined,manager)).json;assert.deepEqual(pr.blockers,[]);});
await check('处理历史、来源身份及当前字段授权受保护',async()=>{await assert.rejects(()=>db.pool.query('DELETE FROM adc.issue_action WHERE issue_id=$1',[eidIssue]),/immutable/);await assert.rejects(()=>db.pool.query("UPDATE adc.data_issue SET source_locator='expense:'||gen_random_uuid()::text,row_version=row_version+1 WHERE issue_id=$1",[eidIssue]),/immutable/);await db.pool.query("DELETE FROM adc.grant_field WHERE grant_id=$1 AND resource_code='quality'",[id('grant177-quality')]);ok(await call('/quality/'+eidIssue+'/actions',command(await detail(),{kind:'handle',decision:null}),assist),403);});
await check('实际领用未知成本可定位，补价后原问题复查且库存数量不变',async()=>{const stock=await login('stock.east',env.ADC_STOCK_EAST_PASSWORD!),mat=await call('/inventory/materials',{requestId:randomUUID(),id:null,version:0,clinicId:east,name:'资料检查合成材料',classification:'材料',unit:'盒',specification:null,enabled:true,distinctConfirmed:false,reason:null},stock);ok(mat);const supplier=await call('/inventory/suppliers',{requestId:randomUUID(),id:null,version:0,clinicId:east,name:'资料检查合成供应商',contactInfo:null,cooperationInfo:'合成资料',pendingNote:'合成待核',enabled:true,distinctConfirmed:false,reason:null},manager);ok(supplier);const receipt=await call('/inventory/receipts',{requestId:randomUUID(),clinicId:east,materialId:mat.json.id,supplierId:supplier.json.id,batch:null,expiresOn:null,unit:'盒',quantity:'3.0000',receivedAt:new Date(Date.now()-5000).toISOString(),unitPrice:null,sourceReference:'DEMO-177-COST#1',batchNote:'合成材料',pendingNote:'合成待核价',actualConfirmed:true},stock);ok(receipt);const issueBody={requestId:randomUUID(),issueId:null,version:0,stockId:receipt.json.stockId,stockVersion:2,recipientId:id('nurse-east-a'),unit:'盒',quantity:'1.0000',issuedAt:new Date(Date.now()-1000).toISOString(),costUnitPrice:null,pendingNote:'合成成本待核实',actualConfirmed:true,reason:null};const issue=await call('/inventory/issues',issueBody,stock);ok(issue);const pp=await preview();assert.ok(pp.items.some((x:any)=>x.kind==='issue'));ok(await call('/quality/scan',{...filter,requestId:randomUUID(),token:pp.token},manager));const problem=(await db.pool.query("SELECT issue_id FROM adc.data_issue WHERE source_locator=$1",['issue:'+issue.json.id])).rows[0].issue_id;ok(await call('/inventory/issues',{...issueBody,requestId:randomUUID(),issueId:issue.json.id,version:1,stockVersion:3,costUnitPrice:'2.5000',pendingNote:'归属财务核实',reason:'合成补成本依据'},stock));const d=(await call('/quality/'+problem,undefined,manager)).json;assert.equal(d.source.missing,false);ok(await call('/quality/'+problem+'/actions',command(d,{decision:'corrected'}),manager));assert.equal((await db.pool.query('SELECT quantity FROM adc.stock_balance WHERE stock_id=$1',[receipt.json.stockId])).rows[0].quantity,'2.0000');});
await check('问题列表游标分页不丢项或重复',async()=>{const ids=Array.from({length:53},()=>randomUUID());for(const i of ids)await db.pool.query("INSERT INTO adc.data_issue(issue_id,clinic_id,period_note,source_locator,category,severity,responsible_role,resolution_state) VALUES($1,$2,'2025Q1',$3,'人工核查事项','noncritical','财务人员','open')",[i,east,'expense:'+randomUUID()]);const first=await call('/quality?clinicId='+east+'&year=2025&quarter=1',undefined,manager);ok(first,200);assert.equal(first.json.items.length,50);assert.ok(first.json.next);const second=await call('/quality?clinicId='+east+'&year=2025&quarter=1&after='+first.json.next,undefined,manager);ok(second,200);assert.equal(second.json.items.length,3);assert.equal(new Set([...first.json.items,...second.json.items].map(x=>x.issue_id)).size,53);assert.equal(second.json.next,null);});
await check('完整166的19项原件哈希保持',async()=>{const dir=join(root,'../output/pdf/ADC-完整设计基线166'),m=JSON.parse(await readFile(join(dir,'基线文件清单.json'),'utf8'));for(const[p,h]of Object.entries(m.files))assert.equal(createHash('sha256').update(await readFile(join(dir,p))).digest('hex'),h);});
await writeFile(join(root,'artifacts','quality-check.json'),JSON.stringify({batch:177,checks:passed.length,passed,isolatedDatabase:true,realNotification:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));console.log('Quality checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);await admin.end();}
