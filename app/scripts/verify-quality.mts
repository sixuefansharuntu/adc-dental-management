import pg from'pg';import{randomUUID,createHash}from'node:crypto';import{readFile,writeFile}from'node:fs/promises';import{join}from'node:path';import assert from'node:assert/strict';import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{seedClinical}from'./seed-clinical.mts';import{seedCare}from'./seed-care.mts';import{seedFollowup}from'./seed-followup.mts';import{seedInventory}from'./seed-inventory.mts';import{seedSales}from'./seed-sales.mts';import{seedQuarter}from'./seed-quarter.mts';import{seedQuality}from'./seed-quality.mts';import{fixtureId as id}from'./seed.mjs';
const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_quality_test_'+Date.now();if(!/^adc_quality_test_\d+$/.test(name))throw Error('Invalid test DB');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;let app:any;const passed:string[]=[];const ok=(r:any,s=201)=>assert.equal(r.status,s,JSON.stringify(r.json));async function check(n:string,f:()=>Promise<void>){await f();passed.push(n);console.log('PASS',n);}
try{await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts'),{QualityService}=await import('../apps/api/src/quality.service.ts'),{AuthService}=await import('../apps/api/src/auth.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),s=app.get(QualityService),auth=app.get(AuthService),east=id('clinic-east'),river=id('clinic-river');
async function call(path:string,body?:any,cookie='',origin=env.ADMIN_ORIGIN){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(cookie?{Cookie:cookie}:{}),...(body?{Origin:origin!}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}async function login(n:string,p:string){const r=await call('/staff/session',{loginName:n,password:p});ok(r);return r.cookie;}
const manager=await login('manager.east',env.ADC_MANAGER_EAST_PASSWORD!),assist=await login('quality.east',env.ADC_QUALITY_PASSWORD!),fin=await login('finance.hq',env.ADC_FINANCE_PASSWORD!),front=await login('front.east',env.ADC_STAFF_EAST_PASSWORD!),doc=await login('doctor.lin',env.ADC_DOCTOR_LIN_PASSWORD!),riverManager=await login('manager.river',env.ADC_MANAGER_RIVER_PASSWORD!);
const filter={clinicId:east,year:2026,quarter:4,kinds:['expense','issue','record']};
await check('未登录、普通前台财务、跨店和错误来源写入均拒绝',async()=>{ok(await call('/quality/bootstrap'),401);ok(await call('/quality?clinicId='+east+'&year=2026&quarter=4',undefined,fin),403);ok(await call('/quality/preview',filter,front),403);ok(await call('/quality/preview',filter,riverManager),403);ok(await call('/quality/preview',filter,manager,'http://bad.local'),403);});
const ex=(extra:any={})=>({requestId:randomUUID(),id:null,version:0,clinicId:east,category:'合成运营费用',amount:'30.00',occurredOn:'2026-10-24',voucherReference:null,voucherNote:'合成来源尚待核对',pendingNote:'凭据编号待补',actualConfirmed:true,distinctConfirmed:false,reason:null,...extra});const expense=await call('/quarter/expenses',ex(),fin);ok(expense);const eid=expense.json.id;
const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:east,name:'资料检查合成患者',phone:'13800000177',identityBasis:'仅本机合成'},front);ok(p);const at=new Date(Date.now()-4000).toISOString();const v=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:east,patientId:p.json.id,doctorId:id('booking-lin'),nurseIds:[id('nurse-east-a')],arrivedAt:at,basis:'合成到院',identityBasis:'本机核对',identityConfirmed:true,coordination:'已核实当前内部安排'},front);ok(v);
const recordBody=(version=0,complete=false)=>({requestId:randomUUID(),recordVersion:version,clinicalAt:v.json.arrivedAt,body:complete?'PRIVATE-BODY-177':null,pendingNote:complete?null:'PRIVATE-PENDING-177',completeness:complete?'complete':'pending',doctorConfirmed:true,treatments:[],reason:version?'合成实际补正':null});ok(await call('/clinical/visits/'+v.json.id+'/record',recordBody(),doc));
const preview=async()=>(await call('/quality/preview',filter,manager)).json;let pre=await preview();let eidIssue:string,ridIssue:string;
await check('费用关键和病历非关键分别发现，检查不返回临床正文或待补正文',async()=>{assert.equal(pre.items.length,2);assert.equal(pre.items.find((x:any)=>x.kind==='expense').severity,'critical');assert.equal(pre.items.find((x:any)=>x.kind==='record').severity,'noncritical');assert.equal(JSON.stringify(pre).includes('PRIVATE-'),false);});
await check('检查全写后故障完整回滚问题、历史与去重',async()=>{const a=await auth.staff({headers:{cookie:manager}}as any);await assert.rejects(()=>s.saveScan(a,{...filter,requestId:randomUUID(),token:pre.token},async()=>{throw Error('intentional scan');}),/intentional scan/);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.data_issue')).rows[0].n,0);});
await check('保存及并发重复扫描只一组问题，未解决问题不重复建',async()=>{const b={...filter,requestId:randomUUID(),token:pre.token};ok(await call('/quality/scan',b,manager));assert.equal((await call('/quality/scan',b,manager)).json.repeated,true);ok(await call('/quality/scan',{...b,requestId:randomUUID()},assist));const rows=(await call('/quality?clinicId='+east+'&year=2026&quarter=4',undefined,assist)).json.items;assert.equal(rows.length,2);eidIssue=rows.find((x:any)=>x.category==='费用凭据或待补').issue_id;ridIssue=rows.find((x:any)=>x.category==='病历待补').issue_id;});
const detail=async(id=eidIssue)=>(await call('/quality/'+id,undefined,assist)).json;const command=(d:any,extra:any={})=>({requestId:randomUUID(),version:Number(d.issue.row_version),sourceToken:d.source.token,kind:'recheck',role:null,note:'实际核对原来源的合成依据',decision:'unresolved',blank:null,actualChecked:true,...extra});
await check('协助前台只看元数据及留痕，不获得临床或费用改写权',async()=>{const d=await detail(ridIssue);assert.equal(JSON.stringify(d).includes('PRIVATE-'),false);ok(await call('/clinical/visits/'+v.json.id,undefined,assist),403);ok(await call('/quarter/expenses',ex(),assist),403);const logs=(await db.pool.query("SELECT access_scope FROM adc.business_operation WHERE action_code='quality.view' AND subject_key=$1",[ridIssue])).rows;assert.ok(logs.length);assert.equal(logs[0].access_scope.clinicalBody,false);});
