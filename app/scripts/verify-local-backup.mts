import assert from'node:assert/strict';import pg from'pg';import{randomUUID,createHash}from'node:crypto';import{readFile,writeFile,readdir,cp,rm,unlink,mkdir,lstat}from'node:fs/promises';import{join,resolve,sep}from'node:path';
import{root,config,pgOptions}from'./config.mjs';import{recoveryFixture}from'./booking-recovery-fixture.mts';import{createLocalBackup,verifyLocalBackup,loadLocalBackup,backupTools,fileDigest}from'./backup-local.mjs';import{databaseSnapshot}from'./snapshot-startup186.mjs';import{fixtureId}from'./seed.mjs';
const original=await config(),source=new pg.Client(pgOptions(original));await source.connect();let sourceAssets:any[];try{sourceAssets=(await source.query('SELECT storage_key,media_type,byte_size,content_digest FROM adc.file_asset ORDER BY storage_key')).rows;}finally{await source.end();}
const f=await recoveryFixture(),env={...f.env,PGDATABASE:f.testDb},base=resolve(root,'.runtime/backups'),beforeNames=new Set(await readdir(base).catch(()=>[])),passed:string[]=[],owned:string[]=[];
const check=async(name:string,fn:()=>Promise<void>)=>{await fn();passed.push(name);console.log('PASS',name);},sha=b=>createHash('sha256').update(b).digest('hex');
async function cloneBackup(b:any){const id='backup-'+new Date().toISOString().replace(/[-:.]/g,'')+'-'+randomUUID().slice(0,8),p=join(base,id);await cp(b.path,p,{recursive:true});owned.push(p);const m=JSON.parse(await readFile(join(p,'manifest.json'),'utf8'));m.id=id;await updateManifest(p,m);return{id,path:p,manifest:m};}
async function updateManifest(p:string,m:any){await writeFile(join(p,'manifest.json'),JSON.stringify(m,null,2));await writeFile(join(p,'manifest.sha256'),sha(await readFile(join(p,'manifest.json')))+'\n');}
async function restoreTargets(){return(await f.db.pool.query("SELECT datname FROM pg_database WHERE datname LIKE 'adc_restore_test_%' ORDER BY datname")).rows;}
try{
 for(const a of sourceAssets)await f.db.pool.query("INSERT INTO adc.file_asset(file_id,storage_key,media_type,byte_size,content_digest,created_by,created_at,lifecycle_state) VALUES($1,$2,$3,$4,$5,$6,clock_timestamp(),'prepared')",[randomUUID(),a.storage_key,a.media_type,a.byte_size,a.content_digest,fixtureId('booking-bootstrap')]);
 await f.db.pool.query("CREATE TABLE tech_probe.backup_fixture(id uuid PRIMARY KEY,note text,exact numeric(30,12),raw bytea,at timestamptz,optional text,parent_id uuid REFERENCES tech_probe.backup_fixture(id) DEFERRABLE INITIALLY DEFERRED)");const rootId=randomUUID();await f.db.pool.query("INSERT INTO tech_probe.backup_fixture VALUES($1,$2,$3,$4,'2030-10-28T01:02:03.123456+08:00',NULL,NULL)",[rootId,'中文、引号\"、换行\n与emoji🦷','123456789012345678.123456789012',Buffer.from([0,1,127,255])]);await f.db.pool.query('INSERT INTO tech_probe.backup_fixture(id,note,parent_id) VALUES($1,$2,$3)',[randomUUID(),'关联原行',rootId]);
 let b:any,m:any;
 await check('官方客户端及全部依赖文件哈希匹配',async()=>{const tools=await backupTools();assert.ok(tools.dump.endsWith('pg_dump.exe'));assert.ok(tools.restore.endsWith('pg_restore.exe'));});
 await check('完整备份发布并含全部用户表、结构、22迁移与私有附件',async()=>{b=await createLocalBackup({env});owned.push(b.path);m=(await loadLocalBackup(b.id)).manifest;assert.equal(m.migrations.length,22);assert.ok(Object.keys(m.tables).length>=124);assert.equal(m.assets.length,sourceAssets.length);assert.ok(m.tables['adc_auth.local_identity']);assert.ok(m.tables['adc.command_dedup']);assert.ok(m.tables['tech_probe.backup_fixture']);assert.ok(m.dump.size>10000);});
 await check('新随机临时目标标准恢复后所有结构、全表与附件完全一致',async()=>{const r=await verifyLocalBackup(b.id,{env});assert.equal(r.verified,true);assert.equal(r.tableCount,Object.keys(m.tables).length);assert.equal(r.assetCount,sourceAssets.length);assert.equal(r.filesRestoredVerified,true);assert.equal(r.originalDatabaseOverwritten,false);assert.equal((await f.db.pool.query('SELECT 1 FROM pg_database WHERE datname=$1',[r.temporaryDatabase])).rowCount,0);});
 await check('中文/emoji/换行/NULL/二进制/高精度数值与微秒原样恢复',async()=>{assert.equal(m.tables['tech_probe.backup_fixture'].rows,2);assert.equal((await f.db.pool.query('SELECT exact::text n FROM tech_probe.backup_fixture WHERE id=$1',[rootId])).rows[0].n,'123456789012345678.123456789012');assert.ok((await verifyLocalBackup(b.id,{env})).schemaVerified);});
 await check('在线源变化不混入已导出快照，恢复的是备份时点',async()=>{const first=m.tables['tech_probe.backup_fixture'];const next=await createLocalBackup({env,afterSnapshot:async()=>{await f.db.pool.query('INSERT INTO tech_probe.backup_fixture(id,note) VALUES($1,$2)',[randomUUID(),'快照之后新增']);}});owned.push(next.path);const n=(await loadLocalBackup(next.id)).manifest;assert.deepEqual(n.tables['tech_probe.backup_fixture'],first);assert.equal((await databaseSnapshot(env))['tech_probe.backup_fixture'].rows,3);assert.equal((await verifyLocalBackup(next.id,{env})).verified,true);});
 await check('备份及恢复演练不修改原测试业务、账号、权限或私有文件',async()=>{const before=await databaseSnapshot(env),files=await Promise.all(sourceAssets.map(a=>fileDigest(join(root,'.runtime/private-files',a.storage_key))));await verifyLocalBackup(b.id,{env});assert.deepEqual(await databaseSnapshot(env),before);assert.deepEqual(await Promise.all(sourceAssets.map(a=>fileDigest(join(root,'.runtime/private-files',a.storage_key)))),files);});
 await check('拒绝外部地址及配置源库作为恢复ID，不执行覆写',async()=>{const before=await restoreTargets();await assert.rejects(()=>verifyLocalBackup(env.PGDATABASE,{env}),/备份ID/);await assert.rejects(()=>createLocalBackup({env:{...env,PGHOST:'remote.invalid'}}),/本机/);assert.deepEqual(await restoreTargets(),before);});
 await check('损坏清单SHA拒绝且不会创建恢复数据库',async()=>{const x=await cloneBackup(b),before=await restoreTargets();await writeFile(join(x.path,'manifest.json'),'{}');await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/摘要/);assert.deepEqual(await restoreTargets(),before);});
 await check('篡改数据库包摘要拒绝，不创建恢复目标',async()=>{const x=await cloneBackup(b),before=await restoreTargets();await writeFile(join(x.path,'database.dump'),'corrupted');await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/摘要/);assert.deepEqual(await restoreTargets(),before);});
 await check('备份引用附件缺失或内容变化都拒绝成功',async()=>{assert.ok(m.assets.length>0);const x=await cloneBackup(b),a=m.assets[0];await unlink(join(x.path,'private-files',a.key));await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/ENOENT/);await writeFile(join(x.path,'private-files',a.key),'changed');await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/摘要/);});
 await check('把文件换成目录会拒绝，不顺路径读取额外数据',async()=>{const x=await cloneBackup(b),a=m.assets[0],p=join(x.path,'private-files',a.key);await unlink(p);await mkdir(p);await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/实际文件/);});
 await check('清单声明高版本/重复附件/错表摘要不能成为恢复成功',async()=>{const x=await cloneBackup(b);x.manifest.server.major=18;await updateManifest(x.path,x.manifest);await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/版本/);x.manifest.server.major=17;x.manifest.assets.push(x.manifest.assets[0]);await updateManifest(x.path,x.manifest);await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/重复/);x.manifest.assets.pop();x.manifest.tables['tech_probe.backup_fixture'].sha256='0'.repeat(64);await updateManifest(x.path,x.manifest);const before=await restoreTargets();await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/不一致/);assert.deepEqual(await restoreTargets(),before);});
 await check('数据库包截断即使重写校验也恢复失败，所创临时目标会清理',async()=>{const x=await cloneBackup(b),bytes=await readFile(join(x.path,'database.dump'));await writeFile(join(x.path,'database.dump'),bytes.subarray(0,bytes.length-100));x.manifest.dump=await fileDigest(join(x.path,'database.dump'));await updateManifest(x.path,x.manifest);const before=await restoreTargets();await assert.rejects(()=>verifyLocalBackup(x.id,{env}),/失败|不一致/);assert.deepEqual(await restoreTargets(),before);});
 await check('备份中不包含.env、口令说明或工具安装包',async()=>{const list=(await readdir(b.path)).sort();assert.deepEqual(list,['database.dump','manifest.json','manifest.sha256','private-files']);assert.equal((await readdir(join(b.path,'private-files'))).length,sourceAssets.length);});
 await check('应用迁移漂移时拒绝发布备份，不改工程迁移',async()=>{const row=(await f.db.pool.query('SELECT name,sha256 FROM adc_meta.migration ORDER BY name LIMIT 1')).rows[0];await f.db.pool.query('UPDATE adc_meta.migration SET sha256=$2 WHERE name=$1',[row.name,'0'.repeat(64)]);try{await assert.rejects(()=>createLocalBackup({env}),/迁移/);}finally{await f.db.pool.query('UPDATE adc_meta.migration SET sha256=$2 WHERE name=$1',[row.name,row.sha256]);}});
 await check('源引用附件不存在则留待核查中间目录，不发布完整ID',async()=>{await f.db.pool.query("INSERT INTO adc.file_asset(file_id,storage_key,media_type,byte_size,content_digest,created_by,created_at,lifecycle_state) VALUES($1,$2,'image/png',3,$3,$4,clock_timestamp(),'prepared')",[randomUUID(),randomUUID()+'.bin','a'.repeat(64),fixtureId('booking-bootstrap')]);const before=new Set(await readdir(base));await assert.rejects(()=>createLocalBackup({env}),/ENOENT/);const added=(await readdir(base)).filter(n=>!before.has(n));assert.equal(added.length,1);assert.ok(added[0].startsWith('.pending-backup-'));});
 await writeFile(join(root,'artifacts/local-backup-check.json'),JSON.stringify({batch:203,checks:passed.length,passed,sourcePrivateFilesReadOnly:true,developmentBusinessWrites:false,temporaryDatabasesRemoved:true,checkedAt:new Date().toISOString()},null,2));console.log('Local backup checks passed:',passed.length);
}finally{
 await f.close();for(const n of await readdir(base).catch(()=>[]))if(!beforeNames.has(n)){const p=resolve(base,n);if(!p.startsWith(base+sep)||!/^\.?[a-z0-9TZ.-]+$/.test(n))throw Error('Unsafe owned backup cleanup');await rm(p,{recursive:true,force:true});}
}
