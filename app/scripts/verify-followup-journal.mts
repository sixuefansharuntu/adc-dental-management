 await check('历史不带临床正文和患者联系方式，登记与实际时点分开',async()=>{const r=await journal({eventType:'contact'});ok(r,200);for(const text of['13800000193','临床正文193不可出现在随访经过','contactPreference','requestId'])assert.equal(JSON.stringify(r.json).includes(text),false,text);assert.ok(r.json.items.every((x:any)=>x.savedAt&&x.contact.contactedAt));assert.ok(r.json.items.every((x:any)=>x.contact.reached===false||x.contact.reached===true));assert.equal(r.json.referenceNamesAreCurrent,true);});
 await check('办理经过多页完整且自身查询不会成为新办理',async()=>{let r=await journal(),all:any[]=[];ok(r,200);const total=r.json.total;for(;;){all.push(...r.json.items);if(!r.json.nextCursor)break;r=await journal({cursor:r.json.nextCursor});ok(r,200);assert.equal(r.json.total,total);}assert.equal(all.length,total);assert.equal(new Set(all.map(x=>x.id)).size,total);const again=await journal();ok(again,200);assert.equal(again.json.total,total);assert.ok(all.every(x=>['arrangement','contact','issue'].includes(x.type)));});
