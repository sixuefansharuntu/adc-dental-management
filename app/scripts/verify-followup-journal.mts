 const early=new Date(Date.now()-2000).toISOString(),late=new Date(Date.now()-1000).toISOString();const contacts:string[]=[];for(let n=0;n<61;n++){const d=await read(),r=await call(path+'/contacts',{requestId:randomUUID(),version:d.version,contactedAt:n<11?early:late,channel:'phone',reached:n<11,feedback:'隔离当次联系193-'+n,nextAction:'联系后安排193-'+n,problems:n<11?Array.from({length:5},(_,k)=>({problem:'隔离专业问题193-'+n+'-'+k,doctorId:id('booking-lin')})):[]},nurse);ok(r);contacts.push(r.json.contactId);}
