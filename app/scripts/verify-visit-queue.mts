 async function fixture(overrides:any={},nurses=[id('nurse-east-a')]){
  const c=await db.pool.connect(),row={...source,visit_id:randomUUID(),...overrides};
  try{await c.query('BEGIN');await c.query('INSERT INTO adc.visit SELECT * FROM jsonb_populate_record(NULL::adc.visit,$1::jsonb)',[JSON.stringify(row)]);for(const nurse of nurses)await c.query('INSERT INTO adc.visit_nurse(visit_id,nurse_id) VALUES($1,$2)',[row.visit_id,nurse]);await c.query('COMMIT');return row;}catch(e){await c.query('ROLLBACK');throw e;}finally{c.release();}
 }
 const roots:any[]=[];
