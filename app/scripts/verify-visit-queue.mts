import pg from'pg';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{writeFile,rm}from'node:fs/promises';import{join,resolve,sep}from'node:path';import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{fixtureId as id}from'./seed.mjs';
const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_visit_queue_test_'+Date.now(),folder=resolve(root,'.runtime',name);if(!/^adc_visit_queue_test_\d+$/.test(name)||!folder.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe isolation');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_ISOLATED_SEED_REPORTS='true';process.env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});let app:any;const passed:string[]=[],check=async(n:string,f:()=>Promise<void>)=>{await f();passed.push(n);console.log('PASS',n);};
try{
 await migrate();await seedBooking();await seedFrontdesk();const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),east=id('clinic-east'),river=id('clinic-river'),date=process.env.BOOKING_DEMO_DATE!,lin=id('booking-lin'),zhou=id('booking-zhou');
 async function call(path:string,body?:any,cookie=''){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(cookie?{Cookie:cookie}:{}),...(body?{Origin:env.ADMIN_ORIGIN!}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function login(n:string,p:string){const r=await call('/staff/session',{loginName:n,password:p});ok(r);return r.cookie;}
 const front=await login('front.east',env.ADC_STAFF_EAST_PASSWORD!),west=await login('front.river',env.ADC_STAFF_RIVER_PASSWORD!),none=await login('staff.none',env.ADC_STAFF_NONE_PASSWORD!);const patient=(await call('/patient/session',{loginName:'alice',password:env.ADC_PATIENT_A_PASSWORD})).cookie;

 const query=(q='',extra='',cookie=front,day=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),clinic=east)=>call('/frontdesk/visits?date='+day+'&clinicId='+clinic+'&q='+encodeURIComponent(q)+extra,undefined,cookie);
