 await check('未登录/患者/无权限/外店与伪造诊所均拒绝接诊列表',async()=>{ok(await query('','',''),401);ok(await query('','',patient),401);ok(await query('','',none),403);ok(await query('','',west),403);ok(await query('','',front,today,river),403);});
 await check('日期医生状态页数多值控制字符和未知字段严格拒绝',async()=>{for(const extra of['&date=bad','&doctorId=bad','&state=active','&state=all&state=left','&limit=0','&limit=51','&limit=1e2','&limit=1&limit=2','&cursor=','&unknown=x'])ok(await query('接诊分页',extra),400);ok(await query('a\nb'),400);ok(await query('x'.repeat(101)),400);ok(await query('接诊分页','&cursor=forged'),409);});
 let first:any;
 await check('253同到院时点按固定ID分6页无重复遗漏且读时点一致',async()=>{const r=await query('接诊分页');ok(r,200);first=r.json;assert.equal(first.total,253);let cursor=first.nextCursor,all=[...first.items],pages=1;while(cursor){const n=await query('接诊分页','&cursor='+encodeURIComponent(cursor));ok(n,200);assert.equal(n.json.asOf,first.asOf);all.push(...n.json.items);cursor=n.json.nextCursor;pages++;}assert.equal(pages,6);assert.equal(all.length,253);assert.equal(new Set(all.map(x=>x.id)).size,253);assert.deepEqual(all.map(x=>x.id),all.map(x=>x.id).sort());});
 await check('四类统计互斥覆盖全范围，进展筛选及小页不缩统计',async()=>{assert.deepEqual(first.summary,{total:253,waiting:64,inProgress:63,ended:63,left:63});for(const[state,count]of[['waiting',64],['in_progress',63],['ended',63],['left',63]]){const r=await query('接诊分页','&state='+state+'&limit=10');ok(r,200);assert.equal(r.json.total,count);assert.equal(r.json.items.length,10);assert.deepEqual(r.json.summary,first.summary);assert.ok(r.json.items.every((x:any)=>x.state===state));}});
 await check('患者姓名与医生交集保持同患者多次接诊，不按患者去重',async()=>{const r=await query('接诊分页','&doctorId='+lin);ok(r,200);assert.equal(r.json.total,127);assert.ok(r.json.items.every((x:any)=>x.patientId===patientId&&x.doctorId===lin));});
 await check('状态空结果仍保完整范围四类统计',async()=>{const unique=await patientOf('只有待接诊198');await fixture({patient_id:unique});const r=await query('只有待接诊','&state=ended');ok(r,200);assert.equal(r.json.total,0);assert.equal(r.json.items.length,0);assert.deepEqual(r.json.summary,{total:1,waiting:1,inProgress:0,ended:0,left:0});});
 await check('续页绑定姓名医生进展页数日期账号诊所且拒伪造转借',async()=>{const cursor=encodeURIComponent(first.nextCursor);for(const extra of['&state=left&cursor='+cursor,'&doctorId='+lin+'&cursor='+cursor,'&limit=10&cursor='+cursor])ok(await query('接诊分页',extra),409);ok(await query('其他','&cursor='+cursor),409);ok(await query('接诊分页','&cursor='+cursor,front,date),409);ok(await query('接诊分页','&cursor='+cursor,west,today,river),409);ok(await query('接诊分页','&cursor='+encodeURIComponent(first.nextCursor+'x')),409);});
 await check('提前离开可无开始结束，不造治疗事实也不重开',async()=>{const unique=await patientOf('提前离开198'),r=await call('/frontdesk/visits',{...arrival,requestId:randomUUID(),patientId:unique},front);ok(r);ok(await call('/frontdesk/visits/'+r.json.id+'/progress',{requestId:randomUUID(),version:1,field:'left_at',occurredAt:r.json.arrivedAt,basis:'隔离本人现场离开198'},front));const list=await query('提前离开','&state=left');ok(list,200);assert.equal(list.json.total,1);assert.equal(list.json.items[0].startedAt,null);assert.equal(list.json.items[0].endedAt,null);assert.ok(list.json.items[0].leftAt);assert.deepEqual(list.json.summary,{total:1,waiting:0,inProgress:0,ended:0,left:1});});
 await check('原前台登记开始结束使旧续页失效，原版及护士保持',async()=>{ok(await call('/frontdesk/visits/'+created.json.id+'/progress',{requestId:randomUUID(),version:1,field:'ended_at',occurredAt:created.json.arrivedAt,basis:'没有开始不应结束198'},front),409);const r=await call('/frontdesk/visits/'+created.json.id+'/progress',{requestId:randomUUID(),version:1,field:'started_at',occurredAt:created.json.arrivedAt,basis:'据医护反馈真实开始198'},front);ok(r);ok(await query('接诊分页','&cursor='+encodeURIComponent(first.nextCursor)),409);const e=await call('/frontdesk/visits/'+created.json.id+'/progress',{requestId:randomUUID(),version:2,field:'ended_at',occurredAt:created.json.arrivedAt,basis:'据医护反馈本次接诊结束198'},front);ok(e);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.visit_revision WHERE visit_id=$1',[created.json.id])).rows[0].n,3);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.visit_nurse WHERE visit_id=$1',[created.json.id])).rows[0].n,1);});
 await check('护士参与集合变化不与旧分页混合，即使根版本未变',async()=>{const r=await query('接诊分页');ok(r,200);await db.pool.query('INSERT INTO adc.visit_nurse(visit_id,nurse_id) VALUES($1,$2)',[roots[0].visit_id,id('nurse-east-b')]);ok(await query('接诊分页','&cursor='+encodeURIComponent(r.json.nextCursor)),409);const all=await query('接诊分页','&limit=50');ok(all,200);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.visit_nurse WHERE visit_id=$1',[roots[0].visit_id])).rows[0].n,2);});
 await check('新到院使原目录续页失效，重新查询包含新总数',async()=>{const r=await query('接诊分页');ok(r,200);await fixture();ok(await query('接诊分页','&cursor='+encodeURIComponent(r.json.nextCursor)),409);assert.equal((await query('接诊分页')).json.total,254);});
 await check('实际到院上海日含午夜两端，与预约日期无关',async()=>{const unique=await patientOf('午夜接诊198'),a=await fixture({patient_id:unique,arrived_at:date+'T00:00:00+08:00'}),b=await fixture({patient_id:unique,arrived_at:date+'T23:59:59.999999+08:00'});await fixture({patient_id:unique,arrived_at:new Date(Date.parse(date+'T00:00:00+08:00')-1).toISOString()});const r=await query('午夜接诊','',front,date);ok(r,200);assert.equal(r.json.total,2);assert.deepEqual(new Set(r.json.items.map((x:any)=>x.id)),new Set([a.visit_id,b.visit_id]));});
 await check('百分号下划线反斜杠字面匹配，列表不带电话病历过敏费用',async()=>{const unique=await patientOf('字面%_\\198');await fixture({patient_id:unique});const r=await query('%_\\');ok(r,200);assert.equal(r.json.total,1);const row=r.json.items[0];for(const key of['phone','contact','birthDate','allergies','body','clinicalBody','amount','sort_key'])assert.equal(key in row,false,key);});
 await check('5000完整可读5001明确拒绝，医生条件可缩小范围',async()=>{const unique=await patientOf('大范围接诊198');await db.pool.query("WITH ins AS(INSERT INTO adc.visit SELECT (jsonb_populate_record(NULL::adc.visit,$1::jsonb||jsonb_build_object('visit_id',gen_random_uuid(),'patient_id',$2::uuid))).* FROM generate_series(1,5000) RETURNING visit_id) INSERT INTO adc.visit_nurse SELECT visit_id,$3::uuid FROM ins",[JSON.stringify(source),unique,id('nurse-east-a')]);const r=await query('大范围接诊');ok(r,200);assert.equal(r.json.summary.total,5000);assert.equal(r.json.items.length,50);await fixture({patient_id:unique,doctor_id:zhou});ok(await query('大范围接诊'),409);const narrow=await query('大范围接诊','&doctorId='+zhou);ok(narrow,200);assert.equal(narrow.json.total,1);});
 await check('预约游标与接诊游标不可互换',async()=>{ok(await call('/frontdesk/appointments?date='+today+'&clinicId='+east+'&cursor='+encodeURIComponent((await query('接诊分页')).json.nextCursor),undefined,front),409);});
 await check('审计仅实际供阅就诊ID与条件摘要，不复制姓名正文依据',async()=>{const r=await query('接诊分页','&limit=10');ok(r,200);const log=(await db.pool.query("SELECT access_scope FROM adc.business_operation WHERE action_code='frontdesk.visits.list' ORDER BY occurred_at DESC LIMIT 1")).rows[0].access_scope;assert.deepEqual(log.visitIds,r.json.items.map((x:any)=>x.id));assert.equal(log.visitIds.length,10);for(const key of['q','name','patientName','phone','basis','body'])assert.equal(key in log,false);});
 await check('多次读取不修改任何业务/权限/原版/去重，仅记读审计',async()=>{const snap=async()=>{const x:any={};for(const t of['visit','visit_nurse','visit_revision','visit_revision_nurse','appointment','patient','receipt','stock_balance','access_grant','grant_clinic','command_dedup'])x[t]=(await db.pool.query('SELECT to_jsonb(t)::text data FROM adc.'+t+' t ORDER BY data')).rows;return x;};const before=await snap();await query('接诊分页');await query('接诊分页','&state=left');assert.deepEqual(await snap(),before);});
 await check('当前撤权后原接诊续页和新查询均拒绝',async()=>{const cursor=(await query('接诊分页')).json.nextCursor;assert.equal((await db.pool.query('DELETE FROM adc.grant_clinic WHERE grant_id=$1 AND clinic_id=$2',[id('grant-frontdesk-front-east'),east])).rowCount,1);ok(await query('接诊分页','&cursor='+encodeURIComponent(cursor)),403);ok(await query(),403);});
 await check('退出原会话后拒绝读取，不复用旧接诊授权',async()=>{ok(await call('/staff/logout',{},front));ok(await query(),401);});
 await writeFile(join(root,'artifacts/visit-queue-check.json'),JSON.stringify({batch:198,checks:passed.length,passed,isolatedDatabase:true,developmentBusinessWrites:false,newPermissions:false,checkedAt:new Date().toISOString()},null,2));console.log('Visit queue checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query('DROP DATABASE "'+name+'"');await admin.end();if(resolve(folder)===resolve(root,'.runtime',name)&&/^adc_visit_queue_test_\d+$/.test(name))await rm(folder,{recursive:true,force:true});}
