const env=await config();env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});Object.assign(process.env,env);
const original=env.PGDATABASE,name='adc_closed_quarter_journey_test_'+Date.now(),folder=resolve(root,'.runtime',name);if(!/^adc_closed_quarter_journey_test_\d+$/.test(name)||!folder.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe isolated target');
const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_ISOLATED_SEED_REPORTS='true';
let app:any;const passed:string[]=[],evidence:any={};let reads=0,writes=0;const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function check(label:string,f:()=>Promise<void>){await f();passed.push(label);console.log('PASS',label);}
try{
 await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();await seedBusiness();
 const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),east=id('clinic-east'),lin=id('booking-lin'),nurseId=id('nurse-east-a');
 async function call(path:string,body?:any,cookie=''){body?writes++:reads++;const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:env.ADMIN_ORIGIN}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 async function login(kind:string,loginName:string,password:string){const r=await call('/'+kind+'/session',{loginName,password});ok(r);return r.cookie;}
 const finance=await login('staff','finance.hq',env.ADC_FINANCE_PASSWORD!),head=await login('staff','review.hq',env.ADC_REVIEW_PASSWORD!),manager=await login('staff','manager.east',env.ADC_MANAGER_EAST_PASSWORD!),managerR=await login('staff','manager.river',env.ADC_MANAGER_RIVER_PASSWORD!),front=await login('staff','front.east',env.ADC_STAFF_EAST_PASSWORD!);const river=id('clinic-river'),day=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),currentQuarter=Math.floor((Number(day.slice(5,7))-1)/3)+1,year=Number(day.slice(0,4))-(currentQuarter===1?1:0),quarter=currentQuarter===1?4:currentQuarter-1,occurredOn=year+'-'+String((quarter-1)*3+2).padStart(2,'0')+'-15';let qid:string,eastExpense:any,original:any,oldPlan:string,firstTime:string,round:string,result2:string,result3:string,oldResult:string;
 const expenseBody=(extra:any={})=>({requestId:randomUUID(),id:null,version:0,clinicId:east,category:'合成季度运营费用274',amount:'30.00',occurredOn,voucherReference:'SYNTHETIC-274-EAST#1',voucherNote:'合成已核实凭据，不发生真实支付',pendingNote:null,actualConfirmed:true,distinctConfirmed:false,reason:null,...extra});
 async function submission(clinicId:string,cookie:string,adj?:string){const p=await call('/quarter/'+qid+'/prepare?clinicId='+clinicId,undefined,cookie);ok(p,200);assert.deepEqual(p.json.blockers,[]);const b={requestId:randomUUID(),clinicId,sourceToken:p.json.token,completenessConfirmed:true,emptyConfirmed:p.json.sources.length===0,evidence:'合成逐笔核实本店完整来源274',note:null,...(adj?{adjustmentId:adj}:{})};const r=await call('/quarter/'+qid+'/submissions',b,cookie);ok(r);for(let n=0;n<3;n++)ok(await call('/quarter/'+qid+'/submissions',b,cookie));}
 async function calc(adj?:string,reason:string|null=null){const b=await call('/quarter/'+qid+'/basis',undefined,finance);ok(b,200);assert.deepEqual(b.json.blockers,[]);const x={basisToken:b.json.token,policyId:id('policy176-core'),allocations:b.json.sources.map((s:any)=>({kind:s.kind,sourceId:s.id,doctorId:s.clinicId===east?lin:id('booking-chen'),amount:s.amount,basis:'合成逐笔核实各本店费用归属，非自动均分'})),...(adj?{adjustmentId:adj}:{})},p=await call('/quarter/'+qid+'/preview',x,finance);ok(p);const cmd={...x,requestId:randomUUID(),previewToken:p.json.token,reason},r=await call('/quarter/'+qid+'/results',cmd,finance);ok(r);for(let n=0;n<3;n++)ok(await call('/quarter/'+qid+'/results',cmd,finance));return r.json.resultId;}
 async function detail(rid:string){const r=await call('/quarter/results/'+rid,undefined,head);ok(r,200);return r.json;}
 async function reviewCommand(rid:string,decision='confirm'){const d=await detail(rid);return{requestId:randomUUID(),reviewToken:d.reviewToken,decision,opinion:'合成逐项核对两店原范围和全部采用来源274',explicitDecision:true};}
 const opening=()=>({requestId:randomUUID(),baseResultId:oldResult,reason:'合成核实原费用和漏登来源，按完整原范围另版调整274',explicitDecision:true});
 await check('最近已结束季度两店均有明确费用，范围固定两店三名牙医',async()=>{const e=await call('/quarter/expenses',expenseBody(),finance);ok(e);eastExpense=e.json;ok(await call('/quarter/expenses',expenseBody({clinicId:river,amount:'20.00',voucherReference:'SYNTHETIC-274-RIVER#1'}),finance));const c=await call('/quarter/candidates?year='+year+'&quarter='+quarter,undefined,finance);ok(c,200);assert.equal(c.json.clinics.length,2);const q=await call('/quarter',{requestId:randomUUID(),year,quarter,scopes:c.json.clinics.map((s:any)=>({clinicId:s.id,doctorIds:s.doctors.map((d:any)=>d.id)})),scopeConfirmed:true},finance);ok(q);qid=q.json.id;evidence.period={year,quarter,qid};});
 await check('只提交东城仍阻核算，不能漏掉滨江原范围',async()=>{await submission(east,manager);const b=await call('/quarter/'+qid+'/basis',undefined,finance);ok(b,200);assert.ok(b.json.blockers.some((s:string)=>s.includes('滨江')));await submission(river,managerR);});
 await check('财务完整核算费用50，三名牙医全部保留',async()=>{oldResult=await calc();const d=await detail(oldResult);assert.equal(d.plan.lines.length,3);assert.equal(d.plan.lines.reduce((n:number,l:any)=>n+Number(l.expense),0),50);assert.equal(d.plan.lines.find((l:any)=>l.doctorId===lin).expense,'30.00');assert.equal(d.plan.lines.find((l:any)=>l.doctorId===id('booking-chen')).expense,'20.00');assert.equal(d.result.review_state,'pending_review');oldPlan=JSON.stringify(d.plan);evidence.initialExpense='50.00';});
 await check('财务不能代总部确认，总部明确确认后首次时刻建立且只一条复核',async()=>{const b=await reviewCommand(oldResult);ok(await call('/quarter/results/'+oldResult+'/review',b,finance),403);ok(await call('/quarter/results/'+oldResult+'/review',b,head));for(let n=0;n<3;n++)ok(await call('/quarter/results/'+oldResult+'/review',b,head));const d=await call('/quarter/'+qid,undefined,head);ok(d,200);original=d.json;firstTime=d.json.quarter.first_full_confirmed_at;assert.ok(firstTime);assert.equal(d.json.doctors.length,3);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.result_review WHERE result_id=$1',[oldResult])).rows[0].n,1);});
 await check('已确认季度费用不能从普通入口直接覆盖或补录',async()=>{ok(await call('/quarter/expenses',expenseBody({id:eastExpense.id,version:1,amount:'40.00',reason:'合成更正但缺调整轮次'}),finance),409);ok(await call('/quarter/expenses',expenseBody({amount:'5.00',voucherReference:'SYNTHETIC-274-LATE#1',reason:'合成晚录但缺轮次'}),finance),409);});
 await check('只有总部可开调整轮次，原请求重放只一轮',async()=>{const b=opening();ok(await call('/quarter/'+qid+'/adjustment',b,finance),403);ok(await call('/quarter/'+qid+'/adjustment',b,front),403);const r=await call('/quarter/'+qid+'/adjustment',b,head);ok(r);round=r.json.adjustmentId;for(let n=0;n<3;n++)ok(await call('/quarter/'+qid+'/adjustment',b,head));ok(await call('/quarter/'+qid+'/adjustment',opening(),head),409);});
 await check('指定调整轮次更正东城费用40，原确认版50不被当前值覆盖',async()=>{ok(await call('/quarter/expenses',expenseBody({id:eastExpense.id,version:1,amount:'40.00',reason:'合成核实原凭据实际40',adjustmentIds:[round]}),finance));assert.equal(JSON.stringify((await detail(oldResult)).plan),oldPlan);});
 await check('调整需两店都重提，未变化滨江不能复用首次提交',async()=>{await submission(east,manager,round);const b=await call('/quarter/'+qid+'/basis',undefined,finance);ok(b,200);assert.ok(b.json.blockers.some((s:string)=>s.includes('滨江')));await submission(river,managerR,round);result2=await calc(round,'合成东城40加滨江20，整批另版60');const d=await detail(result2);assert.equal(d.result.previous_result_id,oldResult);assert.equal(d.plan.lines.reduce((n:number,l:any)=>n+Number(l.expense),0),60);});
 await check('调整版待复核期间晚录被阻止，不能暗中混入已计算来源',async()=>{ok(await call('/quarter/expenses',expenseBody({amount:'5.00',voucherReference:'SYNTHETIC-274-LATE#1',reason:'合成晚录5',adjustmentIds:[round]}),finance),409);});
 await check('总部退回后允许明确晚录5，来源变更要求重新提交',async()=>{ok(await call('/quarter/results/'+result2+'/review',await reviewCommand(result2,'return'),head));ok(await call('/quarter/expenses',expenseBody({amount:'5.00',voucherReference:'SYNTHETIC-274-LATE#1',reason:'合成退回后核实遗漏费用5',adjustmentIds:[round]}),finance));const b=await call('/quarter/'+qid+'/basis',undefined,finance);ok(b,200);assert.ok(b.json.blockers.some((s:string)=>s.includes('来源已变化')));});
 await check('两店重提第三结果版费用65，前版链及轮次一致',async()=>{await submission(east,manager,round);await submission(river,managerR,round);result3=await calc(round,'合成东城40+晚录5，滨江20，整批65');const d=await detail(result3);assert.equal(d.result.previous_result_id,result2);assert.equal(Number(d.result.version_no),3);assert.equal(d.plan.adjustmentId,round);assert.equal(d.plan.lines.length,3);assert.equal(d.plan.lines.reduce((n:number,l:any)=>n+Number(l.expense),0),65);assert.equal(d.plan.lines.find((l:any)=>l.doctorId===lin).expense,'45.00');evidence.finalExpense='65.00';});
 await check('第三版总部确认关闭轮次，首次时刻和首次结果保持原值',async()=>{const b=await reviewCommand(result3);ok(await call('/quarter/results/'+result3+'/review',b,head));for(let n=0;n<3;n++)ok(await call('/quarter/results/'+result3+'/review',b,head));const d=await call('/quarter/'+qid,undefined,head);ok(d,200);assert.equal(d.json.adjustments.active,null);assert.equal(d.json.adjustments.latestConfirmedResultId,result3);assert.equal(d.json.quarter.first_full_confirmed_at,firstTime);assert.equal(d.json.quarter.first_confirmed_result_id,oldResult);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.result_review WHERE result_id=$1',[result3])).rows[0].n,1);evidence.confirmation={firstTime,firstResult:oldResult,latestResult:result3,active:null};});
 await check('过期轮次不能再改费用，旧版50与第三版65分别保留来源',async()=>{ok(await call('/quarter/expenses',expenseBody({id:eastExpense.id,version:2,amount:'41.00',reason:'合成过期轮次不得补改',adjustmentIds:[round]}),finance),409);assert.equal(JSON.stringify((await detail(oldResult)).plan),oldPlan);const rows=(await db.pool.query('SELECT result_id,version_no,previous_result_id,review_state FROM adc.quarter_result_version WHERE quarter_id=$1 ORDER BY version_no',[qid])).rows;assert.equal(rows.length,3);assert.equal(rows[0].review_state,'confirmed');assert.equal(rows[2].review_state,'confirmed');assert.equal(rows[1].previous_result_id,rows[0].result_id);assert.equal(rows[2].previous_result_id,rows[1].result_id);const costs=(await db.pool.query('SELECT version_no,amount FROM adc.expense_revision WHERE expense_id=$1 ORDER BY version_no',[eastExpense.id])).rows;assert.deepEqual(costs.map(x=>x.amount),['30.00','40.00']);evidence.resultChain=rows;evidence.expenseVersions=costs;});
 await writeFile(join(root,'artifacts/closed-quarter-journey-check.json'),JSON.stringify({batch:274,checks:passed.length,passed,evidence,isolatedDatabase:name,http:{get:reads,post:writes},browserPerformed:false,realFinance:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));console.log('Closed quarter journey checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);await admin.end();delete process.env.ADC_ISOLATED_SEED_REPORTS;await rm(folder,{recursive:true,force:true});}

