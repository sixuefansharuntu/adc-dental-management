 await check('预约到核算结果的原版引用贯通，不凭页面金额相同冒充同源',async()=>{const chain=(await db.pool.query(`SELECT v.appointment_id,ar.appointment_id AS original_appointment,br.visit_id,rr.bill_id,sr.receipt_id,rl.result_id,v.appointment_revision_id,ar.version_no AS appointment_version,vr.visit_revision_id,vr.version_no AS visit_version,br.bill_revision_id,br.version_no AS bill_version,rr.receipt_revision_id,rr.version_no AS receipt_version,ri.result_line_id,ri.adopted_amount FROM adc.visit v JOIN adc.appointment_revision ar ON ar.appointment_revision_id=v.appointment_revision_id JOIN adc.treatment_bill b ON b.visit_id=v.visit_id JOIN adc.bill_revision br ON br.bill_id=b.bill_id AND br.version_no=1 JOIN adc.visit_revision vr ON vr.visit_revision_id=br.visit_revision_id AND vr.visit_id=v.visit_id JOIN adc.receipt_revision rr ON rr.bill_revision_id=br.bill_revision_id JOIN adc.submission_receipt sr ON sr.receipt_revision_id=rr.receipt_revision_id JOIN adc.result_income_source ri ON ri.receipt_revision_id=rr.receipt_revision_id JOIN adc.quarter_result_line rl ON rl.result_line_id=ri.result_line_id WHERE v.visit_id=$1 AND rl.result_id=$2`,[visit.id,resultId])).rows;assert.equal(chain.length,1);assert.equal(chain[0].appointment_id,appointment.id);assert.equal(chain[0].original_appointment,appointment.id);assert.equal(chain[0].receipt_id,receipt.id);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.quarter_result_version WHERE quarter_id=$1',[qid])).rows[0].n,1);assert.equal(Number(chain[0].appointment_version),2);assert.equal(Number(chain[0].visit_version),4);assert.equal(Number(chain[0].bill_version),1);assert.equal(Number(chain[0].receipt_version),1);assert.equal(chain[0].adopted_amount,'62.50');evidence.lineageVerified=true;evidence.lineage=chain[0];});
