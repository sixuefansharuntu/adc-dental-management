 let patientId:string,visit:any,arrivalBody:any;const localDay=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),year=Number(localDay.slice(0,4)),quarter=Math.floor((Number(localDay.slice(5,7))-1)/3)+1;
