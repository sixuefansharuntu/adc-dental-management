import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedQuarter(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const boot=id('booking-bootstrap'),east=id('clinic-east'),river=id('clinic-river');async function put(t:string,d:any){const k=Object.keys(d);await c.query(`INSERT INTO adc.${t}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(d));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(176001)');await put('calculation_policy_version',{policy_version_id:id('policy176-core'),version_no:1,business_timezone:'Asia/Shanghai',income_rule:'actual_receipts',cost_rule:'verified_issue_cost',expense_rule:'manual_exact_allocation'});
 const rv=id('rolev176-manager'),g=id('grant176-manager');await put('role_version',{role_version_id:rv,role_id:id('role173-manager'),version_no:3,name:'原管理功能及季度资料提交',configured_by:boot,configured_at:new Date()});await c.query('INSERT INTO adc.role_function SELECT $1,function_code FROM adc.role_function WHERE role_version_id=$2 ON CONFLICT DO NOTHING',[rv,id('rolev174-manager')]);for(const f of['quarter.read','quarter.submit'])await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:g,account_id:id('account173-manager'),version_no:3,effective_from:'2026-10-25T08:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:east});const old=(await c.query('SELECT resource_code,field_code,action_code FROM adc.grant_field WHERE grant_id=$1',[id('grant174-manager')])).rows;for(const f of[...old,{resource_code:'quarter',field_code:'submission',action_code:'maintain'}])await put('grant_field',{grant_field_id:id(g+f.resource_code+f.field_code),grant_id:g,...f});
 for(const[key,login,password,scopes,functions,fields]of[
  ['finance','finance.hq',env.ADC_FINANCE_PASSWORD,[east,river],['quarter.read','quarter.create','quarter.calculate','quarter.result.read','expense.manage'],[['quarter','scope'],['quarter','results'],['expense','data']]],
  ['review','review.hq',env.ADC_REVIEW_PASSWORD,[east,river],['quarter.read','quarter.review','quarter.result.read'],[['quarter','review']]],
  ['manager-river','manager.river',env.ADC_MANAGER_RIVER_PASSWORD,[river],['quarter.read','quarter.submit'],[['quarter','submission']]]
 ]as any[]){const emp=id('employee176-'+key),account=id('account176-'+key),role=id('role176-'+key),rv=id('rolev176-'+key),grant=id('grant176-'+key);await put('employee',{employee_id:emp,name:key==='finance'?'财务人员（合成）':key==='review'?'总部负责人（合成）':'滨江诊所管理人员（合成）',employment_arrangement:JSON.stringify({assignments:scopes.map((clinicId:string)=>({clinicId,role:key==='manager-river'?'manager':key,from:'2026-01-01',to:null}))}),public_enabled:false,row_version:1});await put('staff_account',{account_id:account,employee_id:emp,login_name:login,credential_verifier:await credentialHash(password),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:boot,maintained_at:new Date(),row_version:1});await put('security_role',{role_id:role,name:login+' 本机岗位',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:login+' 本机岗位',configured_by:boot,configured_at:new Date()});for(const f of functions)await put('role_function',{role_version_id:rv,function_code:f});await put('access_grant',{grant_id:grant,account_id:account,version_no:1,effective_from:'2026-10-25T00:00:00Z',configured_by:boot,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:rv});for(const clinicId of scopes)await put('grant_clinic',{grant_id:grant,clinic_id:clinicId});for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(grant+r+f),grant_id:grant,resource_code:r,field_code:f,action_code:'maintain'});}
 await c.query('COMMIT');}catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'季度核算演示账号.txt'),`ADC本机季度核算，全部合成，不要提交\n财务 finance.hq：${env.ADC_FINANCE_PASSWORD}\n总部 review.hq：${env.ADC_REVIEW_PASSWORD}\n滨江管理 manager.river：${env.ADC_MANAGER_RIVER_PASSWORD}\n东城manager.east口令沿用随访演示账号.txt，保留原功能并增加本店季度提交。没有种子预填季度、费用或确认结果。\n`,'utf8');console.log('Quarter roles and fixed policy ready; credentials private; no financial source or quarter result seeded.');}
if(process.argv[1]?.endsWith('seed-quarter.mts'))seedQuarter().catch(e=>{console.error(e.message);process.exitCode=1;});

