 for(const[key,qty]of[['MAIN','20'],['OTHER','5']]){const m=await call('/inventory/materials',{requestId:randomUUID(),id:null,version:0,clinicId:clinic,name:'销售合成商品'+key,classification:'课程商品',unit:'盒',specification:'合成规格',enabled:true,distinctConfirmed:false},store);ok(m);const r=await call('/inventory/receipts',{requestId:randomUUID(),clinicId:clinic,materialId:m.json.id,supplierId:sup.json.id,batch:null,expiresOn:null,unit:'盒',quantity:qty,receivedAt:at(),unitPrice:null,pendingNote:'成本待核实',sourceReference:'175-'+key,actualConfirmed:true},store);ok(r);if(key==='MAIN'){material=m.json;stockId=r.json.stockId;}else otherStock=r.json.stockId;}
