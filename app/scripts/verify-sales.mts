 await check('已确认季度拒绝直接补收或交付，原确认保持',async()=>{const newSale=await createSale([{materialId:material.id,quantity:'1',unitPrice:'1'}]),q=randomUUID(),policy=randomUUID(),op=randomUUID(),result=randomUUID(),boot=id('booking-bootstrap');await db.pool.query("INSERT INTO adc.calculation_policy_version VALUES($1,1,'Asia/Shanghai','actual_receipts','known_costs','recorded_expenses')",[policy]);await db.pool.query("INSERT INTO adc.quarter_run(quarter_id,quarter_label,business_timezone,quarter_start_at,quarter_end_at,row_version) VALUES($1,'test','Asia/Shanghai','2026-10-01T00:00:00+08','2027-01-01T00:00:00+08',1)",[q]);await db.pool.query("INSERT INTO adc.business_operation(operation_id,actor_id,occurred_at,action_code,subject_kind,subject_key) VALUES($1,$2,clock_timestamp(),'seed.confirmed','quarter',$3)",[op,boot,q]);await db.pool.query("INSERT INTO adc.quarter_result_version(result_id,quarter_id,policy_version_id,version_no,confirmed_by,confirmed_at,review_state,calculated_by,calculated_at,operation_id) VALUES($1,$2,$3,1,$4,clock_timestamp(),'confirmed',$4,clock_timestamp(),$5)",[result,q,policy,boot,op]);await db.pool.query('UPDATE adc.quarter_run SET first_full_confirmed_at=clock_timestamp(),first_confirmed_result_id=$2 WHERE quarter_id=$1',[q,result]);ok(await call('/sales/'+newSale.id+'/receipt',collect(await view(newSale.id)),front),409);ok(await call('/sales/'+newSale.id+'/delivery',await delivery(newSale.id),front),409);assert.equal((await stock()).quantity,'5.0000');assert.equal((await view(newSale.id)).receipt,null);});
