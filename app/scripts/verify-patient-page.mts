 await check('232原请求在途未提交及回滚不推定已保存，不等待他人全局锁',async()=>{for(const rollback of[false,true]){const b=await input('tags',{tags:[rollback?'232回滚':'232在途']}),a=await auth.staff({headers:{cookie:front}}as any);let enter:any,release:any;const entered=new Promise<void>(r=>enter=r),gate=new Promise<void>(r=>release=r);const saving=service.save(a,pid,patientInput(b,true),async()=>{enter();await gate;if(rollback)throw Error('232 intentional rollback');}).then(r=>({r}),e=>({e}));await entered;try{const r=await Promise.race([status232(b.requestId,pid,'tags'),new Promise<any>((_,reject)=>setTimeout(()=>reject(Error('status waited on write lock')),2000))]);ok(r,200);assert.equal(r.json.state,'not_found');}finally{release();}const result=await saving;if(rollback)assert.match(result.e.message,/intentional/);else assert.ok(result.r.version);const r=await status232(b.requestId,pid,'tags');assert.equal(r.json.state,rollback?'not_found':'completed');}});
