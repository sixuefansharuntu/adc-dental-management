 await check('233真实HTTP保存成功后客户端丢回复，实际患者SFC恢复缓存并GET核实清理，不重复另版',async()=>{const b=await input('tags',{tags:['233真实HTTP合成']}),owner=await auth.staff({headers:{cookie:front}}as any),component=await patientTestComponent(),nativeFetch=globalThis.fetch,oldStorage=Object.getOwnPropertyDescriptor(globalThis,'sessionStorage'),store=new Map<string,string>();let posts=0,lost=false,saved:any;const node=()=>({parent:null as any,children:[]as any[]});globalThis.fetch=(async(url:any,opts:any={})=>{if(typeof url!=='string'||!url.startsWith('/api/v1/patients'))throw Error('isolation rejects unrelated API');const r=await nativeFetch((await app.getUrl())+url,{...opts,headers:{...opts.headers,Cookie:front,...(opts.method==='POST'?{Origin:env.ADMIN_ORIGIN!}:{})}});if(opts.method==='POST'){posts++;if(!lost&&r.ok){saved=await r.clone().json();lost=true;throw Error('233 client lost result after real HTTP success');}}return r;})as any;Object.defineProperty(globalThis,'sessionStorage',{configurable:true,value:{getItem:(k:string)=>store.get(k)||null,setItem:(k:string,v:string)=>store.set(k,v),removeItem:(k:string)=>store.delete(k)}});const renderer=createRenderer<any,any>({createElement:node,createText:node,createComment:node,setText(){},setElementText(){},patchProp(){},insert(c,p){c.parent=p;p.children.push(c);},remove(){},parentNode:n=>n.parent,nextSibling:()=>null}),mounted=renderer.createApp(component,{staff:owner}),vm:any=mounted.mount(node()),state=vm.$.setupState;try{for(let i=0;i<200&&state.busy;i++)await new Promise(r=>setTimeout(r,10));assert.equal(state.busy,false);await state.submit({id:pid,body:b,uncertain:false});assert.equal(lost,true);assert.equal(state.pending.phase,'pending');assert.equal(state.pending.body.requestId,b.requestId);assert.equal(state.branch,'');const after=await snap232();state.restoreCache();assert.equal(state.pending.accountId,owner.accountId);await state.checkPending();assert.equal(state.commandStatus.state,'completed');assert.equal(state.commandStatus.version,saved.version);state.clearPending();assert.equal(state.pending,null);assert.equal(store.size,0);assert.equal(posts,1);assert.deepEqual(await snap232(),after);}finally{mounted.unmount();globalThis.fetch=nativeFetch;if(oldStorage)Object.defineProperty(globalThis,'sessionStorage',oldStorage);else delete(globalThis as any).sessionStorage;}});

