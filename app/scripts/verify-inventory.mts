 await check('其他盘点调整干扰时保留待处理，不把它混为普通期间收发',async()=>{const r=await call(stockPath+'/counts',{requestId:randomUUID(),clinicId:clinic,stockIds:[stockId],scopeNote:'另一次明确盘点'},store);ok(r);const d=await countDetail(r.json.id);ok(await call(stockPath+'/counts/'+r.json.id+'/observations',{requestId:randomUUID(),version:1,lines:[{id:d.lines[0].stocktake_line_id,countedAt:new Date().toISOString(),quantity:'8',reason:'合成复核差异'}]},store));ok(await call(stockPath+'/counts/'+r.json.id+'/apply',apply(await preview(r.json.id)),store));const p=await preview();assert.equal(p.lines[0].blocked,true);ok(await call(stockPath+'/counts/'+count.id+'/apply',apply(p),store),409);});
 await check('不同效期不合并，按次预警未知效期不标无风险且查询不改库存',async()=>{const today=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),yesterday=new Date(Date.parse(today+'T00:00:00Z')-86400000).toISOString().slice(0,10);for(const[exp,key]of[[today,'TODAY'],[yesterday,'EXPIRED']])ok(await call(stockPath+'/receipts',receive({quantity:'1',expiresOn:exp,sourceReference:'DEMO-'+key,unitPrice:'12.5'}),store));const r=await call(stockPath+'/balances?clinicId='+clinic+'&threshold=100&expiryThrough='+today,undefined,manager);ok(r,200);assert.equal(r.json.items.length,3);assert.ok(r.json.items.some((x:any)=>x.expiryState==='missing'));assert.ok(r.json.items.some((x:any)=>x.expiryState==='expired'));assert.ok(r.json.items.some((x:any)=>x.expiryState==='near'));assert.ok(r.json.items.every((x:any)=>x.lowQuantity));assert.equal((await detail()).stock.quantity,'8.0000');});
