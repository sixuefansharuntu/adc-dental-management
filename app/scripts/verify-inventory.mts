 await check('真实入库与原请求10次重试、相同凭据行只增加一次，NULL身份唯一',async()=>{const b=receive(),r=await call(stockPath+'/receipts',b,store);ok(r);receipt=r.json;stockId=r.json.stockId;for(let i=0;i<10;i++)assert.equal((await call(stockPath+'/receipts',b,store)).json.repeated,true);const duplicate=await call(stockPath+'/receipts',receive(),store);ok(duplicate);assert.equal(duplicate.json.existing,true);ok(await call(stockPath+'/receipts',receive({quantity:'11'}),store),409);ok(await call(stockPath+'/receipts',receive({batch:'SAME-PAPER-OTHER-BATCH'}),store),409);ok(await call(stockPath+'/receipts',receive({expiresOn:'2027-01-01'}),store),409);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.stock_balance')).rows[0].n,1);assert.equal((await db.pool.query('SELECT quantity FROM adc.stock_balance WHERE stock_id=$1',[stockId])).rows[0].quantity,'10.0000');});
