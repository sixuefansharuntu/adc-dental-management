import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedCare(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const bootstrap=id('booking-bootstrap'),east=id('clinic-east');async function put(table:string,data:Record<string,unknown>){const k=Object.keys(data);await c.query(`INSERT INTO adc.${table}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(data));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(172001)');
  for(const role of['doctor','nurse']){const rv=id('rolev172-'+role);await put('role_version',{role_version_id:rv,role_id:id('role171-'+role),version_no:2,name:'诊疗影像加工 '+role,configured_by:bootstrap,configured_at:new Date()});const old=(await c.query('SELECT function_code FROM adc.role_function WHERE role_version_id=$1',[id('rolev171-'+role)])).rows.map(x=>x.function_code);const extra=role==='doctor'?['image.read','lab.read','lab.request','lab.review','lab.problem']:['image.read','image.photo','lab.read','lab.handover','lab.progress','lab.problem'];for(const f of[...old,...extra])await put('role_function',{role_version_id:rv,function_code:f});}
  for(const[key,clinic,role]of[['lin',east,'doctor'],['zhou',east,'doctor'],['river',id('clinic-river'),'doctor'],['nurse',east,'nurse']]){const old=id('grant171-'+key),grant=id('grant172-'+key);await put('access_grant',{grant_id:grant,account_id:id('account171-'+key),version_no:2,effective_from:'2026-10-24T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:id('rolev172-'+role)});await put('grant_clinic',{grant_id:grant,clinic_id:clinic});const fields=(await c.query('SELECT resource_code,field_code FROM adc.grant_field WHERE grant_id=$1',[old])).rows.map(x=>[x.resource_code,x.field_code]);fields.push(...(role==='doctor'?[['lab','requirements'],['lab','review'],['lab','problem']]:[['image','archive'],['lab','handover'],['lab','progress'],['lab','problem']]));for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(grant+r+f),grant_id:grant,resource_code:r,field_code:f,action_code:'maintain'});}
  const employee=id('imaging172-east'),account=id('account172-imaging'),role=id('role172-imaging'),rv=id('rolev172-imaging'),grant=id('grant172-imaging');await put('employee',{employee_id:employee,name:'赵影像员（合成）',employment_arrangement:JSON.stringify({assignments:[{clinicId:east,role:'imaging',from:'2026-01-01',to:null}]}),row_version:1,public_enabled:false});await put('security_role',{role_id:role,name:'影像归档人员（本机）',row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name:'检查影像归档',configured_by:bootstrap,configured_at:new Date()});for(const fn of['image.read','image.scan'])await put('role_function',{role_version_id:rv,function_code:fn});await put('staff_account',{account_id:account,employee_id:employee,login_name:'imaging.east',credential_verifier:await credentialHash(env.ADC_IMAGING_EAST_PASSWORD!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:bootstrap,maintained_at:new Date(),row_version:1});await put('access_grant',{grant_id:grant,account_id:account,version_no:1,effective_from:'2026-10-24T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:rv});await put('grant_clinic',{grant_id:grant,clinic_id:east});await put('grant_field',{grant_field_id:id(grant+'archive'),grant_id:grant,resource_code:'image',field_code:'archive',action_code:'maintain'});
  await c.query('COMMIT');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'影像加工演示账号.txt'),`ADC本机合成影像/加工\n入口：http://127.0.0.1:5173/\n检查影像：imaging.east，口令：${env.ADC_IMAGING_EAST_PASSWORD}\n\n医生/护士沿用诊疗演示账号.txt。护士维护诊疗照片；医生提出加工要求并作临床核对；护士交接和进度。前台没有影像加工权限。不要提交本文件。\n`,'utf8');console.log('Care grants versioned; imaging credential saved privately.');
}if(process.argv[1]?.endsWith('seed-care.mts'))seedCare().catch(e=>{console.error(e.message);process.exitCode=1;});

