 await check('原最小建档保留未知状态，同名同电话不自动合档',async()=>{const b={requestId:randomUUID(),clinicId:east,name:'合成患者190',phone:'13800000190',birthDate:null,sourceNote:null,identityBasis:'隔离合成核实'};const r=await call('/frontdesk/patients',b,front);ok(r);pid=r.json.id;const second=await call('/frontdesk/patients',{...b,requestId:randomUUID()},front);ok(second);assert.notEqual(second.json.id,pid);const d=await read();assert.equal(d.health.knowledge,'unknown');assert.deepEqual(d.health.allergies,[]);assert.equal(d.version,1);});
