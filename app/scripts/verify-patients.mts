 await check('医生护士当前和历史都不返回地址电话邮箱渠道',async()=>{for(const cookie of[doc,nurse]){const d=await read(cookie);assert.equal(d.profile,null);assert.equal(d.health.allergies.length,2);assert.equal(d.canManage.identity,false);assert.equal(d.canManage.health,true);const h=await call(path()+'/history?clinicId='+east,undefined,cookie);ok(h,200);for(const hidden of['13800000190','PRIVATE-ADDRESS-190','PRIVATE-BILLING-190','synthetic190@example.invalid','PRIVATE-SOURCE-190','PRIVATE-CONTACT-190','合成渠道'])assert.ok(!JSON.stringify(h.json).includes(hidden));}});
