const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_patient_test_'+Date.now(),folder=resolve(root,'.runtime',name);if(!/^adc_patient_test_\d+$/.test(name)||!folder.startsWith(resolve(root,'.runtime')+sep))throw Error('Unsafe test folder');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_ISOLATED_SEED_REPORTS='true';process.env.ADC_FILE_ROOT=join(folder,'private-files');let app:any;const passed:string[]=[],check=async(n:string,f:()=>Promise<void>)=>{await f();passed.push(n);console.log('PASS',n);};
try{process.env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();await seedBusiness();await seedClinic();await seedDentist();const securitySeed=await seedSecurity();await seedQualifications();await seedPatients();
 const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts'),{PatientService}=await import('../apps/api/src/patient.service.ts'),{AuthService}=await import('../apps/api/src/auth.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const db=app.get(DatabaseService),service=app.get(PatientService),auth=app.get(AuthService),base=(await app.getUrl())+'/api/v1',lin=id('booking-lin'),chen=id('booking-chen'),east=id('clinic-east'),river=id('clinic-river'),doctorBefore=(await db.pool.query('SELECT to_jsonb(e) data FROM adc.employee e WHERE employee_id=$1',[lin])).rows[0].data;

 async function call(path:string,body?:any,cookie='',origin=env.ADMIN_ORIGIN){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(cookie?{Cookie:cookie}:{}),...(body?{Origin:origin!}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function login(n:string,p:string){const r=await call('/staff/session',{loginName:n,password:p});ok(r);return r.cookie;}
 const front=await login('front.east',env.ADC_STAFF_EAST_PASSWORD!),riverFront=await login('front.river',env.ADC_STAFF_RIVER_PASSWORD!),doc=await login('doctor.lin',env.ADC_DOCTOR_LIN_PASSWORD!),nurse=await login('nurse.east',env.ADC_NURSE_EAST_PASSWORD!),manager=await login('manager.east',env.ADC_MANAGER_EAST_PASSWORD!),ac=await login('admin.local',securitySeed.credentials.admin);
