 await check('前台修改基本资料，未知字段保持空且不改过敏集合',async()=>{const r=await save('identity',{name:'合成患者190',birthDate:'2000-01-02',phone:'13800000190',contactAddress:'PRIVATE-ADDRESS-190',billingAddress:'PRIVATE-BILLING-190',email:'synthetic190@example.invalid'});firstInput=r.input;assert.equal(r.version,2);const d=await read();assert.equal(d.profile.birthDate,'2000-01-02');assert.equal(d.health.knowledge,'unknown');assert.deepEqual(d.health.allergies,[]);});
 await check('来源与联系要求独立保存，旧基础资料和渠道身份不丢',async()=>{await save('source',{sourceNote:'PRIVATE-SOURCE-190',introducerNote:'患者提供介绍人，合成'});await save('contact',{contactPreference:'PRIVATE-CONTACT-190',channels:[{id:channelId,name:'合成渠道',note:'仅登记关联，不发送消息'}]});const d=await read();assert.equal(d.profile.contactAddress,'PRIVATE-ADDRESS-190');assert.equal(d.profile.sourceNote,'PRIVATE-SOURCE-190');assert.equal(d.profile.channels[0].id,channelId);});
 await check('不同过敏了解状态校验，未提交集合不隐式清空',async()=>{const d=await read(),b={clinicId:east,version:d.version,branch:'health',data:{knowledge:'reported',note:null,allergies:[]},reason:'核实'};ok(await call(path()+'/preview',b,front),400);ok(await call(path()+'/preview',{...b,data:{knowledge:'unknown',note:null}},front),400);ok(await call(path()+'/preview',{...b,data:{knowledge:'none_reported',note:null,allergies:[{id:allergyA,allergen:'演示对象',description:null}]}},front),400);});
