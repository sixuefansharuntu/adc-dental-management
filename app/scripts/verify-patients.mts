 await check('医生修改过敏完整集合，保留标签与前台资料',async()=>{await save('health',{knowledge:'reported',note:'医生核对的合成说明',allergies:[{id:allergyA,allergen:'演示对象甲',description:'医生据实核对合成说明'}]},doc);const d=await read();assert.equal(d.health.allergies.length,1);assert.deepEqual(d.health.tags,['合成标签A']);assert.equal(d.profile.phone,'13800000190');assert.equal(d.profile.channels[0].id,channelId);});
 await check('护士维护标签不覆盖过敏集合和其他分支',async()=>{await save('tags',{tags:['护士合成标签','合成标签A']},nurse);const d=await read();assert.equal(d.health.allergies[0].id,allergyA);assert.equal(d.profile.sourceNote,'PRIVATE-SOURCE-190');});
 await check('诊疗原参与对象读取当前逐项过敏及标签，前台不返回临床正文',async()=>{const r=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:east,patientId:pid,doctorId:lin,nurseIds:[id('nurse-east-a')],arrivedAt:new Date(Date.now()-500).toISOString(),basis:'隔离合成到院',identityBasis:'已当面核对合成档案',identityConfirmed:true,coordination:'已核实内部合成接诊'},front);ok(r);const v=await call('/clinical/visits/'+r.json.id,undefined,doc);ok(v,200);assert.equal(v.json.allergy.items[0].id,allergyA);assert.ok(v.json.allergy.tags.includes('护士合成标签'));const f=await call('/clinical/visits/'+r.json.id,undefined,front);ok(f,200);assert.equal(f.json.canClinical,false);assert.equal(f.json.allergy,null);});
 await check('同一基准并发修改只成功一次，不覆盖另一岗位',async()=>{const a=await input('source',{sourceNote:'并发来源A',introducerNote:null}),b=await input('tags',{tags:['并发标签B']},nurse),r=await Promise.all([call(path(),a,front),call(path(),b,nurse)]);assert.deepEqual(r.map(x=>x.status).sort(),[201,409]);});
 await check('原请求重复十次不重复另版，内容改变复用原键拒绝',async()=>{const before=(await read()).version;for(let i=0;i<10;i++){const r=await call(path(),firstInput,front);ok(r);assert.equal(r.json.repeated,true);}assert.equal((await read()).version,before);ok(await call(path(),{...firstInput,reason:'换内容'},front),409);});
 await check('撤销当前权限后原请求重试及原版读取都拒绝',async()=>{const account=id('account-front-east'),g=(await db.pool.query('SELECT * FROM adc.access_grant WHERE account_id=$1 ORDER BY effective_from DESC,version_no DESC LIMIT 1',[account])).rows[0],grant=randomUUID();await db.pool.query('INSERT INTO adc.access_grant(grant_id,account_id,version_no,effective_from,configured_by,configured_at) VALUES($1,$2,$3,clock_timestamp(),$4,clock_timestamp())',[grant,account,Number(g.version_no)+1,id('booking-bootstrap')]);ok(await call(path(),firstInput,front),403);ok(await call(path()+'/history?clinicId='+east,undefined,front),403);await db.pool.query('DELETE FROM adc.access_grant WHERE grant_id=$1',[grant]);});
 await check('保存写后故障回滚根、全部集合、原版和请求标识',async()=>{const before=await read(),b=await input('tags',{tags:['回滚标记']}),actor=await auth.staff({headers:{cookie:front}}as any),n=(await db.pool.query('SELECT count(*)::int n FROM adc.patient_revision WHERE patient_id=$1',[pid])).rows[0].n;await assert.rejects(service.save(actor,pid,patientInput(b,true),()=>{throw Error('injected patient rollback');}));assert.deepEqual(await read(),before);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.patient_revision WHERE patient_id=$1',[pid])).rows[0].n,n);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.command_dedup WHERE request_key=$1',[b.requestId])).rows[0].n,0);});
 await check('已纳管当前集合和原版不能被绕过改写，根身份与建档店固定',async()=>{const r=(await db.pool.query('SELECT patient_revision_id FROM adc.patient_revision WHERE patient_id=$1 ORDER BY version_no DESC LIMIT 1',[pid])).rows[0];for(const[sql,values]of[["UPDATE adc.patient SET name='tamper',row_version=row_version+1 WHERE patient_id=$1",[pid]],["INSERT INTO adc.patient_tag VALUES($1,'tamper')",[pid]],["INSERT INTO adc.patient_revision_tag VALUES($1,'late append')",[r.patient_revision_id]],["UPDATE adc.patient SET created_clinic_id=$2,row_version=row_version+1 WHERE patient_id=$1",[pid,river]],["UPDATE adc.patient_revision SET source_note='tamper' WHERE patient_revision_id=$1",[r.patient_revision_id]]])await assert.rejects(db.pool.query(sql as string,values as any[]));});
 await check('原渠道不能删除或转给另一患者，解除须保留关联说明',async()=>{const d=await read(),b={clinicId:east,version:d.version,branch:'contact',data:{contactPreference:null,channels:[]},reason:'不能丢旧渠道'};ok(await call(path()+'/preview',b,front),400);const other=randomUUID();await db.pool.query('INSERT INTO adc.patient(patient_id,name,created_clinic_id) VALUES($1,$2,$3)',[other,'隔离另一患者',east]);const r=await call('/patients/'+other+'/preview',{...b,version:1,data:{contactPreference:null,channels:[{id:channelId,name:'不能转用',note:null}]}},front);ok(r,403);await save('contact',{contactPreference:'仅使用当前说明渠道',channels:[{id:channelId,name:'合成渠道',note:'已解除，不再使用；保留旧来源'}]});});
 await check('旧档当前无原版首次捕获，不冒充旧创建操作',async()=>{const legacy=randomUUID();await db.pool.query('INSERT INTO adc.patient(patient_id,name,created_clinic_id,allergy_knowledge) VALUES($1,$2,$3,$4)',[legacy,'原有导入合成档案',east,'unknown']);const b={clinicId:east,version:1,branch:'tags',data:{tags:['首次纳管']},reason:'隔离旧档核对'},p=await call('/patients/'+legacy+'/preview',b,front);ok(p);ok(await call('/patients/'+legacy,{...b,requestId:randomUUID(),previewToken:p.json.previewToken,confirmed:true},front));const h=await call('/patients/'+legacy+'/history?clinicId='+east,undefined,front);ok(h,200);assert.equal(h.json.items.length,2);assert.equal(h.json.items[1].baselineCapture,true);});
 await check('无诊所来源和跨诊所档案不猜归属、不泄露内容',async()=>{const unknown=randomUUID(),remote=randomUUID();await db.pool.query('INSERT INTO adc.patient(patient_id,name) VALUES($1,$2)',[unknown,'未知来源合成']);await db.pool.query('INSERT INTO adc.patient(patient_id,name,created_clinic_id) VALUES($1,$2,$3)',[remote,'滨江合成私有档案',river]);ok(await call('/patients/'+unknown+'?clinicId='+east,undefined,front),403);ok(await call('/patients/'+remote+'?clinicId='+east,undefined,front),403);ok(await call(path()+'?clinicId='+river,undefined,riverFront),403);});
 await check('超过50个原版完整分页，旧过敏不回读后来删改',async()=>{for(let i=0;i<52;i++)await save('tags',{tags:['历史合成'+i]});let before:string|undefined,all:any[]=[];do{const r=await call(path()+'/history?clinicId='+east+(before?'&beforeVersion='+before:''),undefined,front);ok(r,200);all.push(...r.json.items);before=r.json.nextVersion;}while(before);assert.ok(all.length>50);assert.equal(new Set(all.map(x=>x.version)).size,all.length);assert.equal(all.find(x=>x.version===5).health.allergies.length,2);assert.equal(all.find(x=>x.version===1).health.knowledge,'unknown');});
 await check('患者目录50项游标不漏不重，特殊检索字符按原文处理',async()=>{for(let i=0;i<53;i++)await db.pool.query('INSERT INTO adc.patient(patient_id,name,created_clinic_id) VALUES($1,$2,$3)',[randomUUID(),'分页合成'+i,east]);let after:string|undefined,all:any[]=[];do{const r=await call('/patients?clinicId='+east+(after?'&afterId='+after:''),undefined,front);ok(r,200);all.push(...r.json.items);after=r.json.nextId;}while(after);const count=(await db.pool.query('SELECT count(*)::int n FROM adc.patient WHERE created_clinic_id=$1',[east])).rows[0].n;assert.equal(all.length,count);assert.equal(new Set(all.map(x=>x.id)).size,all.length);const escaped=await call('/patients?clinicId='+east+'&q=%25',undefined,front);ok(escaped,200);assert.equal(escaped.json.items.length,0);});
 await check('患者成为跨店共用后单店仍可供阅，但不能全局修改',async()=>{const c=await db.pool.connect();try{await c.query('BEGIN');const vid=randomUUID();await c.query('INSERT INTO adc.visit(visit_id,patient_id,clinic_id,registrar_id,doctor_id,arrived_at,progress_basis) VALUES($1,$2,$3,$4,$5,clock_timestamp(),$6)',[vid,pid,river,id('booking-bootstrap'),chen,'隔离跨店旧事实']);await c.query('INSERT INTO adc.visit_nurse VALUES($1,$2)',[vid,id('nurse-river')]);await c.query('COMMIT');}finally{c.release();}const d=await read();assert.equal(d.sharedClinicCount,2);assert.equal(d.canManage.health,false);ok(await call(path()+'/preview',{clinicId:east,version:d.version,branch:'tags',data:{tags:['不允许单店全局改']},reason:'核对'},front),403);});
 await check('不新建账户或病历交易，不向患者公开健康及联系资料',async()=>{for(const table of['clinical_record','treatment_bill','receipt','product_sale','stock_movement','quarter_result_version'])assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.'+table)).rows[0].n,0);const publicData=await call('/catalogue');ok(publicData,200);assert.ok(!JSON.stringify(publicData.json).includes('PRIVATE-'));assert.equal((await db.pool.query("SELECT count(*)::int n FROM information_schema.columns WHERE table_schema='adc'")).rows[0].n,866);});
 await writeFile(join(root,'artifacts/patient-check.json'),JSON.stringify({checks:passed.length,passed,isolatedDatabase:name,checkedAt:new Date().toISOString()},null,2));console.log('Patient verified:',passed.length,'checks in isolated PostgreSQL/HTTP.');
}finally{if(app)await app.close();process.env.PGDATABASE=original;delete process.env.ADC_ISOLATED_SEED_REPORTS;delete process.env.ADC_FILE_ROOT;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE IF EXISTS "${name}"`);await admin.end();await rm(folder,{recursive:true,force:true});}
