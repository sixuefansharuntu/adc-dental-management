import pg from'pg';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{writeFile}from'node:fs/promises';import{join}from'node:path';
import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{seedClinical}from'./seed-clinical.mts';import{fixtureId as id}from'./seed.mjs';
const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_clinical_history_test_'+Date.now();if(!/^adc_clinical_history_test_\d+$/.test(name))throw Error('Unsafe isolated database');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;process.env.ADC_ISOLATED_SEED_REPORTS='true';process.env.BOOKING_DEMO_DATE=new Date(Date.now()+86400000).toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'});let app:any;const passed:string[]=[],check=async(n:string,f:()=>Promise<void>)=>{await f();passed.push(n);console.log('PASS',n);};
try{
 await migrate();await seedBooking();await seedFrontdesk();await seedClinical();const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService);
 async function call(path:string,body?:any,cookie=''){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(cookie?{Cookie:cookie}:{}),...(body?{Origin:env.ADMIN_ORIGIN!}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function login(n:string,p:string){const r=await call('/staff/session',{loginName:n,password:p});ok(r);return r.cookie;}
 const front=await login('front.east',env.ADC_STAFF_EAST_PASSWORD!),doc=await login('doctor.lin',env.ADC_DOCTOR_LIN_PASSWORD!),nurse=await login('nurse.east',env.ADC_NURSE_EAST_PASSWORD!),wrong=await login('doctor.zhou',env.ADC_DOCTOR_ZHOU_PASSWORD!),river=await login('doctor.river',env.ADC_DOCTOR_RIVER_PASSWORD!);const clinic=id('clinic-east'),doctor=id('booking-lin'),fill=id('item171-fill');
 async function newVisit(){const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:clinic,name:'原版追查隔离合成191',phone:'13800000191',identityBasis:'本机隔离合成身份'},front);ok(p);const v=await call('/frontdesk/visits',{requestId:randomUUID(),clinicId:clinic,patientId:p.json.id,doctorId:doctor,nurseIds:[id('nurse-east-a')],arrivedAt:new Date(Date.now()-10000).toISOString(),basis:'隔离合成到院',identityBasis:'已核对隔离合成身份',identityConfirmed:true,coordination:'已核实内部实际接诊'},front);ok(v);return v.json;}
 const visit=await newVisit(),path='/clinical/visits/'+visit.id,history=(kind:string,cookie=doc,query='')=>call(path+'/history?kind='+kind+query,undefined,cookie);
 let detail:any;
 async function saveRecord(version:number,teeth=['16'],body:string|null=null){const ts=detail?.treatments||[];const b={requestId:randomUUID(),recordVersion:version,clinicalAt:visit.arrivedAt,body,pendingNote:body?null:'隔离合成初版正文待补191',completeness:body?'complete':'pending',doctorConfirmed:true,reason:version?'隔离合成更正191':null,treatments:ts.length?ts.map((t:any)=>({id:t.id,version:t.version,itemId:t.itemId,performedAt:t.performedAt,teeth})): [{id:null,version:0,itemId:fill,performedAt:visit.arrivedAt,teeth}]};const r=await call(path+'/record',b,doc);ok(r);detail=(await call(path,undefined,doc)).json;return r.json;}
 async function saveBill(q:string){const s=await call(path+'/billing-source',undefined,nurse);ok(s,200);const b={billId:s.json.bill?.id||null,billVersion:s.json.bill?.version||0,priceBasis:null,lines:s.json.items.map((t:any)=>({treatmentId:t.id,treatmentVersion:t.version,priceVersionId:t.priceVersionId,quantity:q,unitPrice:t.referencePrice}))},d=await call(path+'/draft',b,nurse);ok(d);const saved=await call(path+'/bill',{...b,requestId:randomUUID(),draftToken:d.json.draftToken,reason:'隔离合成核费更正191'},nurse);ok(saved);return saved.json;}
 await check('未登录与非法类别游标页数拒绝',async()=>{ok(await history('record',''),401);for(const q of['&beforeVersion=0','&beforeVersion=-1','&beforeVersion=1e2','&beforeVersion=9007199254740992','&limit=0','&limit=51','&limit=1&limit=2'])ok(await history('record',doc,q),400);ok(await history('receipt'),400);});
 await check('前台禁止正文及独立治疗原版，非参与医生和跨店拒绝',async()=>{for(const kind of['record','treatment'])ok(await history(kind,front,kind==='treatment'?'&treatmentId='+randomUUID():''),403);for(const cookie of[wrong,river])for(const kind of['record','bill'])ok(await history(kind,cookie),403);});
 await check('未保存病历账单明确空，不伪造零元或空正文原版',async()=>{for(const kind of['record','bill']){const h=await history(kind,kind==='bill'?front:doc);ok(h,200);assert.deepEqual(h.json.items,[]);assert.equal(h.json.currentVersion,null);assert.equal(h.json.nextVersion,null);}});
 await saveRecord(0);await saveBill('1.0000');const tid=detail.treatments[0].id;
 await check('医生护士供阅病历v1，原正文待补和作者时点明确',async()=>{for(const cookie of[doc,nurse]){const h=await history('record',cookie);ok(h,200);const r=h.json.items[0];assert.equal(r.version,1);assert.equal(r.body,null);assert.equal(r.completeness,'pending');assert.match(r.pendingNote,/初版/);assert.equal(r.writers[0].id,doctor);assert.equal(r.editor.id,doctor);assert.ok(r.savedAt);}});
 await check('前台只获原版账单采用信息，不混患者联系过敏正文',async()=>{const h=await history('bill',front);ok(h,200);const s=JSON.stringify(h.json);for(const text of['13800000191','初版正文待补','allergy','body','pendingNote','paymentState','receipt','registeredAt'])assert.equal(s.includes(text),false,text);assert.equal(h.json.items[0].total,'200.00');assert.equal(h.json.items[0].lines[0].name,'充填治疗（示例）');});
 await saveRecord(1,['17'],'隔离合成完整正文第二版191');
 await check('病历更正后旧版正文状态仍独立，按版本降序',async()=>{const h=await history('record');ok(h,200);assert.deepEqual(h.json.items.map((r:any)=>r.version),[2,1]);assert.equal(h.json.items[0].body,'隔离合成完整正文第二版191');assert.equal(h.json.items[1].body,null);assert.equal(h.json.items[1].completeness,'pending');});
 await check('治疗原版牙位与确认人独立，不取当前牙位替旧版',async()=>{const h=await history('treatment',nurse,'&treatmentId='+tid);ok(h,200);assert.deepEqual(h.json.items.map((r:any)=>r.teeth),[['17'],['16']]);assert.equal(h.json.items[0].confirmingDoctor.id,doctor);assert.equal(h.json.items[1].itemId,fill);assert.ok(h.json.referenceNamesAreCurrent);});
 await check('旧账单仍采用治疗v1和原牙位，不拼后来治疗',async()=>{const r=(await history('bill',front)).json.items[0];assert.equal(r.lines[0].treatmentVersion,1);assert.deepEqual(r.lines[0].teeth,['16']);assert.equal(r.total,'200.00');assert.ok(r.lines[0].priceVersionId);assert.ok(r.visitRevisionId);assert.equal(r.staff.length,2);});
 await saveBill('1.2500');
 await check('账单v1与v2分别保存原金额和采用治疗版',async()=>{const h=await history('bill',front);ok(h,200);assert.deepEqual(h.json.items.map((r:any)=>r.total),['250.00','200.00']);assert.deepEqual(h.json.items.map((r:any)=>r.lines[0].treatmentVersion),[2,1]);});
 await check('治疗标识必须属于本次就诊，不接受借用及多余参数',async()=>{ok(await history('treatment',doc),400);ok(await history('treatment',doc,'&treatmentId='+randomUUID()),404);ok(await history('record',doc,'&treatmentId='+tid),400);const other=await newVisit();const h=await call('/clinical/visits/'+other.id+'/history?kind=treatment&treatmentId='+tid,undefined,doc);ok(h,404);});
 await check('治疗目录改名仅作当前辅助名，旧账单采用名不回算',async()=>{await db.pool.query('UPDATE adc.treatment_item SET name=$2 WHERE item_id=$1',[fill,'隔离当前目录名191']);const t=(await history('treatment',doc,'&treatmentId='+tid)).json.items[1],b=(await history('bill',front)).json.items[1];assert.equal(t.currentItemName,'隔离当前目录名191');assert.equal(b.lines[0].name,'充填治疗（示例）');await db.pool.query('UPDATE adc.treatment_item SET name=$2 WHERE item_id=$1',[fill,'充填治疗（示例）']);});
 for(let v=2;v<53;v++)await saveRecord(v,['17'],'隔离合成完整正文第'+(v+1)+'版191');
 let first:any;
 await check('53份病历原版分50和3，稳定游标无重复',async()=>{const h=await history('record');ok(h,200);first=h.json;assert.equal(first.items.length,50);assert.equal(first.nextVersion,4);assert.deepEqual(first.items.map((r:any)=>r.version),Array.from({length:50},(_,i)=>53-i));});
 await saveRecord(53,['17'],'隔离合成翻页后新增54版191');
 await check('翻页间新版本不挤入旧页，重读才取得54版',async()=>{const second=await history('record',doc,'&beforeVersion='+first.nextVersion);ok(second,200);assert.deepEqual(second.json.items.map((r:any)=>r.version),[3,2,1]);assert.equal(second.json.nextVersion,null);assert.equal(new Set([...first.items,...second.json.items].map((r:any)=>r.revisionId)).size,53);assert.equal((await history('record')).json.items[0].version,54);const empty=await history('record',doc,'&beforeVersion=1');ok(empty,200);assert.deepEqual(empty.json.items,[]);});
 for(let v=2;v<53;v++)await saveBill((v+1)+'.0000');
 await check('53份账单原版同样稳定分页，各版金额精确',async()=>{const h=await history('bill',front),tail=await history('bill',front,'&beforeVersion='+h.json.nextVersion);ok(h,200);ok(tail,200);assert.equal(h.json.items.length,50);assert.deepEqual(tail.json.items.map((r:any)=>r.version),[3,2,1]);assert.equal(h.json.items[0].total,'10600.00');assert.equal(tail.json.items[2].total,'200.00');});
 await check('缩小页数1或10有效，治疗游标按本实体版本',async()=>{for(const n of[1,10]){const h=await history('record',nurse,'&limit='+n);ok(h,200);assert.equal(h.json.items.length,n);}const h=await history('treatment',doc,'&treatmentId='+tid+'&beforeVersion=2&limit=1');ok(h,200);assert.deepEqual(h.json.items.map((r:any)=>r.version),[1]);assert.equal(h.json.nextVersion,null);});
 await check('后来实际收款不被拼入任一旧账单原版',async()=>{const bill=(await call(path,undefined,front)).json.bill;ok(await call(path+'/receipt',{requestId:randomUUID(),billVersion:bill.version,amount:bill.total,paymentMethod:'cash',receivedAt:new Date(Date.now()-1000).toISOString(),actualReceived:true,basis:'隔离合成已核实收到191'},front));const h=await history('bill',front);ok(h,200);for(const r of h.json.items){assert.equal('receipt'in r,false);assert.equal('paymentState'in r,false);}assert.equal((await call(path,undefined,front)).json.bill.paymentState,'paid');});
 await check('供阅审计仅含实际版本和范围，不写病历内容',async()=>{const h=await history('record',doc,'&limit=1'),r=h.json.items[0],logs=(await db.pool.query("SELECT access_scope FROM adc.business_operation WHERE subject_key=$1 AND action_code='clinical.history.view' ORDER BY occurred_at DESC LIMIT 1",[visit.id])).rows[0].access_scope;assert.deepEqual(logs.revisionIds,[r.revisionId]);assert.deepEqual(logs.versions,[54]);assert.equal(logs.clinicalBody,true);assert.equal('body'in logs,false);assert.deepEqual(logs.visitIds,[visit.id]);});
 await check('原版读取不改任何已有临床交易、原版或去重',async()=>{const tables=['clinical_record','clinical_record_revision','record_revision_writer','treatment','treatment_revision','treatment_revision_tooth','treatment_bill','bill_revision','bill_revision_line','bill_revision_staff','receipt','receipt_revision','command_dedup'];const snap=async()=>{const x:any={};for(const t of tables)x[t]=(await db.pool.query(`SELECT to_jsonb(t)::text data FROM adc.${t} t ORDER BY data`)).rows;return x;};const before=await snap();await history('record');await history('treatment',nurse,'&treatmentId='+tid);await history('bill',front);assert.deepEqual(await snap(),before);});
 await check('当前原版缺失不拿现值冒充历史',async()=>{const empty=await newVisit(),op=randomUUID(),rid=randomUUID();await db.pool.query("INSERT INTO adc.clinical_record(record_id,visit_id,clinical_at,body,pending_note,row_version,completeness) VALUES($1,$2,clock_timestamp(),NULL,'隔离旧来源无原版',1,'pending')",[rid,empty.id]);const h=await call('/clinical/visits/'+empty.id+'/history?kind=record',undefined,doc);ok(h,409);});
 await check('诊所授权收回后所有原版入口立即拒绝',async()=>{const g=id('grant171-nurse');await db.pool.query('DELETE FROM adc.grant_clinic WHERE grant_id=$1 AND clinic_id=$2',[g,clinic]);for(const kind of['record','bill'])ok(await history(kind,nurse),403);ok(await history('treatment',nurse,'&treatmentId='+tid),403);});
 await check('会话退出后原会话不能继续供阅历史',async()=>{ok(await call('/staff/logout',{},front));ok(await history('bill',front),401);});
 await writeFile(join(root,'artifacts/clinical-history-check.json'),JSON.stringify({batch:191,checks:passed.length,passed,isolatedDatabase:true,developmentBusinessWrites:false,newPermissions:false,checkedAt:new Date().toISOString()},null,2));console.log('Clinical history checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);await admin.end();}
