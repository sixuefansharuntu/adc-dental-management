import pg from'pg';import{writeFile}from'node:fs/promises';import{join}from'node:path';import{config,pgOptions,root,seedReportDirectory}from'./config.mjs';import{fixtureId as id}from'./seed.mjs';import{credentialHash}from'../apps/api/src/auth.service.ts';
export async function seedFollowup(){const env=await config(),c=new pg.Client(pgOptions(env));await c.connect();const east=id('clinic-east'),bootstrap=id('booking-bootstrap');async function put(table:string,data:Record<string,unknown>){const k=Object.keys(data);await c.query(`INSERT INTO adc.${table}(${k.join(',')}) VALUES(${k.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT DO NOTHING`,Object.values(data));}
 try{await c.query('BEGIN');await c.query('SELECT pg_advisory_xact_lock(173001)');const nurseRv=id('rolev173-nurse');await put('role_version',{role_version_id:nurseRv,role_id:id('role171-nurse'),version_no:3,name:'诊疗影像加工与诊后随访 nurse',configured_by:bootstrap,configured_at:new Date()});for(const fn of[...(await c.query('SELECT function_code FROM adc.role_function WHERE role_version_id=$1',[id('rolev172-nurse')])).rows.map(x=>x.function_code),'followup.read','followup.manage','followup.plan.read'])await put('role_function',{role_version_id:nurseRv,function_code:fn});const grant=id('grant173-nurse');await put('access_grant',{grant_id:grant,account_id:id('account171-nurse'),version_no:3,effective_from:'2026-10-25T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:grant,role_version_id:nurseRv});await put('grant_clinic',{grant_id:grant,clinic_id:east});const fields=(await c.query('SELECT resource_code,field_code FROM adc.grant_field WHERE grant_id=$1',[id('grant172-nurse')])).rows.map(x=>[x.resource_code,x.field_code]);fields.push(['followup','task'],['followup','contact'],['followup','issue']);for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(grant+r+f),grant_id:grant,resource_code:r,field_code:f,action_code:'maintain'});
  for(const[key,name,login,password,functions,fields]of[['manager','诊所管理人员（合成）','manager.east',env.ADC_MANAGER_EAST_PASSWORD,['followup.plan.read','followup.plan.manage'],[['followup_plan','config']]],['assist','随访协助前台（合成）','followup.assist',env.ADC_FOLLOWUP_ASSIST_PASSWORD,['followup.read','followup.manage','followup.assist','followup.plan.read'],[['followup','task'],['followup','contact'],['followup','issue']]]]as const){const employee=id('employee173-'+key),account=id('account173-'+key),role=id('role173-'+key),rv=id('rolev173-'+key),g=id('grant173-'+key);await put('employee',{employee_id:employee,name,employment_arrangement:JSON.stringify({assignments:[{clinicId:east,role:key==='manager'?'manager':'frontdesk',from:'2026-01-01',to:null}]}),row_version:1,public_enabled:false});await put('staff_account',{account_id:account,employee_id:employee,login_name:login,credential_verifier:await credentialHash(password!),activation_arrangement:'enabled',opened_at:new Date(),maintained_by:bootstrap,maintained_at:new Date(),row_version:1});await put('security_role',{role_id:role,name, row_version:1});await put('role_version',{role_version_id:rv,role_id:role,version_no:1,name,configured_by:bootstrap,configured_at:new Date()});for(const fn of functions)await put('role_function',{role_version_id:rv,function_code:fn});await put('access_grant',{grant_id:g,account_id:account,version_no:1,effective_from:'2026-10-25T00:00:00Z',configured_by:bootstrap,configured_at:new Date()});await put('grant_role',{grant_id:g,role_version_id:rv});await put('grant_clinic',{grant_id:g,clinic_id:east});for(const[r,f]of fields)await put('grant_field',{grant_field_id:id(g+r+f),grant_id:g,resource_code:r,field_code:f,action_code:'maintain'});}
  await c.query('COMMIT');
 }catch(e){await c.query('ROLLBACK');throw e;}finally{await c.end();}await writeFile(join(await seedReportDirectory(env),'随访演示账号.txt'),`ADC本机诊后随访（全部合成，不要提交）\n入口：http://127.0.0.1:5173/\n诊所方案配置：manager.east，口令：${env.ADC_MANAGER_EAST_PASSWORD}\n授权协助前台：followup.assist，口令：${env.ADC_FOLLOWUP_ASSIST_PASSWORD}\n护士nurse.east沿用诊疗演示账号.txt。普通front.east没有随访权限；医生不直接操作随访，临床处理回诊疗用例。没有实际拨号或发送消息。\n`,'utf8');console.log('Followup grants versioned; manager and assistant credentials saved privately; no tasks or clinical rules fabricated.');
}if(process.argv[1]?.endsWith('seed-followup.mts'))seedFollowup().catch(e=>{console.error(e.message);process.exitCode=1;});

