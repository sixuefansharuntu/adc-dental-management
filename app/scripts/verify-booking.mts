 });
 await check('员工按诊所和功能供阅，患者不能访问员工接口',async()=>{const x=await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,east);assert.equal(x.status,200);assert.equal(x.json.items.length,1);assert.equal((await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,west)).json.items.length,0);assert.equal((await call(`/staff/appointments?date=${env.BOOKING_DEMO_DATE}&clinicId=${service.clinicId}`,undefined,west)).status,403);assert.equal((await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,a)).status,401);const none=await login('staff','staff.none',env.ADC_STAFF_NONE_PASSWORD!);assert.equal((await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,none)).status,403);});
 await check('账号停用与授权撤销立即约束旧会话',async()=>{await db.pool.query("UPDATE adc.staff_account SET activation_arrangement='disabled' WHERE login_name='front.east'");assert.equal((await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,east)).status,401);await db.pool.query("UPDATE adc.staff_account SET activation_arrangement='enabled' WHERE login_name='front.east'");await db.pool.query('UPDATE adc.access_grant SET effective_to=clock_timestamp() WHERE account_id=$1',[id('account-front-east')]);assert.equal((await call('/staff/appointments?date='+env.BOOKING_DEMO_DATE,undefined,east)).status,403);await db.pool.query('UPDATE adc.access_grant SET effective_to=NULL WHERE account_id=$1',[id('account-front-east')]);});
 const ccmd={version:1,requestId:randomUUID(),reason:'计划变更（合成）'};
 await check('取消保存状态历史释放占用；重试不误释放后来他人的预约',async()=>{const x=await call(`/patient/appointments/${first.id}/cancel`,ccmd,winner);assert.equal(x.status,201);assert.equal(x.json.disposition,'cancelled');const r=await call('/patient/appointments',command(group),loser);assert.equal(r.status,201);first.replacement=r.json;const again=await call(`/patient/appointments/${first.id}/cancel`,ccmd,winner);assert.equal(again.json.repeated,true);assert.equal((await db.pool.query('SELECT disposition FROM adc.appointment WHERE appointment_id=$1',[r.json.id])).rows[0].disposition,'active');});
 let moved:any;
 await check('改约失败保原约，成功共同换时间并保留原版',async()=>{const original=first.replacement;const bad={...command(otherAvail.json.groups[0]),version:original.version,startsAt:'2026-01-01T01:00:00.000Z'};assert.equal((await call(`/patient/appointments/${original.id}/reschedule`,bad,loser)).status,409);assert.equal((await db.pool.query('SELECT scheduled_at FROM adc.appointment WHERE appointment_id=$1',[original.id])).rows[0].scheduled_at.toISOString(),original.startsAt);const good={...command(group,2),version:original.version};const r=await call(`/patient/appointments/${original.id}/reschedule`,good,loser);assert.equal(r.status,201);moved=r.json;assert.equal(moved.version,2);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision WHERE appointment_id=$1',[original.id])).rows[0].n,2);const retry=await call('/patient/appointments',firstCommand,winner);assert.equal(retry.json.version,1);assert.equal(retry.json.disposition,'active');assert.equal(retry.json.originalResult,true);});
 await check('注入写入后故障，预约历史及请求全部回滚',async()=>{const actor=await auth.patient({headers:{cookie:winner}} as any);const input=command(group,4);const {bookingInput}=await import('../apps/api/src/booking-domain.ts');const before=(await db.pool.query('SELECT count(*)::int n FROM adc.appointment')).rows[0].n;await assert.rejects(()=>booking.command(actor,'book',bookingInput(input,true),undefined,async()=>{throw Error('intentional fault');}),/intentional fault/);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.appointment')).rows[0].n,before);assert.equal((await db.pool.query('SELECT 1 FROM adc.command_dedup WHERE request_key=$1',[input.requestId])).rowCount,0);});
 await check('同一预约取消与改约并发只有一笔生效',async()=>{const created=await call('/patient/appointments',command(group,4),winner);assert.equal(created.status,201);const results=await Promise.all([call(`/patient/appointments/${created.json.id}/cancel`,{requestId:randomUUID(),version:1,reason:'并发取消'},winner),call(`/patient/appointments/${created.json.id}/reschedule`,{...command(group,5),version:1},winner)]);assert.deepEqual(results.map(x=>x.status).sort(),[201,409]);assert.equal((await db.pool.query('SELECT row_version::int v FROM adc.appointment WHERE appointment_id=$1',[created.json.id])).rows[0].v,2);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision WHERE appointment_id=$1',[created.json.id])).rows[0].n,2);});
 await check('库存身份空批号效期采用基线NULLS_EQUAL语义',async()=>{const r=await db.pool.query("SELECT i.indnullsnotdistinct AS value FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid WHERE c.relname='stock_identity_nulls_equal' AND c.relnamespace='adc'::regnamespace");assert.equal(r.rows[0].value,true);});
 await check('原截止与当前状态校验：到院和已截止不得自助取消',async()=>{await db.pool.query("UPDATE adc.appointment SET disposition='arrived',row_version=3 WHERE appointment_id=$1",[moved.id]);assert.equal((await call(`/patient/appointments/${moved.id}/cancel`,{version:3,requestId:randomUUID(),reason:'状态边界'},loser)).status,409);await db.pool.query("UPDATE adc.appointment SET disposition='active',cancel_cutoff_at=clock_timestamp(),row_version=4 WHERE appointment_id=$1",[moved.id]);assert.equal((await call(`/patient/appointments/${moved.id}/cancel`,{version:4,requestId:randomUUID(),reason:'截止边界'},loser)).status,409);});
 await check('已采用规则更新不覆盖旧截止，新提交拒绝旧规则版',async()=>{const old=(await db.pool.query('SELECT cancel_cutoff_at FROM adc.appointment WHERE appointment_id=$1',[first.id])).rows[0];await db.pool.query('INSERT INTO adc.clinic_booking_rule_version VALUES($1,$2,2,clock_timestamp(),180,180,true,$3,clock_timestamp())',[randomUUID(),service.clinicId,id('booking-bootstrap')]);assert.equal((await call('/patient/appointments',command(group,4),winner)).status,409);assert.deepEqual((await db.pool.query('SELECT cancel_cutoff_at FROM adc.appointment WHERE appointment_id=$1',[first.id])).rows[0],old);});
 await check('暂停或无有效执业不发布为可约，不自动取消已有预约',async()=>{await db.pool.query("UPDATE adc.doctor_schedule SET public_status='paused' WHERE schedule_id=$1",[group.scheduleId]);const r=await call(`/availability?date=${env.BOOKING_DEMO_DATE}&doctorId=${service.doctorId}&serviceVersionId=${service.serviceVersionId}`);assert.ok(r.json.groups[0].slots.every((s:any)=>s.status==='paused'));assert.equal((await db.pool.query('SELECT disposition FROM adc.appointment WHERE appointment_id=$1',[moved.id])).rows[0].disposition,'active');{const fc=await db.pool.connect();try{await fc.query('BEGIN');const op=randomUUID();await fc.query("INSERT INTO adc.business_operation(operation_id,actor_id,occurred_at,action_code,subject_kind,subject_key,reason) VALUES($1,$2,clock_timestamp(),'fixture.practice.disable','employee',$3,'isolated fixture respects current practice revision guard')",[op,id('booking-bootstrap'),river.doctorId]);const ps=(await fc.query("UPDATE adc.practice_assignment SET practice_arrangement='disabled',row_version=row_version+1,updated_at=date_trunc('milliseconds',clock_timestamp()) WHERE employee_id=$1 RETURNING practice_id",[river.doctorId])).rows;const {FrontdeskService}=await import('../apps/api/src/frontdesk.service');for(const p of ps)await app.get(FrontdeskService).snapshot(fc,'practice',p.practice_id,op);await fc.query('COMMIT');}catch(e){await fc.query('ROLLBACK');throw e;}finally{fc.release();}}const r2=await call(`/availability?date=${env.BOOKING_DEMO_DATE}&doctorId=${river.doctorId}&serviceVersionId=${river.serviceVersionId}`);assert.ok(r2.json.groups.every((g:any)=>g.slots.every((s:any)=>s.status==='closed')));});
 await check('预约和规则原版不可覆盖；登出失效',async()=>{await assert.rejects(()=>db.pool.query('DELETE FROM adc.appointment_revision WHERE appointment_id=$1',[first.id]),/immutable/);assert.equal((await call('/patient/logout',{},a)).status,201);assert.equal((await call('/patient/appointments',undefined,a)).status,401);});
 await check('完整166源文件19项哈希保持',async()=>{const dir=join(root,'../output/pdf/ADC-完整设计基线166');const manifest=JSON.parse(await readFile(join(dir,'基线文件清单.json'),'utf8'));for(const [p,hash]of Object.entries(manifest.files))assert.equal(createHash('sha256').update(await readFile(join(dir,p))).digest('hex'),hash,p);});
 await writeFile(join(root,'artifacts','booking-check.json'),JSON.stringify({batch:169,baseline:166,checks:passed.length,passed,testDatabase:'isolated temporary PostgreSQL database, dropped after checks',wechatTested:false,cloudDeployed:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));
 console.log('Booking integration checks passed:',passed.length);
}finally{
 if(app)await app.close();process.env.PGDATABASE=originalDb;
 await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[testDb]);await admin.query(`DROP DATABASE "${testDb}"`);await admin.end();
