 await check('重复10次仅保存一版；相同键不同载荷拒绝',async()=>{for(let i=0;i<10;i++){const r=await call('/patient/appointments',firstCommand,winner);assert.equal(r.status,201);assert.equal(r.json.repeated,true);assert.equal(r.json.id,first.id);}assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.appointment_revision WHERE appointment_id=$1',[first.id])).rows[0].n,1);assert.equal((await call('/patient/appointments',{...firstCommand,intention:'changed'},winner)).status,409);});
 await check('查询不占位；占满后刷新显示已约满',async()=>{const r=await call(`/availability?date=${env.BOOKING_DEMO_DATE}&doctorId=${service.doctorId}&serviceVersionId=${service.serviceVersionId}`);assert.equal(r.json.groups[0].slots[0].status,'full');assert.equal((await call('/quote',pick(group))).status,409);});
 await check('本人隔离：他人看不到也不能取消原预约，跨主体请求键不泄露结果',async()=>{assert.equal((await call('/patient/appointments',undefined,loser)).json.length,0);assert.equal((await call(`/patient/appointments/${first.id}/cancel`,{version:1,requestId:randomUUID(),reason:'越权测试'},loser)).status,404);assert.equal((await call('/patient/appointments',firstCommand,loser)).status,409);});
 const otherAvail=await call(`/availability?date=${env.BOOKING_DEMO_DATE}&doctorId=${other.doctorId}&serviceVersionId=${other.serviceVersionId}`);
 await check('同主体跨医生重叠被拒，返回本人预约时间和医生，原预约保持',async()=>{
  const conflict=await call('/patient/appointments',command(otherAvail.json.groups[0]),winner);
