 let a='',b='',east='',west='';
 await check('独立患者与员工登录，错误凭据与跨来源拒绝',async()=>{assert.equal((await call('/patient/session',{loginName:'alice',password:'wrong'})).status,401);a=await login('patient','alice',env.ADC_PATIENT_A_PASSWORD!);b=await login('patient','bob',env.ADC_PATIENT_B_PASSWORD!);east=await login('staff','front.east',env.ADC_STAFF_EAST_PASSWORD!);west=await login('staff','front.river',env.ADC_STAFF_RIVER_PASSWORD!);assert.equal((await call('/quote',pick(group),a,'http://foreign.invalid')).status,403);assert.equal((await call('/staff/session',undefined,a)).status,401);});
 let first:any,winner='',loser='',firstCommand:any;
