 app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1';const db=app.get(DatabaseService);const booking=app.get(BookingService);const auth=app.get(AuthService);
 async function call(path:string,body?:any,cookie='',origin=env.ADMIN_ORIGIN){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:origin}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return {status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||'',header:r.headers.get('set-cookie')||''};}
