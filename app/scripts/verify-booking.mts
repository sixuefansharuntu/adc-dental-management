 await check('空测试库可迁移：116表866列321单列及29组合外键',async()=>{assert.equal((await db.pool.query("SELECT count(*)::int AS n FROM information_schema.tables WHERE table_schema='adc'")).rows[0].n,116);assert.equal((await db.pool.query("SELECT count(*)::int AS n FROM information_schema.columns WHERE table_schema='adc'")).rows[0].n,866);const f=await db.pool.query("SELECT array_length(conkey,1) AS arity FROM pg_constraint WHERE contype='f' AND connamespace='adc'::regnamespace");assert.equal(f.rows.filter((r:any)=>r.arity===1).length,321);assert.equal(f.rows.filter((r:any)=>r.arity>1).length,29);});
 const catalogue=await call('/catalogue');const service=catalogue.json.items.find((x:any)=>x.doctorName==='林医生');const other=catalogue.json.items.find((x:any)=>x.doctorName==='周医生');const river=catalogue.json.items.find((x:any)=>x.doctorName==='陈医生');
 const avail=await call(`/availability?date=${env.BOOKING_DEMO_DATE}&doctorId=${service.doctorId}&serviceVersionId=${service.serviceVersionId}`);assert.equal(avail.status,200);const group=avail.json.groups[0];
