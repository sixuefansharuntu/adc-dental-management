let app:any;const passed:string[]=[],evidence:any={};let reads=0,writes=0;const ok=(r:any,status=201)=>assert.equal(r.status,status,JSON.stringify(r.json));async function check(label:string,f:()=>Promise<void>){await f();passed.push(label);console.log('PASS',label);}
try{
 await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();await seedQuality();await seedBusiness();
 const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),east=id('clinic-east'),lin=id('booking-lin'),nurseId=id('nurse-east-a');
 async function call(path:string,body?:any,cookie=''){body?writes++:reads++;const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(body?{Origin:env.ADMIN_ORIGIN}:{}),...(cookie?{Cookie:cookie}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}
 async function login(kind:string,loginName:string,password:string){const r=await call('/'+kind+'/session',{loginName,password});ok(r);return r.cookie;}
 const front=await login('staff','front.east',env.ADC_STAFF_EAST_PASSWORD!),store=await login('staff','stock.east',env.ADC_STOCK_EAST_PASSWORD!),river=await login('staff','stock.river',env.ADC_STOCK_RIVER_PASSWORD!),manager=await login('staff','manager.east',env.ADC_MANAGER_EAST_PASSWORD!),finance=await login('staff','finance.hq',env.ADC_FINANCE_PASSWORD!);const at=()=>new Date(Date.now()-1).toISOString();
 let material:any,supplier:any,receipt:any,issue:any,issueCommand:any,sale:any,deliveryCommand:any,paymentCommand:any,count:any,quarterId:string;let stockId:string,patientId:string;
 const stock=async()=>(await db.pool.query('SELECT * FROM adc.stock_balance WHERE stock_id=$1',[stockId])).rows[0];
