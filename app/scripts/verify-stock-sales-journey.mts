 await check('建立同一批物资，真实入库20且重放只作用一次',async()=>{const s=await call('/inventory/suppliers',{requestId:randomUUID(),clinicId:east,name:'合成贯通供应商271',enabled:true},store);ok(s);supplier=s.json;const m=await call('/inventory/materials',{requestId:randomUUID(),clinicId:east,name:'合成通用物资271',classification:'课程物资商品',unit:'盒',specification:'合成规格',enabled:true},store);ok(m);material=m.json;const b={requestId:randomUUID(),clinicId:east,materialId:material.id,supplierId:supplier.id,batch:'BATCH271',expiresOn:null,unit:'盒',quantity:'20',receivedAt:at(),unitPrice:'5',sourceReference:'271-RECEIPT#1',actualConfirmed:true},r=await call('/inventory/receipts',b,store);ok(r);receipt=r.json;stockId=receipt.stockId;for(let n=0;n<3;n++)ok(await call('/inventory/receipts',b,store));assert.equal((await stock()).quantity,'20.0000');evidence.stockId=stockId;});
 await check('领用2成本10，权限及库存版本检查防误扣',async()=>{issueCommand={requestId:randomUUID(),issueId:null,version:0,stockId,stockVersion:Number((await stock()).row_version),recipientId:nurseId,unit:'盒',quantity:'2',issuedAt:at(),costUnitPrice:'5',pendingNote:null,actualConfirmed:true,reason:null,adjustmentIds:[]};ok(await call('/inventory/issues',issueCommand,front),403);ok(await call('/inventory/issues',issueCommand,river),403);const r=await call('/inventory/issues',issueCommand,store);ok(r);issue=r.json;for(let n=0;n<3;n++)ok(await call('/inventory/issues',issueCommand,store));assert.equal((await stock()).quantity,'18.0000');const x=(await db.pool.query('SELECT quantity,cost_unit_price FROM adc.material_issue WHERE issue_id=$1',[issue.id])).rows[0];assert.equal(x.quantity,'2.0000');assert.equal(x.cost_unit_price,'5.0000');evidence.initialIssueCost='10.00';});
 await check('独立商品开单3盒30元，开单不占用或扣库存',async()=>{const p=await call('/frontdesk/patients',{requestId:randomUUID(),clinicId:east,name:'合成物资商品患者271',phone:'13800000271',identityBasis:'合成本人资料核实271'},front);ok(p);patientId=p.json.id;const b={clinicId:east,patientId,lines:[{materialId:material.id,quantity:'3',unitPrice:'10'}]},q=await call('/sales/quote',b,front);ok(q);const command={...b,requestId:randomUUID(),quoteToken:q.json.token},r=await call('/sales',command,front);ok(r);sale=r.json;for(let n=0;n<3;n++)ok(await call('/sales',command,front));assert.equal((await stock()).quantity,'18.0000');const v=await saleView();assert.equal(v.total,'30.00');assert.equal(v.deliveryState,'pending');assert.equal(v.paymentState,'unpaid');evidence.saleId=sale.id;});
 await check('盘点固定领用后基线，交付只扣3且不生成重复领用',async()=>{const c=await call('/inventory/counts',{requestId:randomUUID(),clinicId:east,stockIds:[stockId],scopeNote:'合成商品交付期间盘点271'},store);ok(c);count=c.json;const v=await saleView();deliveryCommand={requestId:randomUUID(),version:v.version,deliveredAt:at(),actualDelivered:true,allocationsConfirmed:true,basis:'合成已核实全单实际交付3盒',allocations:v.lines.map((l:any)=>({lineId:l.id,stockId,stockVersion:Number(0),quantity:l.quantity}))};deliveryCommand.allocations[0].stockVersion=Number((await stock()).row_version);ok(await call('/sales/'+sale.id+'/delivery',deliveryCommand,store),403);ok(await call('/sales/'+sale.id+'/delivery',deliveryCommand,front));for(let n=0;n<3;n++)ok(await call('/sales/'+sale.id+'/delivery',deliveryCommand,front));assert.equal((await stock()).quantity,'15.0000');assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.material_issue')).rows[0].n,1);const after=await saleView();assert.equal(after.deliveryState,'delivered');assert.equal(after.paymentState,'unpaid');});
 await check('交付后未收款，日报区分已开单和实收',async()=>{const day=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}),b={dimension:'daily',clinicIds:[east],fromDay:day,toDay:day,employeeId:null,itemKey:null};evidence.reportFilter=b;const r=await call('/business/reports',b,front);ok(r);const t=r.json.snapshot.report.totals;assert.equal(t.knownOpenedAmount,'30.00');assert.equal(t.receivedAmount,'0.00');assert.equal(t.knownUnpaidOpenedAmount,'30.00');evidence.unpaidDaily={opened:t.knownOpenedAmount,received:t.receivedAmount,unpaid:t.knownUnpaidOpenedAmount};});
 await check('前台登记全额实收30，重放不重复收款或扣库存',async()=>{const v=await saleView();paymentCommand={requestId:randomUUID(),version:v.version,amount:'30.00',paymentMethod:'cash',receivedAt:at(),actualReceived:true,basis:'仅合成已收到全额事实，不执行真实扣款'};ok(await call('/sales/'+sale.id+'/receipt',{...paymentCommand,amount:'29.00'},front),409);ok(await call('/sales/'+sale.id+'/receipt',paymentCommand,front));for(let n=0;n<3;n++)ok(await call('/sales/'+sale.id+'/receipt',paymentCommand,front));assert.equal((await stock()).quantity,'15.0000');assert.equal((await saleView()).paymentState,'paid');const r=await call('/business/reports',evidence.reportFilter,front);ok(r);const t=r.json.snapshot.report.totals;assert.equal(t.receivedAmount,'30.00');assert.equal(t.knownUnpaidOpenedAmount,'0.00');evidence.paidDaily={opened:t.knownOpenedAmount,received:t.receivedAmount,unpaid:t.knownUnpaidOpenedAmount};});
 await check('盘点按期间交付减3得15，无差异不补造库存调整',async()=>{const d=await call('/inventory/counts/'+count.id,undefined,store);ok(d,200);ok(await call('/inventory/counts/'+count.id+'/observations',{requestId:randomUUID(),version:1,lines:[{id:d.json.lines[0].stocktake_line_id,countedAt:at(),quantity:'15',reason:'合成盘点已知入20领2交3余15'}]},store));const p=await call('/inventory/counts/'+count.id+'/preview',undefined,store);ok(p,200);assert.equal(p.json.lines[0].period,'-3.0000');assert.equal(p.json.lines[0].delta,'0.0000');evidence.stocktake={period:p.json.lines[0].period,delta:p.json.lines[0].delta};});
 await check('入库补价为6不改已核实领用成本，不重复改库存',async()=>{const b={requestId:randomUUID(),version:1,unitPrice:'6',pendingNote:null,reason:'合成核实原进货单价更正至6'};ok(await call('/inventory/receipts/'+receipt.id+'/price',b,store));for(let n=0;n<3;n++)ok(await call('/inventory/receipts/'+receipt.id+'/price',b,store));assert.equal((await stock()).quantity,'15.0000');assert.equal((await db.pool.query('SELECT cost_unit_price FROM adc.material_issue WHERE issue_id=$1',[issue.id])).rows[0].cost_unit_price,'5.0000');});
 await check('领用成本另行明确更正12，仅存新原版不再扣2',async()=>{const r=await call('/inventory/issues',{...issueCommand,requestId:randomUUID(),issueId:issue.id,version:1,stockVersion:Number((await stock()).row_version),costUnitPrice:'6',reason:'合成另行核实原领用采用成本6，数量仍2'},store);ok(r);assert.equal((await stock()).quantity,'15.0000');const rows=(await db.pool.query('SELECT version_no,cost_unit_price,quantity FROM adc.issue_revision WHERE issue_id=$1 ORDER BY version_no',[issue.id])).rows;assert.equal(rows.length,2);assert.deepEqual(rows.map(x=>x.cost_unit_price),['5.0000','6.0000']);assert.ok(rows.every(x=>x.quantity==='2.0000'));evidence.correctedIssueCost='12.00';});
 await check('同批库存台账数量守恒，交付与实收原版均指原销售',async()=>{const rows=(await db.pool.query('SELECT quantity_delta,stock_version_before,stock_version_after FROM adc.stock_movement WHERE stock_id=$1 ORDER BY stock_version_after',[stockId])).rows;assert.equal(rows.length,3);assert.deepEqual(rows.map(x=>x.quantity_delta),['20.0000','-2.0000','-3.0000']);assert.equal(rows.reduce((a,x)=>a+Number(x.quantity_delta),0),15);const x=(await db.pool.query(`SELECT d.stock_id,d.delivered_quantity,l.sale_id,r.amount,r.sale_revision_id,sr.sale_id AS original_sale FROM adc.product_delivery_line d JOIN adc.product_sale_line l USING(sale_line_id) JOIN adc.receipt_revision r ON r.sale_id=l.sale_id JOIN adc.sale_revision sr ON sr.sale_revision_id=r.sale_revision_id WHERE l.sale_id=$1`,[sale.id])).rows;assert.equal(x.length,1);assert.equal(x[0].stock_id,stockId);assert.equal(x[0].original_sale,sale.id);assert.equal(x[0].amount,'30.00');evidence.movements=rows;evidence.lineage=x[0];});
 await check('季度来源采用更正领用原版成本12和商品实收30，无交付重复成本',async()=>{const now=new Date(),year=Number(now.toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}).slice(0,4)),quarter=Math.floor((Number(now.toLocaleDateString('en-CA',{timeZone:'Asia/Shanghai'}).slice(5,7))-1)/3)+1,c=(await call('/quarter/candidates?year='+year+'&quarter='+quarter,undefined,finance)).json,scope=c.clinics.find((x:any)=>x.id===east),r=await call('/quarter',{requestId:randomUUID(),year,quarter,scopes:[{clinicId:east,doctorIds:scope.doctors.map((x:any)=>x.id)}],scopeConfirmed:true},finance);ok(r);quarterId=r.json.id;const p=await call('/quarter/'+quarterId+'/prepare?clinicId='+east,undefined,manager);ok(p,200);assert.deepEqual(p.json.blockers,[]);assert.equal(p.json.sources.length,2);assert.equal(p.json.sources.find((x:any)=>x.kind==='issue').amount,'12.00');assert.equal(p.json.sources.find((x:any)=>x.kind==='issue').version,2);assert.equal(p.json.sources.find((x:any)=>x.kind==='sale').amount,'30.00');evidence.quarterSources=p.json.sources.map(({kind,id,amount,version}:any)=>({kind,id,amount,version}));});
 await writeFile(join(root,'artifacts/stock-sales-journey-check.json'),JSON.stringify({batch:271,checks:passed.length,passed,evidence,isolatedDatabase:name,http:{get:reads,post:writes},browserPerformed:false,realPayment:false,fullUseCaseAcceptance:false,checkedAt:new Date().toISOString()},null,2));console.log('Stock sales journey checks passed:',passed.length);
}finally{if(app)await app.close();process.env.PGDATABASE=original;await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);await admin.end();delete process.env.ADC_ISOLATED_SEED_REPORTS;await rm(folder,{recursive:true,force:true});}

