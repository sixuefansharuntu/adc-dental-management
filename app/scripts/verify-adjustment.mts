async function submitBoth(qid:string,adjustmentId?:string){ok(await call('/quarter/'+qid+'/submissions',await submission(qid,east,manager,adjustmentId),manager));ok(await call('/quarter/'+qid+'/submissions',await submission(qid,river,managerR,adjustmentId),managerR));}
async function calc(qid:string,adj?:string,reason:string|null=null){const b=await call('/quarter/'+qid+'/basis',undefined,fin);ok(b,200);const x={basisToken:b.json.token,policyId:id('policy176-core'),allocations:b.json.sources.map((s:any)=>({kind:s.kind,sourceId:s.id,doctorId:id('booking-lin'),amount:s.amount,basis:'本机合成费用按明确实际分配归属'})),...(adj?{adjustmentId:adj}:{})},p=await call('/quarter/'+qid+'/preview',x,fin);ok(p);return{...x,requestId:randomUUID(),previewToken:p.json.token,reason};}
async function review(rid:string,decision='confirm'){const r=await call('/quarter/results/'+rid,undefined,head);ok(r,200);return{requestId:randomUUID(),reviewToken:r.json.reviewToken,decision,opinion:'合成核对全部原范围及本版实际依据',explicitDecision:true};}
for(const qid of[q3,q2]){await submitBoth(qid);const r=await call('/quarter/'+qid+'/results',await calc(qid),fin);ok(r);ok(await call('/quarter/results/'+r.json.resultId+'/review',await review(r.json.resultId),head));}
original3=(await call('/quarter/'+q3,undefined,head)).json;original2=(await call('/quarter/'+q2,undefined,head)).json;first3=original3.quarter;first2=original2.quarter;const oldResult3=original3.results[0].result_id,oldPlan=(await call('/quarter/results/'+oldResult3,undefined,head)).json.plan,oldHash=createHash('sha256').update(JSON.stringify(oldPlan)).digest('hex');
