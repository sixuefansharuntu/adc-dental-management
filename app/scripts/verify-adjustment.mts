await check('记录调整全写后故障回滚轮次与成功请求',async()=>{const actor=await auth.staff({headers:{cookie:head}}as any);await assert.rejects(()=>service.openAdjustment(actor,q3,opening(),async()=>{throw Error('intentional adjustment fault');}),/intentional adjustment fault/);assert.equal((await call('/quarter/'+q3,undefined,head)).json.adjustments.active,null);});
await check('同一基准轮次只一个，原请求10次重试不重复',async()=>{const b=opening(),r=await call('/quarter/'+q3+'/adjustment',b,head);ok(r);round3=r.json.adjustmentId;for(let i=0;i<10;i++)assert.equal((await call('/quarter/'+q3+'/adjustment',b,head)).json.repeated,true);ok(await call('/quarter/'+q3+'/adjustment',opening(),head),409);const r2=await call('/quarter/'+q2+'/adjustment',opening(original2.results[0].result_id),head);ok(r2);round2=r2.json.adjustmentId;});
await check('普通费用入口、遗漏轮次及无调整依据仍拒补改',async()=>{ok(await call('/quarter/expenses',ex({id:e3.json.id,version:1,amount:'40.00',reason:'本机合成核实'}),fin),409);ok(await call('/quarter/expenses',ex({id:e3.json.id,version:1,amount:'40.00',adjustmentIds:[round3]}),fin),400);ok(await call('/quarter/expenses',ex({id:e3.json.id,version:1,amount:'40.00',reason:'合成更正',adjustmentIds:[round2]}),fin),409);});
await check('费用补正写后故障不留下新事实或原版',async()=>{const a=await auth.staff({headers:{cookie:fin}}as any);await assert.rejects(()=>service.expense(a,ex({id:e3.json.id,version:1,amount:'40.00',reason:'合成更正',adjustmentIds:[round3]}),async()=>{throw Error('intentional expense adjustment');}),/intentional expense adjustment/);assert.equal((await db.pool.query('SELECT row_version,amount FROM adc.operating_expense WHERE expense_id=$1',[e3.json.id])).rows[0].amount,'30.00');});
await check('明确本轮更正费用保原版且不改旧确认快照',async()=>{ok(await call('/quarter/expenses',ex({id:e3.json.id,version:1,amount:'40.00',reason:'合成核对凭据，实际金额更正为40',adjustmentIds:[round3]}),fin));assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.expense_revision WHERE expense_id=$1',[e3.json.id])).rows[0].n,2);const p=(await call('/quarter/results/'+oldResult3,undefined,head)).json.plan;assert.equal(createHash('sha256').update(JSON.stringify(p)).digest('hex'),oldHash);});
await check('跨季费用日期更正须原新已确认两季轮次齐全',async()=>{const b=ex({id:e2.json.id,version:1,amount:'10.00',voucherReference:'DEMO-178-Q2#1',occurredOn:'2026-09-15',reason:'合成复核实际日期属于Q3',adjustmentIds:[round3]});ok(await call('/quarter/expenses',b,fin),409);ok(await call('/quarter/expenses',{...b,requestId:randomUUID(),adjustmentIds:[round2,round3]},fin));});
await check('跨季补录费用须明确实际依据及当前调整轮次',async()=>{ok(await call('/quarter/expenses',ex({amount:'5.00',voucherReference:'DEMO-178-LATE#1',reason:'合成实际费用晚录',adjustmentIds:[round3]}),fin));const p=(await call('/quarter/'+q3+'/prepare?clinicId='+east,undefined,manager)).json;assert.equal(p.sources.reduce((n:number,s:any)=>n+Number(s.amount),0),55);});
await check('未变化诊所也须本轮重提，不混用首次确认提交',async()=>{let b=(await call('/quarter/'+q3+'/basis',undefined,fin)).json;assert.ok(b.blockers.length>=2);ok(await call('/quarter/'+q3+'/submissions',await submission(q3),manager),409);ok(await call('/quarter/'+q3+'/submissions',await submission(q3,east,manager,round3),manager));b=(await call('/quarter/'+q3+'/basis',undefined,fin)).json;assert.ok(b.blockers.some((x:string)=>x.includes('滨江')));ok(await call('/quarter/'+q3+'/submissions',await submission(q3,river,managerR,round3),managerR));const d=(await call('/quarter/'+q3,undefined,head)).json;assert.equal(d.submissions.filter((s:any)=>Number(s.version_no)===2).length,2);});
await check('无轮次或无原因不能生成调整结果，新版明确前版及轮次',async()=>{const cmd=await calc(q3,round3,'合成费用40+10+5，完整范围重新核算');ok(await call('/quarter/'+q3+'/results',{...cmd,adjustmentId:undefined},fin),409);ok(await call('/quarter/'+q3+'/results',{...cmd,requestId:randomUUID(),reason:null},fin),400);const r=await call('/quarter/'+q3+'/results',cmd,fin);ok(r);result2=r.json.resultId;const d=(await call('/quarter/results/'+result2,undefined,head)).json;assert.equal(d.result.previous_result_id,oldResult3);assert.equal(d.plan.adjustmentId,round3);assert.equal(d.plan.lines.find((l:any)=>l.doctorId===id('booking-lin')).contribution,'-55.00');assert.equal(d.result.review_state,'pending_review');});
await check('待复核调整版期间费用写入被阻止，不悄悄混入来源',async()=>{ok(await call('/quarter/expenses',ex({id:e3.json.id,version:2,amount:'41.00',reason:'本机合成再次核实',adjustmentIds:[round3]}),fin),409);});
await check('总部退回终结待复核版后，费用补正须重新提交另版',async()=>{ok(await call('/quarter/results/'+result2+'/review',await review(result2,'return'),head));ok(await call('/quarter/expenses',ex({id:e3.json.id,version:2,amount:'41.00',reason:'合成复查实际金额41，保留前版40',adjustmentIds:[round3]}),fin));const b=(await call('/quarter/'+q3+'/basis',undefined,fin)).json;assert.ok(b.blockers.some((x:string)=>x.includes('来源已变化')));await submitBoth(q3,round3);const r=await call('/quarter/'+q3+'/results',await calc(q3,round3,'根据退回意见保留原范围，费用41+10+5'),fin);ok(r);result3=r.json.resultId;const d=(await call('/quarter/results/'+result3,undefined,head)).json;assert.equal(d.result.version_no,'3');assert.equal(d.result.previous_result_id,result2);assert.equal(d.plan.lines.find((l:any)=>l.doctorId===id('booking-lin')).contribution,'-56.00');});
await check('调整确认失败回滚，原首次确认标记保持不变',async()=>{const a=await auth.staff({headers:{cookie:head}}as any);await assert.rejects(async()=>service.review(a,result3,await review(result3),async()=>{throw Error('intentional adjusted confirm');}),/intentional adjusted confirm/);const q=(await call('/quarter/'+q3,undefined,head)).json;assert.equal(q.quarter.first_full_confirmed_at,first3.first_full_confirmed_at);assert.equal(q.quarter.first_confirmed_result_id,oldResult3);assert.equal(q.results[0].review_state,'pending_review');});
await check('并发确认只一次，调整另版不重置首次时刻',async()=>{const b=await review(result3),rs=await Promise.all([call('/quarter/results/'+result3+'/review',b,head),call('/quarter/results/'+result3+'/review',{...b,requestId:randomUUID()},head)]);rs.forEach(r=>ok(r));const d=(await call('/quarter/'+q3,undefined,head)).json;assert.equal(d.adjustments.active,null);assert.equal(d.adjustments.latestConfirmedResultId,result3);assert.equal(d.quarter.first_full_confirmed_at,first3.first_full_confirmed_at);assert.equal(d.quarter.first_confirmed_result_id,oldResult3);assert.equal((await db.pool.query('SELECT count(*)::int n FROM adc.result_review WHERE result_id=$1',[result3])).rows[0].n,1);});
await check('原版与最新调整版各按采用来源供阅，不用当前值重算',async()=>{const old=(await call('/quarter/results/'+oldResult3,undefined,head)).json,latest=(await call('/quarter/results/'+result3,undefined,head)).json;assert.equal(createHash('sha256').update(JSON.stringify(old.plan)).digest('hex'),oldHash);assert.equal(old.result.review_state,'confirmed');assert.equal(latest.stale,false);assert.equal(latest.plan.lines.find((l:any)=>l.doctorId===id('booking-lin')).contribution,'-56.00');});
await check('原季移出后明确零业务，原范围完整核算并分别确认',async()=>{await submitBoth(q2,round2);const r=await call('/quarter/'+q2+'/results',await calc(q2,round2,'费用实际归Q3，Q2明确核实为零，保留全部牙医'),fin);ok(r);ok(await call('/quarter/results/'+r.json.resultId+'/review',await review(r.json.resultId),head));const d=(await call('/quarter/'+q2,undefined,head)).json;assert.equal(d.quarter.first_full_confirmed_at,first2.first_full_confirmed_at);assert.equal(d.doctors.length,3);const p=(await call('/quarter/results/'+r.json.resultId,undefined,head)).json.plan;assert.equal(p.lines.length,3);assert.ok(p.lines.every((x:any)=>x.contribution==='0.00'));});
