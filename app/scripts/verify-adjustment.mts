async function create(q:number){const cand=(await call('/quarter/candidates?year=2026&quarter='+q,undefined,fin)).json;const r=await call('/quarter',{requestId:randomUUID(),year:2026,quarter:q,scopes:cand.clinics.map((s:any)=>({clinicId:s.id,doctorIds:s.doctors.map((d:any)=>d.id)})),scopeConfirmed:true},fin);ok(r);return r.json.id;}
