import pg from'pg';import{randomUUID,createHash}from'node:crypto';import{readFile,writeFile}from'node:fs/promises';import{join}from'node:path';import assert from'node:assert/strict';import{config,pgOptions,root}from'./config.mjs';import{migrate}from'./migrate.mjs';import{seedBooking}from'./seed-booking.mts';import{seedFrontdesk}from'./seed-frontdesk.mts';import{seedClinical}from'./seed-clinical.mts';import{seedCare}from'./seed-care.mts';import{seedFollowup}from'./seed-followup.mts';import{seedInventory}from'./seed-inventory.mts';import{seedSales}from'./seed-sales.mts';import{seedQuarter}from'./seed-quarter.mts';import{fixtureId as id}from'./seed.mjs';
const env=await config();Object.assign(process.env,env);const original=env.PGDATABASE,name='adc_adjustment_test_'+Date.now();if(!/^adc_adjustment_test_\d+$/.test(name))throw Error('Bad test name');const admin=new pg.Client(pgOptions(env,'postgres'));await admin.connect();await admin.query(`CREATE DATABASE "${name}"`);process.env.PGDATABASE=name;let app:any;const passed:string[]=[];const ok=(r:any,s=201)=>assert.equal(r.status,s,JSON.stringify(r.json));async function check(n:string,f:()=>Promise<void>){await f();passed.push(n);console.log('PASS',n);}
try{await migrate();await seedBooking();await seedFrontdesk();await seedClinical();await seedCare();await seedFollowup();await seedInventory();await seedSales();await seedQuarter();const{createApp}=await import('../apps/api/src/app.ts'),{DatabaseService}=await import('../apps/api/src/database.service.ts'),{QuarterService}=await import('../apps/api/src/quarter.service.ts'),{AuthService}=await import('../apps/api/src/auth.service.ts');app=await createApp();await app.listen(0,'127.0.0.1');const base=(await app.getUrl())+'/api/v1',db=app.get(DatabaseService),service=app.get(QuarterService),auth=app.get(AuthService),east=id('clinic-east'),river=id('clinic-river');
async function call(path:string,body?:any,cookie='',origin=env.ADMIN_ORIGIN){const r=await fetch(base+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',...(cookie?{Cookie:cookie}:{}),...(body?{Origin:origin!}:{})},body:body?JSON.stringify(body):undefined});return{status:r.status,json:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]||''};}async function login(n:string,p:string){const r=await call('/staff/session',{loginName:n,password:p});ok(r);return r.cookie;}
